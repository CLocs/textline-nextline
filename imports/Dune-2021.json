  },
  "cues": [
    {
      "index": 1,
      "startMs": 2000,
      "endMs": 7000,
      "rawText": "Downloaded from\nYTS.MX"
    },
    {
      "index": 2,
      "startMs": 8000,
      "endMs": 13000,
      "rawText": "Official YIFY movies site:\nYTS.MX"
    },
    {
      "index": 3,
      "startMs": 1324139,
      "endMs": 1326166,
      "rawText": "They say Bene Gesserit only exists"
    },
    {
      "index": 4,
      "startMs": 1327215,
      "endMs": 1329748,
      "rawText": "to serve the greater good."
    },
    {
      "index": 5,
      "startMs": 1330442,
      "endMs": 1332862,
      "rawText": "I mean no disrespect to your mother,"
    },
    {
      "index": 6,
      "startMs": 1333467,
      "endMs": 1336193,
      "rawText": "but they also pursue their own interests."
    },
    {
      "index": 7,
      "startMs": 1337117,
      "endMs": 1338795,
      "rawText": "What are you saying?"
    },
    {
      "index": 8,
      "startMs": 1338879,
      "endMs": 1340095,
      "rawText": "Be careful."
    },
    {
      "index": 9,
      "startMs": 1346168,
      "endMs": 1347621,
      "rawText": "Don't talk to anyone."
    },
    {
      "index": 10,
      "startMs": 1362685,
      "endMs": 1365038,
      "rawText": "Remember your training."
    },
    {
      "index": 11,
      "startMs": 2436733,
      "endMs": 2438640,
      "rawText": "Prepare for violence."
    },
    {
      "index": 12,
      "startMs": 2748914,
      "endMs": 2750521,
      "rawText": "What is the Emperor's message?"
    },
    {
      "index": 13,
      "startMs": 2751849,
      "endMs": 2753343,
      "rawText": "He will strengthen your hand."
    },
    {
      "index": 14,
      "startMs": 2756962,
      "endMs": 2758102,
      "rawText": "With his Sardaukar army…"
    },
    {
      "index": 15,
      "startMs": 3170643,
      "endMs": 3172137,
      "rawText": "I know who you are."
    },
    {
      "index": 16,
      "startMs": 3364863,
      "endMs": 3367436,
      "rawText": "He will know his uses\nas if he was born with them."
    },
    {
      "index": 17,
      "startMs": 4201887,
      "endMs": 4203580,
      "rawText": "Why does Baron need us?"
    },
    {
      "index": 18,
      "startMs": 4203664,
      "endMs": 4206353,
      "rawText": "The Harkonnen outnumber Atreides."
    },
    {
      "index": 19,
      "startMs": 4206437,
      "endMs": 4208114,
      "rawText": "The Baron doesn't need us."
    },
    {
      "index": 20,
      "startMs": 4215866,
      "endMs": 4218217,
      "rawText": "We are the Sardaukar -"
    },
    {
      "index": 21,
      "startMs": 4218722,
      "endMs": 4219596,
      "rawText": "Emperor's blades."
    },
    {
      "index": 22,
      "startMs": 4220480,
      "endMs": 4222974,
      "rawText": "Those who stand against us\nmeet their death."
    },
    {
      "index": 23,
      "startMs": 4233603,
      "endMs": 4235536,
      "rawText": "As the Emperor commands,"
    },
    {
      "index": 24,
      "startMs": 4236269,
      "endMs": 4237176,
      "rawText": "it will be done."
    },
    {
      "index": 25,
      "startMs": 4902557,
      "endMs": 4905217,
      "rawText": "We will drop them in the desert."
    },
    {
      "index": 26,
      "startMs": 4905301,
      "endMs": 4906783,
      "rawText": "And leave them to the worms."
    },
    {
      "index": 27,
      "startMs": 4908536,
      "endMs": 4910809,
      "rawText": "Why not just cut their throats?"
    },
    {
      "index": 28,
      "startMs": 4911961,
      "endMs": 4915381,
      "rawText": "They could be the Truthsayers."
    },
    {
      "index": 29,
      "startMs": 4917273,
      "endMs": 4919689,
      "rawText": "We can say we didn't kill them."
    },
    {
      "index": 30,
      "startMs": 4925724,
      "endMs": 4927594,
      "rawText": "The one with the scar is deaf."
    },
    {
      "index": 31,
      "startMs": 5087762,
      "endMs": 5089582,
      "rawText": "No! You're not ready."
    },
    {
      "index": 32,
      "startMs": 5105317,
      "endMs": 5107957,
      "rawText": "Find the right tone."
    },
    {
      "index": 33,
      "startMs": 5114111,
      "endMs": 5114998,
      "rawText": "We are far enough."
    },
    {
      "index": 34,
      "startMs": 5115885,
      "endMs": 5117639,
      "rawText": "Throw the boy out."
    },
    {
      "index": 35,
      "startMs": 7631869,
      "endMs": 7633422,
      "rawText": "We are not alone."
    },
    {
      "index": 36,
      "startMs": 7683684,
      "endMs": 7685637,
      "rawText": "How can he be Lisan al-Gaib?"
    },
    {
      "index": 37,
      "startMs": 7686614,
      "endMs": 7687834,
      "rawText": "He hasn't proved himself."
    },
    {
      "index": 38,
      "startMs": 7799143,
      "endMs": 7800730,
      "rawText": "The sun is about to rise."
    },
    {
      "index": 39,
      "startMs": 7801616,
      "endMs": 7803177,
      "rawText": "We must reach Sietch Tabr."
    },
    {
      "index": 40,
      "startMs": 7805237,
      "endMs": 7807483,
      "rawText": "The fate of the strangers\nwill be decided there."
    },
    {
      "index": 41,
      "startMs": 7812780,
      "endMs": 7814206,
      "rawText": "Until then,"
    },
    {
      "index": 42,
      "startMs": 7815241,
      "endMs": 7817389,
      "rawText": "they are under my protection."
    },
    {
      "index": 43,
      "startMs": 7818887,
      "endMs": 7820634,
      "rawText": "I give you my word."
    },
    {
      "index": 44,
      "startMs": 7865985,
      "endMs": 7867151,
      "rawText": "We must go."
    },
    {
      "index": 45,
      "startMs": 7867818,
      "endMs": 7868999,
      "rawText": "We must go."
    }
  ],
