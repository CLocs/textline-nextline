{
  "id": "the-simpsons---4x22---krusty-gets-kancelleden",
  "title": "The Simpsons - 4x22 - Krusty Gets Kancelled.en",
  "sourceFilename": "The Simpsons - 4x22 - Krusty Gets Kancelled.en.srt",
  "importedAt": "2026-08-31T04:14:29.520Z",
  "lineCount": 302,
  "lines": [
    {
      "index": 0,
      "text": "[Chorus] ## The Simpsons ##",
      "kind": "dialogue",
      "startMs": 3900,
      "endMs": 7199
    },
    {
      "index": 1,
      "text": "[Bell Ringing]",
      "kind": "sdh",
      "startMs": 17981,
      "endMs": 19881
    },
    {
      "index": 2,
      "text": "[Whistle Blowing]",
      "kind": "sdh",
      "startMs": 24754,
      "endMs": 27917
    },
    {
      "index": 3,
      "text": "[ Beeping ]",
      "kind": "sdh",
      "startMs": 30293,
      "endMs": 32193
    },
    {
      "index": 4,
      "text": "## [Jazzy Solo ]",
      "kind": "dialogue",
      "startMs": 37934,
      "endMs": 39925
    },
    {
      "index": 5,
      "text": "[ Beeping ]",
      "kind": "sdh",
      "startMs": 59923,
      "endMs": 61823
    },
    {
      "index": 6,
      "text": "[ Tires Screeching ]",
      "kind": "sdh",
      "startMs": 61925,
      "endMs": 63825
    },
    {
      "index": 7,
      "text": "D'oh! [ Screams ]",
      "kind": "dialogue",
      "startMs": 65195,
      "endMs": 67220
    },
    {
      "index": 8,
      "text": "####[Theme] [Announcer]Live from Springfield Harbor... where the sewage meets the sand--",
      "kind": "dialogue",
      "startMs": 82078,
      "endMs": 87615
    },
    {
      "index": 9,
      "text": "[ Coughs, Spits ]",
      "kind": "sdh",
      "startMs": 87717,
      "endMs": 90515
    },
    {
      "index": 10,
      "text": "it's The Springfield Squares! [Applause] Now, Jacqueline, I believe it's your turn.",
      "kind": "dialogue",
      "startMs": 90620,
      "endMs": 98253
    },
    {
      "index": 11,
      "text": "I'll take Rainier Wolfcastle to block. Ah, Rainier Wolfcastle... star of McBain and the upcoming film...",
      "kind": "dialogue",
      "startMs": 98361,
      "endMs": 103999
    },
    {
      "index": 12,
      "text": "Help, My Son is a Nerd!",
      "kind": "dialogue",
      "startMs": 104100,
      "endMs": 106227
    },
    {
      "index": 13,
      "text": "My son returns from a fancy East Coast college... and I'm horrified to find he's a nerd.",
      "kind": "dialogue",
      "startMs": 106336,
      "endMs": 112533
    },
    {
      "index": 14,
      "text": "[ Laughing ] I'm laughing already.",
      "kind": "dialogue",
      "startMs": 112642,
      "endMs": 114701
    },
    {
      "index": 15,
      "text": "It's not a comedy. Oh.",
      "kind": "dialogue",
      "startMs": 114811,
      "endMs": 117245
    },
    {
      "index": 16,
      "text": "Attention! This is the Coast Guard.",
      "kind": "dialogue",
      "startMs": 117347,
      "endMs": 119008
    },
    {
      "index": 17,
      "text": "A 50-foot tidal wave is heading this way.",
      "kind": "dialogue",
      "startMs": 119115,
      "endMs": 122141
    },
    {
      "index": 18,
      "text": "All game shows off the beach!",
      "kind": "dialogue",
      "startMs": 122252,
      "endMs": 124743
    },
    {
      "index": 19,
      "text": "[ Gasping ] [ All Screaming ] Everybody up here to my square.",
      "kind": "dialogue",
      "startMs": 124854,
      "endMs": 128953
    },
    {
      "index": 20,
      "text": "It's safe and it's sexy. Oh, baby.",
      "kind": "dialogue",
      "startMs": 129058,
      "endMs": 131754
    },
    {
      "index": 21,
      "text": "Hurry, Charlie. There is not much time.",
      "kind": "dialogue",
      "startMs": 133196,
      "endMs": 136222
    },
    {
      "index": 22,
      "text": "I ain't goin' nowhere.",
      "kind": "dialogue",
      "startMs": 136332,
      "endMs": 138232
    },
    {
      "index": 23,
      "text": "I been in this square pert' near 30 seasons, and I ain't a-leavin' now.",
      "kind": "dialogue",
      "startMs": 138334,
      "endMs": 142600
    },
    {
      "index": 24,
      "text": "[ Yelling ] He's dead now.",
      "kind": "dialogue",
      "startMs": 142705,
      "endMs": 145196
    },
    {
      "index": 25,
      "text": "[ Both Laughing ]",
      "kind": "sdh",
      "startMs": 145308,
      "endMs": 147936
    },
    {
      "index": 26,
      "text": "[ Man ] Gabbo! Gabbo! Gabbo!",
      "kind": "dialogue",
      "startMs": 148044,
      "endMs": 150171
    },
    {
      "index": 27,
      "text": "Did you see that? Yeah.",
      "kind": "dialogue",
      "startMs": 151581,
      "endMs": 153845
    },
    {
      "index": 28,
      "text": "What's Gabbo? I figure it's some guy's name.",
      "kind": "dialogue",
      "startMs": 153950,
      "endMs": 156885
    },
    {
      "index": 29,
      "text": "Some guy named Gabbo.",
      "kind": "dialogue",
      "startMs": 156986,
      "endMs": 158886
    },
    {
      "index": 30,
      "text": "[Homer] Hmm.",
      "kind": "dialogue",
      "startMs": 158988,
      "endMs": 160455
    },
    {
      "index": 31,
      "text": "I don't think they're giving enough information, Dad.",
      "kind": "dialogue",
      "startMs": 163259,
      "endMs": 165887
    },
    {
      "index": 32,
      "text": "I'll figure it out. I'm gonna use all the power of my brain.",
      "kind": "dialogue",
      "startMs": 165995,
      "endMs": 170932
    },
    {
      "index": 33,
      "text": "[ Buzzing ]",
      "kind": "sdh",
      "startMs": 171968,
      "endMs": 174698
    },
    {
      "index": 34,
      "text": "Look, Smithers! Garbo is coming! Uh, yes, sir.",
      "kind": "dialogue",
      "startMs": 176472,
      "endMs": 179930
    },
    {
      "index": 35,
      "text": "Everyone is saying \"Gabbo this\" and \"Gabbo that,\" but no one is saying \"worship this\" and \"Jericho that.\"",
      "kind": "dialogue",
      "startMs": 181945,
      "endMs": 189851
    },
    {
      "index": 36,
      "text": "What's this about Gabbo?",
      "kind": "dialogue",
      "startMs": 189953,
      "endMs": 191750
    },
    {
      "index": 37,
      "text": "I can't believe it. Our first glimpse of Gabbo!",
      "kind": "dialogue",
      "startMs": 194057,
      "endMs": 197549
    },
    {
      "index": 38,
      "text": "He'll tell us what to do.",
      "kind": "dialogue",
      "startMs": 197660,
      "endMs": 199560
    },
    {
      "index": 39,
      "text": "####[Drum roll]",
      "kind": "dialogue",
      "startMs": 199662,
      "endMs": 201562
    },
    {
      "index": 40,
      "text": "[Cymbals Crash] Hello. I'm Gabbo.",
      "kind": "dialogue",
      "startMs": 201664,
      "endMs": 204758
    },
    {
      "index": 41,
      "text": "And I'm Arthur Crandall. That's easy for you to say.",
      "kind": "dialogue",
      "startMs": 204868,
      "endMs": 208133
    },
    {
      "index": 42,
      "text": "You don't have a hand up your tuchas.",
      "kind": "dialogue",
      "startMs": 208238,
      "endMs": 210229
    },
    {
      "index": 43,
      "text": "Oy! Hey! [ Chuckles ] Oh, Gabbo.",
      "kind": "dialogue",
      "startMs": 210340,
      "endMs": 213639
    },
    {
      "index": 44,
      "text": "You'll say anything. And you can watch us every afternoon at 4:00.",
      "kind": "dialogue",
      "startMs": 213743,
      "endMs": 217235
    },
    {
      "index": 45,
      "text": "[ Gasps ] That's the same time as Krusty the Clown!",
      "kind": "dialogue",
      "startMs": 217347,
      "endMs": 220214
    },
    {
      "index": 46,
      "text": "Uh-oh. That cute little character could take America by storm.",
      "kind": "dialogue",
      "startMs": 220316,
      "endMs": 224116
    },
    {
      "index": 47,
      "text": "All he needs is a hook.",
      "kind": "dialogue",
      "startMs": 224220,
      "endMs": 226188
    },
    {
      "index": 48,
      "text": "I'm a bad widdle boy. �Aycarumba!",
      "kind": "dialogue",
      "startMs": 226289,
      "endMs": 229850
    },
    {
      "index": 49,
      "text": "####[Orchestra] ## [ Singing ]",
      "kind": "dialogue",
      "startMs": 229959,
      "endMs": 235723
    },
    {
      "index": 50,
      "text": "[ Imitating Vin Scully] Let's take time out from this triple play... to talk about Farmer Dan's pure pork sausage.",
      "kind": "dialogue",
      "startMs": 243873,
      "endMs": 248441
    },
    {
      "index": 51,
      "text": "Mm-mmm!",
      "kind": "dialogue",
      "startMs": 248544,
      "endMs": 249772
    },
    {
      "index": 52,
      "text": "## [ Singing Continues ]",
      "kind": "dialogue",
      "startMs": 249879,
      "endMs": 252848
    },
    {
      "index": 53,
      "text": "[ All ] Gabbo!",
      "kind": "dialogue",
      "startMs": 271034,
      "endMs": 274026
    },
    {
      "index": 54,
      "text": "Ahh, that dummy doesn't scare me.",
      "kind": "dialogue",
      "startMs": 274137,
      "endMs": 277868
    },
    {
      "index": 55,
      "text": "I've had plenty of guys come after me, and I've buried 'em all.",
      "kind": "dialogue",
      "startMs": 277974,
      "endMs": 281239
    },
    {
      "index": 56,
      "text": "Hobos, sea captains, Joey Bishop--",
      "kind": "dialogue",
      "startMs": 281344,
      "endMs": 283972
    },
    {
      "index": 57,
      "text": "Don't forget the Special Olympics. Oh, yeah.",
      "kind": "dialogue",
      "startMs": 284080,
      "endMs": 287106
    },
    {
      "index": 58,
      "text": "I slaughtered the Special Olympics. [Door Opens] Are those our ratings? Let me see.",
      "kind": "dialogue",
      "startMs": 287216,
      "endMs": 293518
    },
    {
      "index": 59,
      "text": "I lost to Channel Ocho? What the hell is that?",
      "kind": "dialogue",
      "startMs": 293623,
      "endMs": 297354
    },
    {
      "index": 60,
      "text": "Dos huevos, por favor.",
      "kind": "dialogue",
      "startMs": 297460,
      "endMs": 299928
    },
    {
      "index": 61,
      "text": "�Ay! Oh, quel�stima.",
      "kind": "dialogue",
      "startMs": 300029,
      "endMs": 303089
    },
    {
      "index": 62,
      "text": "[ Chuckles ] I gotta steal that bit.",
      "kind": "dialogue",
      "startMs": 303199,
      "endMs": 306430
    },
    {
      "index": 63,
      "text": "This is boring. - I wonder what would happen if you put your train on there.",
      "kind": "dialogue",
      "startMs": 309472,
      "endMs": 313602
    },
    {
      "index": 64,
      "text": "[ Crackling ]",
      "kind": "sdh",
      "startMs": 314711,
      "endMs": 317271
    },
    {
      "index": 65,
      "text": "[ Together] Cool.",
      "kind": "dialogue",
      "startMs": 317380,
      "endMs": 319280
    },
    {
      "index": 66,
      "text": "Now let's throw some crud on it. Hey, it's 4:00.",
      "kind": "dialogue",
      "startMs": 319382,
      "endMs": 324285
    },
    {
      "index": 67,
      "text": "####[Trumpet, Snare Drum] So, you want ventriloquism, do ya?",
      "kind": "dialogue",
      "startMs": 324387,
      "endMs": 329153
    },
    {
      "index": 68,
      "text": "All right, watch this. Hello, Alphonse. I've got a riddle for you.",
      "kind": "dialogue",
      "startMs": 329258,
      "endMs": 333524
    },
    {
      "index": 69,
      "text": "Why is a raven like a writing desk?",
      "kind": "dialogue",
      "startMs": 333629,
      "endMs": 335927
    },
    {
      "index": 70,
      "text": "I don't know. Why is a--",
      "kind": "dialogue",
      "startMs": 336032,
      "endMs": 338125
    },
    {
      "index": 71,
      "text": "[ All Screaming ]",
      "kind": "sdh",
      "startMs": 338234,
      "endMs": 340395
    },
    {
      "index": 72,
      "text": "Hey, the dummy can't hurt you. He's not even alive.",
      "kind": "dialogue",
      "startMs": 340503,
      "endMs": 343802
    },
    {
      "index": 73,
      "text": "He's dead!",
      "kind": "dialogue",
      "startMs": 343906,
      "endMs": 346374
    },
    {
      "index": 74,
      "text": "[ Screaming ]",
      "kind": "sdh",
      "startMs": 346476,
      "endMs": 348034
    },
    {
      "index": 75,
      "text": "[ Grunts ] [ Screaming ]",
      "kind": "dialogue",
      "startMs": 349479,
      "endMs": 352710
    },
    {
      "index": 76,
      "text": "[ Groans ]",
      "kind": "sdh",
      "startMs": 352815,
      "endMs": 354544
    },
    {
      "index": 77,
      "text": "All right, here's the deal.",
      "kind": "dialogue",
      "startMs": 357620,
      "endMs": 359679
    },
    {
      "index": 78,
      "text": "Every time you watch my show...",
      "kind": "dialogue",
      "startMs": 359789,
      "endMs": 361689
    },
    {
      "index": 79,
      "text": "I will send you $40! [Announcer]Checks will not be honored.",
      "kind": "dialogue",
      "startMs": 361791,
      "endMs": 365454
    },
    {
      "index": 80,
      "text": "I admit I used the city treasury to fund the murder of my enemies.",
      "kind": "dialogue",
      "startMs": 365561,
      "endMs": 369361
    },
    {
      "index": 81,
      "text": "But as Gabbo would say, \"I'm a bad widdle boy.\"",
      "kind": "dialogue",
      "startMs": 369465,
      "endMs": 373424
    },
    {
      "index": 82,
      "text": "[Applause]",
      "kind": "sdh",
      "startMs": 373536,
      "endMs": 376505
    },
    {
      "index": 83,
      "text": "Well, kids, this is where you would watch Itchy and Scratchy... except they're on the Gabbo Show now.",
      "kind": "dialogue",
      "startMs": 379342,
      "endMs": 385774
    },
    {
      "index": 84,
      "text": "So, here's Eastern Europe's favorite cat and mouse team...",
      "kind": "dialogue",
      "startMs": 385882,
      "endMs": 389409
    },
    {
      "index": 85,
      "text": "Worker and Parasite!",
      "kind": "dialogue",
      "startMs": 389519,
      "endMs": 393011
    },
    {
      "index": 86,
      "text": "####[Drums]",
      "kind": "dialogue",
      "startMs": 393122,
      "endMs": 395215
    },
    {
      "index": 87,
      "text": "[ Both Muttering, Indistinct ]",
      "kind": "sdh",
      "startMs": 395324,
      "endMs": 398691
    },
    {
      "index": 88,
      "text": "####[Piano] What the hell is that?",
      "kind": "dialogue",
      "startMs": 407737,
      "endMs": 414043
    },
    {
      "index": 89,
      "text": "[ Groans ]",
      "kind": "sdh",
      "startMs": 419649,
      "endMs": 421617
    },
    {
      "index": 90,
      "text": "Well, that's it.",
      "kind": "dialogue",
      "startMs": 423986,
      "endMs": 425886
    },
    {
      "index": 91,
      "text": "We've been canceled. I think we can be proud... that we never did a bad show... except for that week Ray Jay Johnson was my co-host.",
      "kind": "dialogue",
      "startMs": 425988,
      "endMs": 433552
    },
    {
      "index": 92,
      "text": "\"You can call me Ray, and you can call me Jay.\"",
      "kind": "dialogue",
      "startMs": 433663,
      "endMs": 437258
    },
    {
      "index": 93,
      "text": "Ooh! That thing was funny for about three seconds.",
      "kind": "dialogue",
      "startMs": 437366,
      "endMs": 441063
    },
    {
      "index": 94,
      "text": "The important thing is, we're like a family.",
      "kind": "dialogue",
      "startMs": 441170,
      "endMs": 444298
    },
    {
      "index": 95,
      "text": "Krusty, I-- Shut your hole!",
      "kind": "dialogue",
      "startMs": 444407,
      "endMs": 446568
    },
    {
      "index": 96,
      "text": "[ Melodic Door Chime ]",
      "kind": "sdh",
      "startMs": 448377,
      "endMs": 452211
    },
    {
      "index": 97,
      "text": "Krusty, how ya holding up? Well, I'm kinda worried about the future.",
      "kind": "dialogue",
      "startMs": 452315,
      "endMs": 455978
    },
    {
      "index": 98,
      "text": "How do you deal with it?",
      "kind": "dialogue",
      "startMs": 456085,
      "endMs": 457985
    },
    {
      "index": 99,
      "text": "Well, you've been on TV longer than I have. I'm sure you've saved up quite a nest egg.",
      "kind": "dialogue",
      "startMs": 458087,
      "endMs": 461955
    },
    {
      "index": 100,
      "text": "Uh, yeah.",
      "kind": "dialogue",
      "startMs": 462058,
      "endMs": 463958
    },
    {
      "index": 101,
      "text": "Do they still buy human hair down at the wig shop?",
      "kind": "dialogue",
      "startMs": 464060,
      "endMs": 467223
    },
    {
      "index": 102,
      "text": "[ Grunts, Groans ]",
      "kind": "sdh",
      "startMs": 468331,
      "endMs": 470891
    },
    {
      "index": 103,
      "text": "Krusty, you wanna stay for dinner? Nah, sorry.",
      "kind": "dialogue",
      "startMs": 471000,
      "endMs": 473468
    },
    {
      "index": 104,
      "text": "Ah, that's too bad, 'cause tonight my guests will be Dr. Carl Sagan...",
      "kind": "dialogue",
      "startMs": 473569,
      "endMs": 477232
    },
    {
      "index": 105,
      "text": "and from the San Diego Zoo, Joan Embry. ####[Drum roll] \"Oh, Kyle, I just don't think...",
      "kind": "dialogue",
      "startMs": 477340,
      "endMs": 484645
    },
    {
      "index": 106,
      "text": "I fit in here at Melrose Place.\"",
      "kind": "dialogue",
      "startMs": 484747,
      "endMs": 486647
    },
    {
      "index": 107,
      "text": "From now on, I'll be doing the thinking for both of us.",
      "kind": "dialogue",
      "startMs": 486749,
      "endMs": 490207
    },
    {
      "index": 108,
      "text": "[ Nose Honks ] [Man]Next.",
      "kind": "dialogue",
      "startMs": 491487,
      "endMs": 493387
    },
    {
      "index": 109,
      "text": "####[Trumpet] Come on, you stupid horse! I got my last ten bucks on you!",
      "kind": "dialogue",
      "startMs": 493489,
      "endMs": 501556
    },
    {
      "index": 110,
      "text": "No, don't look at me!",
      "kind": "dialogue",
      "startMs": 501664,
      "endMs": 503894
    },
    {
      "index": 111,
      "text": "Run! No!",
      "kind": "dialogue",
      "startMs": 504000,
      "endMs": 505900
    },
    {
      "index": 112,
      "text": "Don't come over here! [ Groans ] Oh, boy.",
      "kind": "dialogue",
      "startMs": 506002,
      "endMs": 511566
    },
    {
      "index": 113,
      "text": "And now, it's time for another patented Gabbo Crank Call!",
      "kind": "dialogue",
      "startMs": 511674,
      "endMs": 516737
    },
    {
      "index": 114,
      "text": "Oh, I love these. I can't believe it.",
      "kind": "dialogue",
      "startMs": 516846,
      "endMs": 519371
    },
    {
      "index": 115,
      "text": "He stole this bit from Krusty!",
      "kind": "dialogue",
      "startMs": 519482,
      "endMs": 521382
    },
    {
      "index": 116,
      "text": "Yeah, well, Krusty stole it from Steve Allen.",
      "kind": "dialogue",
      "startMs": 521484,
      "endMs": 523748
    },
    {
      "index": 117,
      "text": "Oh, everything's stolen nowadays.",
      "kind": "dialogue",
      "startMs": 523853,
      "endMs": 526287
    },
    {
      "index": 118,
      "text": "Why, the fax machine is nothing but a waffle iron with a phone attached.",
      "kind": "dialogue",
      "startMs": 526389,
      "endMs": 530723
    },
    {
      "index": 119,
      "text": "[ Line Ringing ] It's ringing.",
      "kind": "dialogue",
      "startMs": 530826,
      "endMs": 532157
    },
    {
      "index": 120,
      "text": "[ Deep Voice ] Hello. Is this Krusty the Clown?",
      "kind": "dialogue",
      "startMs": 532261,
      "endMs": 534456
    },
    {
      "index": 121,
      "text": "[ Krusty] Is this the callback for that porno film?",
      "kind": "dialogue",
      "startMs": 534564,
      "endMs": 536555
    },
    {
      "index": 122,
      "text": "Look, I was a little nervous that day... but I'm all man, I can assure you.",
      "kind": "dialogue",
      "startMs": 536666,
      "endMs": 541429
    },
    {
      "index": 123,
      "text": "[ Chuckles ] No, I represent a Japanese camera company.",
      "kind": "dialogue",
      "startMs": 541537,
      "endMs": 545132
    },
    {
      "index": 124,
      "text": "We'd like to pay you two million dollars to do a camera commercial.",
      "kind": "dialogue",
      "startMs": 545241,
      "endMs": 548768
    },
    {
      "index": 125,
      "text": "Whoa! Me rikey velly much!",
      "kind": "dialogue",
      "startMs": 548878,
      "endMs": 551779
    },
    {
      "index": 126,
      "text": "Oh, I hope I didn't offend you. I need this bad.",
      "kind": "dialogue",
      "startMs": 551881,
      "endMs": 555647
    },
    {
      "index": 127,
      "text": "Bad enough to hit yourself over the head with the phone?",
      "kind": "dialogue",
      "startMs": 555751,
      "endMs": 558447
    },
    {
      "index": 128,
      "text": "Oh! You got it! Ow! [ Thumping ] Ow! Ooh, blood.",
      "kind": "dialogue",
      "startMs": 558554,
      "endMs": 562982
    },
    {
      "index": 129,
      "text": "[ Both Laughing ] [Audience Laughing] What the-- [ Groans ] If this is anyone but Steve Allen, you're stealing my bit.",
      "kind": "dialogue",
      "startMs": 563092,
      "endMs": 571767
    },
    {
      "index": 130,
      "text": "Somebody ought to ruin Gabbo's career the way he ruined Krusty's.",
      "kind": "dialogue",
      "startMs": 571867,
      "endMs": 574836
    },
    {
      "index": 131,
      "text": "Two wrongs don't make a right, Bart. Yes, they do.",
      "kind": "dialogue",
      "startMs": 574937,
      "endMs": 577167
    },
    {
      "index": 132,
      "text": "No, they don't. Yes, they do.",
      "kind": "dialogue",
      "startMs": 577273,
      "endMs": 578604
    },
    {
      "index": 133,
      "text": "No, they don't. Dad! Yes, they do.",
      "kind": "dialogue",
      "startMs": 578708,
      "endMs": 580835
    },
    {
      "index": 134,
      "text": "Two wrongs make a right, Lisa.",
      "kind": "dialogue",
      "startMs": 580943,
      "endMs": 583207
    },
    {
      "index": 135,
      "text": "Ah, Rex Morgan, M.D. You have the prescription for the daily blues.",
      "kind": "dialogue",
      "startMs": 583312,
      "endMs": 588045
    },
    {
      "index": 136,
      "text": "We'll be back after this commercial for Gabbo Airlines.",
      "kind": "dialogue",
      "startMs": 589785,
      "endMs": 592777
    },
    {
      "index": 137,
      "text": "[Man] And cut.",
      "kind": "dialogue",
      "startMs": 592888,
      "endMs": 594788
    },
    {
      "index": 138,
      "text": "That oughta hold the little S.O.B.s. Gabbo, quiet.",
      "kind": "dialogue",
      "startMs": 594890,
      "endMs": 598053
    },
    {
      "index": 139,
      "text": "Oh, I wouldn't wanna offend the little S.O.B.s. I wish you'd stop saying that.",
      "kind": "dialogue",
      "startMs": 598160,
      "endMs": 602153
    },
    {
      "index": 140,
      "text": "Hmm.",
      "kind": "dialogue",
      "startMs": 602265,
      "endMs": 603994
    },
    {
      "index": 141,
      "text": "[ Laughing ] Hey, boyo, what's so funny?",
      "kind": "dialogue",
      "startMs": 604100,
      "endMs": 608366
    },
    {
      "index": 142,
      "text": "Well, it's-- Ah, you wouldn't be interested. It's too lowbrow.",
      "kind": "dialogue",
      "startMs": 608471,
      "endMs": 611201
    },
    {
      "index": 143,
      "text": "No, I'm quite lowbrow.",
      "kind": "dialogue",
      "startMs": 611307,
      "endMs": 613639
    },
    {
      "index": 144,
      "text": "Well, somebody just wrote a bawdy limerick on the men's room wall.",
      "kind": "dialogue",
      "startMs": 613743,
      "endMs": 616211
    },
    {
      "index": 145,
      "text": "This I gotta see!",
      "kind": "dialogue",
      "startMs": 616312,
      "endMs": 619008
    },
    {
      "index": 146,
      "text": "All the kids in Springfield are S.O.B.s.",
      "kind": "dialogue",
      "startMs": 620349,
      "endMs": 623944
    },
    {
      "index": 147,
      "text": "Gabbo's kind of language has no place on or off TV.",
      "kind": "dialogue",
      "startMs": 624053,
      "endMs": 627682
    },
    {
      "index": 148,
      "text": "And that's my two cents.",
      "kind": "dialogue",
      "startMs": 627790,
      "endMs": 631021
    },
    {
      "index": 149,
      "text": "[ Chuckles ] That oughta hold those S.O.B.s.",
      "kind": "dialogue",
      "startMs": 631127,
      "endMs": 633391
    },
    {
      "index": 150,
      "text": "[ Chuckles ] What the--",
      "kind": "dialogue",
      "startMs": 633496,
      "endMs": 635396
    },
    {
      "index": 151,
      "text": "[ Both Gasp ]",
      "kind": "sdh",
      "startMs": 638334,
      "endMs": 639665
    },
    {
      "index": 152,
      "text": "Oh, no!",
      "kind": "dialogue",
      "startMs": 639769,
      "endMs": 641634
    },
    {
      "index": 153,
      "text": "Krusty, are you making any money? Nah.",
      "kind": "dialogue",
      "startMs": 643572,
      "endMs": 646063
    },
    {
      "index": 154,
      "text": "That guy's giving it away for free.",
      "kind": "dialogue",
      "startMs": 646175,
      "endMs": 648336
    },
    {
      "index": 155,
      "text": "## [ Singing ]",
      "kind": "dialogue",
      "startMs": 648444,
      "endMs": 651504
    },
    {
      "index": 156,
      "text": "[ Groans ] Thirty-five years in show business... and already no one remembers me. just like what's-his-name and who sits... and, you know, that guy, always wore a shirt--",
      "kind": "dialogue",
      "startMs": 656719,
      "endMs": 668287
    },
    {
      "index": 157,
      "text": "Ed Sullivan? Yeah.",
      "kind": "dialogue",
      "startMs": 668397,
      "endMs": 670126
    },
    {
      "index": 158,
      "text": "I didn't know you knew Luke Perry!",
      "kind": "dialogue",
      "startMs": 670232,
      "endMs": 672792
    },
    {
      "index": 159,
      "text": "[ Scoffs ] Know him? He's my worthless half-brother.",
      "kind": "dialogue",
      "startMs": 672902,
      "endMs": 676235
    },
    {
      "index": 160,
      "text": "He's a big TV star. Yeah, on Fox.",
      "kind": "dialogue",
      "startMs": 676339,
      "endMs": 681140
    },
    {
      "index": 161,
      "text": "Elizabeth Taylor. Bette Midler.",
      "kind": "dialogue",
      "startMs": 681243,
      "endMs": 685441
    },
    {
      "index": 162,
      "text": "Bette and I owned a racehorse together: Krudler.",
      "kind": "dialogue",
      "startMs": 685548,
      "endMs": 688779
    },
    {
      "index": 163,
      "text": "Hey, Bart, if we get all these big stars to appear on a special with Krusty... it might get his career going again.",
      "kind": "dialogue",
      "startMs": 688884,
      "endMs": 694688
    },
    {
      "index": 164,
      "text": "Here's my address book. Go get those stars!",
      "kind": "dialogue",
      "startMs": 700096,
      "endMs": 702929
    },
    {
      "index": 165,
      "text": "It won't be easy, but I'm gonna... claw my way back on to TV.",
      "kind": "dialogue",
      "startMs": 704200,
      "endMs": 710498
    },
    {
      "index": 166,
      "text": "## [ Singing ]",
      "kind": "dialogue",
      "startMs": 710606,
      "endMs": 713734
    },
    {
      "index": 167,
      "text": "[Male Announcer] And now, the Crazy Old Man Singers.",
      "kind": "dialogue",
      "startMs": 716545,
      "endMs": 720276
    },
    {
      "index": 168,
      "text": "####[Male Chorus Singing]",
      "kind": "dialogue",
      "startMs": 720383,
      "endMs": 722783
    },
    {
      "index": 169,
      "text": "Miss Midler, I can't believe you do this all by yourself.",
      "kind": "dialogue",
      "startMs": 730993,
      "endMs": 734121
    },
    {
      "index": 170,
      "text": "We're Americans. We deserve clean highways.",
      "kind": "dialogue",
      "startMs": 734230,
      "endMs": 736425
    },
    {
      "index": 171,
      "text": "You pigs! [ Panting ] Oh, no! Bette Midler!",
      "kind": "dialogue",
      "startMs": 739268,
      "endMs": 745502
    },
    {
      "index": 172,
      "text": "[ Grunting ]",
      "kind": "sdh",
      "startMs": 745608,
      "endMs": 747667
    },
    {
      "index": 173,
      "text": "[ Yelling ]",
      "kind": "sdh",
      "startMs": 747777,
      "endMs": 749677
    },
    {
      "index": 174,
      "text": "[Crash]",
      "kind": "sdh",
      "startMs": 749779,
      "endMs": 752270
    },
    {
      "index": 175,
      "text": "Now, where were we?",
      "kind": "dialogue",
      "startMs": 752381,
      "endMs": 754281
    },
    {
      "index": 176,
      "text": "We were asking you to appear on Krusty's Komeback Special.",
      "kind": "dialogue",
      "startMs": 754383,
      "endMs": 756851
    },
    {
      "index": 177,
      "text": "Okay. Tell Krusty he can count me in.",
      "kind": "dialogue",
      "startMs": 756952,
      "endMs": 760012
    },
    {
      "index": 178,
      "text": "It's time to take out the trash.",
      "kind": "dialogue",
      "startMs": 764560,
      "endMs": 768052
    },
    {
      "index": 179,
      "text": "[ Man Shouting ] I'll get you for this, Midler!",
      "kind": "dialogue",
      "startMs": 770132,
      "endMs": 773465
    },
    {
      "index": 180,
      "text": "[ Man Over P.A. ] And off to your left is Hugh Hefner's Shelbyville pad.",
      "kind": "dialogue",
      "startMs": 775604,
      "endMs": 779506
    },
    {
      "index": 181,
      "text": "A lot of people know about the grotto and the game room. - Of course.",
      "kind": "dialogue",
      "startMs": 779608,
      "endMs": 783738
    },
    {
      "index": 182,
      "text": "But few know about the laboratory, the biosphere... the alternative energy research center.",
      "kind": "dialogue",
      "startMs": 783846,
      "endMs": 788847
    },
    {
      "index": 183,
      "text": "Fascinating.",
      "kind": "dialogue",
      "startMs": 792121,
      "endMs": 794089
    },
    {
      "index": 184,
      "text": "Desalinization plant? Yes.",
      "kind": "dialogue",
      "startMs": 798360,
      "endMs": 800555
    },
    {
      "index": 185,
      "text": "The grotto uses so much water, the Bunnies felt we should go this way.",
      "kind": "dialogue",
      "startMs": 800663,
      "endMs": 804099
    },
    {
      "index": 186,
      "text": "Smart Bunnies, Hef. I can call you Hef, can't I? No.",
      "kind": "dialogue",
      "startMs": 804200,
      "endMs": 807601
    },
    {
      "index": 187,
      "text": "You told our agent this place holds 30,000 people.",
      "kind": "dialogue",
      "startMs": 810372,
      "endMs": 813102
    },
    {
      "index": 188,
      "text": "It does. We had 30,000 here last night.",
      "kind": "dialogue",
      "startMs": 813209,
      "endMs": 815609
    },
    {
      "index": 189,
      "text": "Now play. The audience is gettin' restless.",
      "kind": "dialogue",
      "startMs": 815711,
      "endMs": 817679
    },
    {
      "index": 190,
      "text": "We want Chilly Willy! We want Chilly Willy!",
      "kind": "dialogue",
      "startMs": 817780,
      "endMs": 821511
    },
    {
      "index": 191,
      "text": "Hey, Red Hot Chili Peppers... would you guys like to appear on a Krusty the Clown special?",
      "kind": "dialogue",
      "startMs": 822918,
      "endMs": 827445
    },
    {
      "index": 192,
      "text": "Sure, if you can get us out of this gig. No problemo.",
      "kind": "dialogue",
      "startMs": 827556,
      "endMs": 830320
    },
    {
      "index": 193,
      "text": "Hey, Moe, look over there. What? What am I lookin' at?",
      "kind": "dialogue",
      "startMs": 830426,
      "endMs": 833293
    },
    {
      "index": 194,
      "text": "I don't see nothin'. I'm gonna stop looking soon.",
      "kind": "dialogue",
      "startMs": 833395,
      "endMs": 837297
    },
    {
      "index": 195,
      "text": "What? What, is that it? Hey, Moe, can I look too?",
      "kind": "dialogue",
      "startMs": 837399,
      "endMs": 840664
    },
    {
      "index": 196,
      "text": "Sure, but it'll cost ya. My wallet's in the car.",
      "kind": "dialogue",
      "startMs": 840769,
      "endMs": 843897
    },
    {
      "index": 197,
      "text": "He is so stupid.",
      "kind": "dialogue",
      "startMs": 844006,
      "endMs": 846497
    },
    {
      "index": 198,
      "text": "And now, back to the wall.",
      "kind": "dialogue",
      "startMs": 846609,
      "endMs": 849305
    },
    {
      "index": 199,
      "text": "## [ Humming ] Miss Taylor, a couple of grade-school kids Wanted you to be on a Krusty special.",
      "kind": "dialogue",
      "startMs": 852648,
      "endMs": 858483
    },
    {
      "index": 200,
      "text": "I told them to buzz off. Good.",
      "kind": "dialogue",
      "startMs": 858587,
      "endMs": 861317
    },
    {
      "index": 201,
      "text": "## [ Humming ]",
      "kind": "dialogue",
      "startMs": 861423,
      "endMs": 863857
    },
    {
      "index": 202,
      "text": "[Pounding On Door] Krusty, we've got great news!",
      "kind": "dialogue",
      "startMs": 863959,
      "endMs": 866427
    },
    {
      "index": 203,
      "text": "[ Both Screaming ]",
      "kind": "sdh",
      "startMs": 866529,
      "endMs": 868429
    },
    {
      "index": 204,
      "text": "[ Groaning ]",
      "kind": "sdh",
      "startMs": 869598,
      "endMs": 872032
    },
    {
      "index": 205,
      "text": "Krusty, what have you done to yourself?",
      "kind": "dialogue",
      "startMs": 872134,
      "endMs": 874796
    },
    {
      "index": 206,
      "text": "I thought I'd get into shape, so I've been drinking nothing but milk shakes.",
      "kind": "dialogue",
      "startMs": 874904,
      "endMs": 878465
    },
    {
      "index": 207,
      "text": "You mean those diet milk shakes? Uh-oh.",
      "kind": "dialogue",
      "startMs": 878574,
      "endMs": 881099
    },
    {
      "index": 208,
      "text": "Now, you can stay with us until you lose that weight.",
      "kind": "dialogue",
      "startMs": 881210,
      "endMs": 883804
    },
    {
      "index": 209,
      "text": "You can sleep on the sofa. It folds right out.",
      "kind": "dialogue",
      "startMs": 883913,
      "endMs": 886541
    },
    {
      "index": 210,
      "text": "[ Grunting, Yelling ]",
      "kind": "sdh",
      "startMs": 886649,
      "endMs": 889812
    },
    {
      "index": 211,
      "text": "Oh, wait. That was the old sofa.",
      "kind": "dialogue",
      "startMs": 891153,
      "endMs": 893053
    },
    {
      "index": 212,
      "text": "[ Screeching ]",
      "kind": "sdh",
      "startMs": 893155,
      "endMs": 897888
    },
    {
      "index": 213,
      "text": "Oh, I'll never get my aim back.",
      "kind": "dialogue",
      "startMs": 901196,
      "endMs": 903562
    },
    {
      "index": 214,
      "text": "You gotta keep working on it. Oh! Aah!",
      "kind": "dialogue",
      "startMs": 903666,
      "endMs": 906601
    },
    {
      "index": 215,
      "text": "Aah! Water! [ Yelling ] Mmm, delicious.",
      "kind": "dialogue",
      "startMs": 906702,
      "endMs": 912300
    },
    {
      "index": 216,
      "text": "Oh, why am I bothering? It's hopeless. [ Gabbo On TV] Hi, kids.",
      "kind": "dialogue",
      "startMs": 915611,
      "endMs": 918876
    },
    {
      "index": 217,
      "text": "It's me, Gabbo!",
      "kind": "dialogue",
      "startMs": 918981,
      "endMs": 921108
    },
    {
      "index": 218,
      "text": "[ Laughing ]",
      "kind": "sdh",
      "startMs": 921216,
      "endMs": 923116
    },
    {
      "index": 219,
      "text": "Pork prices rose in early trading today.",
      "kind": "dialogue",
      "startMs": 927656,
      "endMs": 930523
    },
    {
      "index": 220,
      "text": "But you've gotta comeback, Mel!",
      "kind": "dialogue",
      "startMs": 939068,
      "endMs": 941662
    },
    {
      "index": 221,
      "text": "We're a team. No, Krusty.",
      "kind": "dialogue",
      "startMs": 941770,
      "endMs": 943761
    },
    {
      "index": 222,
      "text": "You always treated me rather shabbily.",
      "kind": "dialogue",
      "startMs": 943872,
      "endMs": 945840
    },
    {
      "index": 223,
      "text": "On our last show, you poured liquid nitrogen down my pants... and cracked my buttocks with a hammer.",
      "kind": "dialogue",
      "startMs": 945941,
      "endMs": 950674
    },
    {
      "index": 224,
      "text": "Ah, come on. You wanna waste your life... hanging out with a bunch of dorky teenagers?",
      "kind": "dialogue",
      "startMs": 950779,
      "endMs": 955239
    },
    {
      "index": 225,
      "text": "Here's your taco, mister. Oops.",
      "kind": "dialogue",
      "startMs": 955351,
      "endMs": 957683
    },
    {
      "index": 226,
      "text": "It fell in the fryer. I'll get it out. Ow! Ow!",
      "kind": "dialogue",
      "startMs": 957786,
      "endMs": 961347
    },
    {
      "index": 227,
      "text": "Ow!Ow!",
      "kind": "dialogue",
      "startMs": 961457,
      "endMs": 963948
    },
    {
      "index": 228,
      "text": "Sorry, Krusty. I like it here.",
      "kind": "dialogue",
      "startMs": 964059,
      "endMs": 965959
    },
    {
      "index": 229,
      "text": "Mr. Johannson treats me with dignity.",
      "kind": "dialogue",
      "startMs": 966061,
      "endMs": 967961
    },
    {
      "index": 230,
      "text": "Is this clown bothering you, Mel?",
      "kind": "dialogue",
      "startMs": 968063,
      "endMs": 969963
    },
    {
      "index": 231,
      "text": "That's all right, Mr. Johannson. I'll handle it.",
      "kind": "dialogue",
      "startMs": 970065,
      "endMs": 972659
    },
    {
      "index": 232,
      "text": "Here's your taco, sir. I don't want it.",
      "kind": "dialogue",
      "startMs": 972768,
      "endMs": 975066
    },
    {
      "index": 233,
      "text": "But this comes out of my salary. If I had a girlfriend, she'd kill me.",
      "kind": "dialogue",
      "startMs": 975170,
      "endMs": 978571
    },
    {
      "index": 234,
      "text": "[Man]Okay, Krusty, let's rehearse the balloon bit.",
      "kind": "dialogue",
      "startMs": 978674,
      "endMs": 981575
    },
    {
      "index": 235,
      "text": "Look, kids! A horsie!",
      "kind": "dialogue",
      "startMs": 982745,
      "endMs": 986613
    },
    {
      "index": 236,
      "text": "And what are you making, Sideshow Luke Perry?",
      "kind": "dialogue",
      "startMs": 986715,
      "endMs": 989809
    },
    {
      "index": 237,
      "text": "A 1 9th-century carousel.",
      "kind": "dialogue",
      "startMs": 991387,
      "endMs": 993821
    },
    {
      "index": 238,
      "text": "[Yells] Upstage me, will ya?",
      "kind": "dialogue",
      "startMs": 996525,
      "endMs": 998720
    },
    {
      "index": 239,
      "text": "Get the hell out! - Look, there must be something I can do on the show.",
      "kind": "dialogue",
      "startMs": 998827,
      "endMs": 1002627
    },
    {
      "index": 240,
      "text": "Please. For Mom's sake?",
      "kind": "dialogue",
      "startMs": 1002731,
      "endMs": 1004756
    },
    {
      "index": 241,
      "text": "Well, maybe we can find something.",
      "kind": "dialogue",
      "startMs": 1004867,
      "endMs": 1008735
    },
    {
      "index": 242,
      "text": "[ Yelling ]",
      "kind": "sdh",
      "startMs": 1010439,
      "endMs": 1012430
    },
    {
      "index": 243,
      "text": "[ Sinister Chuckling ]",
      "kind": "sdh",
      "startMs": 1014610,
      "endMs": 1016475
    },
    {
      "index": 244,
      "text": "I don't like it. He's got Johnny Carson, Bette Midler and Hugh Hefner.",
      "kind": "dialogue",
      "startMs": 1023452,
      "endMs": 1027718
    },
    {
      "index": 245,
      "text": "What've we got? Ray Jay Johnson.",
      "kind": "dialogue",
      "startMs": 1027823,
      "endMs": 1030656
    },
    {
      "index": 246,
      "text": "Oy. Yi-yi-yi-yi-yi-yi-yi!",
      "kind": "dialogue",
      "startMs": 1030759,
      "endMs": 1034388
    },
    {
      "index": 247,
      "text": "Now, boys... the network has a problem with some of your lyrics.",
      "kind": "dialogue",
      "startMs": 1034496,
      "endMs": 1039133
    },
    {
      "index": 248,
      "text": "Would you mind changing 'em for the show? For get you, clown.",
      "kind": "dialogue",
      "startMs": 1039234,
      "endMs": 1042362
    },
    {
      "index": 249,
      "text": "Hey, our lyrics are like our children, man. No way.",
      "kind": "dialogue",
      "startMs": 1042471,
      "endMs": 1045372
    },
    {
      "index": 250,
      "text": "Well, okay. But here, where you say...",
      "kind": "dialogue",
      "startMs": 1045474,
      "endMs": 1047465
    },
    {
      "index": 251,
      "text": "\"What I got, you gotta get and put it in you,\" how about just, \"What I'd like is I'd like to hug and kiss you\"?",
      "kind": "dialogue",
      "startMs": 1047576,
      "endMs": 1053145
    },
    {
      "index": 252,
      "text": "Wow! That's much better. Everyone can enjoy that.",
      "kind": "dialogue",
      "startMs": 1053248,
      "endMs": 1057810
    },
    {
      "index": 253,
      "text": "-####[Drum roll] Live from Springfield... the entertainment capital of the state... the Krusty Komeback Special!",
      "kind": "dialogue",
      "startMs": 1057920,
      "endMs": 1063557
    },
    {
      "index": 254,
      "text": "####[Piano]",
      "kind": "dialogue",
      "startMs": 1063659,
      "endMs": 1065786
    },
    {
      "index": 255,
      "text": "## [ Singing Ballad ]",
      "kind": "dialogue",
      "startMs": 1067296,
      "endMs": 1070094
    },
    {
      "index": 256,
      "text": "[ Sobbing ]",
      "kind": "sdh",
      "startMs": 1095390,
      "endMs": 1098018
    },
    {
      "index": 257,
      "text": "## [ Singing Ballad ]",
      "kind": "dialogue",
      "startMs": 1098127,
      "endMs": 1102860
    },
    {
      "index": 258,
      "text": "[ Applause ]",
      "kind": "sdh",
      "startMs": 1107903,
      "endMs": 1110531
    },
    {
      "index": 259,
      "text": "I love you, Krusty. Quiet!",
      "kind": "dialogue",
      "startMs": 1113675,
      "endMs": 1116701
    },
    {
      "index": 260,
      "text": "####[Drum roll]",
      "kind": "dialogue",
      "startMs": 1118313,
      "endMs": 1121305
    },
    {
      "index": 261,
      "text": "Are you comfortable in there, Luke Perry? Fire away, Krusty.",
      "kind": "dialogue",
      "startMs": 1121416,
      "endMs": 1125716
    },
    {
      "index": 262,
      "text": "[Yelling]",
      "kind": "sdh",
      "startMs": 1126755,
      "endMs": 1129246
    },
    {
      "index": 263,
      "text": "Aah! My face! My valuable face! Hmph!",
      "kind": "dialogue",
      "startMs": 1133929,
      "endMs": 1138389
    },
    {
      "index": 264,
      "text": "[ Sighs ]",
      "kind": "sdh",
      "startMs": 1140536,
      "endMs": 1142766
    },
    {
      "index": 265,
      "text": "[Yelling]",
      "kind": "sdh",
      "startMs": 1144439,
      "endMs": 1146703
    },
    {
      "index": 266,
      "text": "[ Nervous Chuckle ] Oy!",
      "kind": "dialogue",
      "startMs": 1146809,
      "endMs": 1150074
    },
    {
      "index": 267,
      "text": "## [ Singing Rock]",
      "kind": "dialogue",
      "startMs": 1152014,
      "endMs": 1154312
    },
    {
      "index": 268,
      "text": "Dancin' around in their underwear. That is so degrading.",
      "kind": "dialogue",
      "startMs": 1159755,
      "endMs": 1163589
    },
    {
      "index": 269,
      "text": "30 seconds till your Little Stinker sketch. Get me a bigger lolly.",
      "kind": "dialogue",
      "startMs": 1163692,
      "endMs": 1167150
    },
    {
      "index": 270,
      "text": "Now, Johnny, whatcha got for us?",
      "kind": "dialogue",
      "startMs": 1167262,
      "endMs": 1169924
    },
    {
      "index": 271,
      "text": "Some jokes? A little magic?",
      "kind": "dialogue",
      "startMs": 1170032,
      "endMs": 1171932
    },
    {
      "index": 272,
      "text": "Actually, I thought I'd lift this 1 987 Buick Skylark over my head.",
      "kind": "dialogue",
      "startMs": 1172034,
      "endMs": 1175936
    },
    {
      "index": 273,
      "text": "Hi-yo! Johnny, that's amazing.",
      "kind": "dialogue",
      "startMs": 1178140,
      "endMs": 1180267
    },
    {
      "index": 274,
      "text": "Oh, yeah? Get a load of this.",
      "kind": "dialogue",
      "startMs": 1180375,
      "endMs": 1182275
    },
    {
      "index": 275,
      "text": "## [ Singing Opera In Foreign Language ]",
      "kind": "dialogue",
      "startMs": 1182377,
      "endMs": 1185107
    },
    {
      "index": 276,
      "text": "## [ Tones Chiming ]",
      "kind": "dialogue",
      "startMs": 1193555,
      "endMs": 1196490
    },
    {
      "index": 277,
      "text": "I've got to fire that agent.",
      "kind": "dialogue",
      "startMs": 1199695,
      "endMs": 1203187
    },
    {
      "index": 278,
      "text": "####[Piano] ## [ Singing Ballad ]",
      "kind": "dialogue",
      "startMs": 1203298,
      "endMs": 1209427
    },
    {
      "index": 279,
      "text": "[ Both Sobbing ]",
      "kind": "sdh",
      "startMs": 1234763,
      "endMs": 1237391
    },
    {
      "index": 280,
      "text": "This was a great show, Krusty. You deserve an Emmy for this.",
      "kind": "dialogue",
      "startMs": 1243672,
      "endMs": 1247369
    },
    {
      "index": 281,
      "text": "Forget it. The Academy hates me. I don't know why.",
      "kind": "dialogue",
      "startMs": 1247476,
      "endMs": 1250912
    },
    {
      "index": 282,
      "text": "Bunch of old, know-nothing dinosaurs... wouldn't know entertainment if it bit 'em in the-- Hey, hey! [ Laughs ] ####[Jazz]",
      "kind": "dialogue",
      "startMs": 1251013,
      "endMs": 1260112
    },
    {
      "index": 283,
      "text": "[ Dinging ]",
      "kind": "sdh",
      "startMs": 1260222,
      "endMs": 1262349
    },
    {
      "index": 284,
      "text": "[ Buzzing ] [ Grunting ] Now, Krusty, I just hope you remember to save your money this time.",
      "kind": "dialogue",
      "startMs": 1262457,
      "endMs": 1269256
    },
    {
      "index": 285,
      "text": "Here's that ruby-studded clown nose you ordered, Krusty.",
      "kind": "dialogue",
      "startMs": 1269364,
      "endMs": 1271958
    },
    {
      "index": 286,
      "text": "[ Sobbing ] Oy!",
      "kind": "dialogue",
      "startMs": 1272067,
      "endMs": 1275969
    },
    {
      "index": 287,
      "text": "What's up, Moe? Hey, Moe!",
      "kind": "dialogue",
      "startMs": 1276071,
      "endMs": 1277971
    },
    {
      "index": 288,
      "text": "Hey, you can't come in here dressed like that!",
      "kind": "dialogue",
      "startMs": 1278073,
      "endMs": 1280598
    },
    {
      "index": 289,
      "text": "Get with the times, Moe. Yeah.",
      "kind": "dialogue",
      "startMs": 1280709,
      "endMs": 1283405
    },
    {
      "index": 290,
      "text": "I say if it feels good, do it.",
      "kind": "dialogue",
      "startMs": 1283512,
      "endMs": 1285571
    },
    {
      "index": 291,
      "text": "All right.",
      "kind": "dialogue",
      "startMs": 1285681,
      "endMs": 1287615
    },
    {
      "index": 292,
      "text": "[ Chuckling ] Don't snap my undies.",
      "kind": "dialogue",
      "startMs": 1287716,
      "endMs": 1291152
    },
    {
      "index": 293,
      "text": "I'm a star again.",
      "kind": "dialogue",
      "startMs": 1291253,
      "endMs": 1293949
    },
    {
      "index": 294,
      "text": "I don't know how to thank you, kids.",
      "kind": "dialogue",
      "startMs": 1294056,
      "endMs": 1296149
    },
    {
      "index": 295,
      "text": "That's all right, Krusty. We're getting 50%% of the T-shirt sales.",
      "kind": "dialogue",
      "startMs": 1296258,
      "endMs": 1299921
    },
    {
      "index": 296,
      "text": "What? That's the sweetest plum!",
      "kind": "dialogue",
      "startMs": 1300028,
      "endMs": 1302656
    },
    {
      "index": 297,
      "text": "You little-- Aw, what the hell.",
      "kind": "dialogue",
      "startMs": 1302764,
      "endMs": 1306558
    },
    {
      "index": 298,
      "text": "You deserve it. Thanks, kids.",
      "kind": "dialogue",
      "startMs": 1306668,
      "endMs": 1309228
    },
    {
      "index": 299,
      "text": "To Krusty, the greatest entertainer in the world-- Except maybe that guy.",
      "kind": "dialogue",
      "startMs": 1309338,
      "endMs": 1316504
    },
    {
      "index": 300,
      "text": "Is this the bus to the civic center?",
      "kind": "dialogue",
      "startMs": 1318246,
      "endMs": 1320476
    },
    {
      "index": 301,
      "text": "[ People Chattering ] Shh! www.tvsubtitles.net",
      "kind": "dialogue",
      "startMs": 1375470,
      "endMs": 2000
    }
  ]
}
