  "lines": [
    {
      "index": 0,
      "text": "Sync & corrections by honeybunny www.addic7ed.com",
      "kind": "dialogue",
      "startMs": 103025,
      "endMs": 113418
    },
    {
      "index": 1,
      "text": "Oi!",
      "kind": "dialogue",
      "startMs": 124056,
      "endMs": 125140
    },
    {
      "index": 2,
      "text": "Mind out.",
      "kind": "dialogue",
      "startMs": 126973,
      "endMs": 128015
    },
    {
      "index": 3,
      "text": "Move!",
      "kind": "dialogue",
      "startMs": 130307,
      "endMs": 131307
    },
    {
      "index": 4,
      "text": "Look, on the west wall!",
      "kind": "dialogue",
      "startMs": 146307,
      "endMs": 148807
    },
    {
      "index": 5,
      "text": "Get down to the crypt!",
      "kind": "dialogue",
      "startMs": 148890,
      "endMs": 150807
    },
    {
      "index": 6,
      "text": "Just hold.",
      "kind": "dialogue",
      "startMs": 153849,
      "endMs": 155056
    },
    {
      "index": 7,
      "text": "We'll take him.",
      "kind": "dialogue",
      "startMs": 156140,
      "endMs": 157348
    },
    {
      "index": 8,
      "text": "Come on, help the lads! Yes, my lady.",
      "kind": "dialogue",
      "startMs": 161807,
      "endMs": 164056
    },
    {
      "index": 9,
      "text": "Quickly, now! Quickly! Get those in position.",
      "kind": "dialogue",
      "startMs": 164140,
      "endMs": 167307
    },
    {
      "index": 10,
      "text": "Come on. Close the gate!",
      "kind": "dialogue",
      "startMs": 167390,
      "endMs": 170473
    },
    {
      "index": 11,
      "text": "That's it.",
      "kind": "dialogue",
      "startMs": 170557,
      "endMs": 172181
    },
    {
      "index": 12,
      "text": "Oh, for fuck's sake. You took your time.",
      "kind": "dialogue",
      "startMs": 331390,
      "endMs": 334931
    },
    {
      "index": 13,
      "text": "Do you speak their tongue?",
      "kind": "dialogue",
      "startMs": 458557,
      "endMs": 460515
    },
    {
      "index": 14,
      "text": "Tell them to lift their swords.",
      "kind": "dialogue",
      "startMs": 464098,
      "endMs": 466515
    },
    {
      "index": 15,
      "text": "Valar morghulis.",
      "kind": "dialogue",
      "startMs": 570223,
      "endMs": 571849
    },
    {
      "index": 16,
      "text": "Valar dohaeris.",
      "kind": "dialogue",
      "startMs": 571931,
      "endMs": 573849
    },
    {
      "index": 17,
      "text": "Open the gate!",
      "kind": "dialogue",
      "startMs": 588640,
      "endMs": 589765
    },
    {
      "index": 18,
      "text": "Open the gate!",
      "kind": "dialogue",
      "startMs": 589849,
      "endMs": 591265
    },
    {
      "index": 19,
      "text": "Open the gate!",
      "kind": "dialogue",
      "startMs": 591348,
      "endMs": 593348
    },
    {
      "index": 20,
      "text": "Come. Come on.",
      "kind": "dialogue",
      "startMs": 608348,
      "endMs": 610140
    },
    {
      "index": 21,
      "text": "Easy.",
      "kind": "dialogue",
      "startMs": 611515,
      "endMs": 612515
    },
    {
      "index": 22,
      "text": "There's no need to execute me, Ser Davos.",
      "kind": "dialogue",
      "startMs": 639098,
      "endMs": 641890
    },
    {
      "index": 23,
      "text": "I'll be dead before the dawn.",
      "kind": "dialogue",
      "startMs": 641973,
      "endMs": 644557
    },
    {
      "index": 24,
      "text": "_",
      "kind": "dialogue",
      "startMs": 764307,
      "endMs": 767682
    },
    {
      "index": 25,
      "text": "The Night King is coming.",
      "kind": "dialogue",
      "startMs": 867765,
      "endMs": 869640
    },
    {
      "index": 26,
      "text": "The dead are already here.",
      "kind": "dialogue",
      "startMs": 871390,
      "endMs": 873390
    },
    {
      "index": 27,
      "text": "Stand your ground!",
      "kind": "dialogue",
      "startMs": 958056,
      "endMs": 959724
    },
    {
      "index": 28,
      "text": "Get down to the crypt.",
      "kind": "dialogue",
      "startMs": 1069098,
      "endMs": 1070849
    },
    {
      "index": 29,
      "text": "I'm not abandoning my people.",
      "kind": "dialogue",
      "startMs": 1072140,
      "endMs": 1074056
    },
    {
      "index": 30,
      "text": "Take this and go.",
      "kind": "dialogue",
      "startMs": 1074140,
      "endMs": 1075640
    },
    {
      "index": 31,
      "text": "I don't know how to use it.",
      "kind": "dialogue",
      "startMs": 1079181,
      "endMs": 1080807
    },
    {
      "index": 32,
      "text": "Stick them with the pointy end.",
      "kind": "dialogue",
      "startMs": 1082015,
      "endMs": 1083807
    },
    {
      "index": 33,
      "text": "Edd!",
      "kind": "dialogue",
      "startMs": 1170515,
      "endMs": 1171890
    },
    {
      "index": 34,
      "text": "Edd!",
      "kind": "dialogue",
      "startMs": 1173056,
      "endMs": 1174348
    },
    {
      "index": 35,
      "text": "Sam, get up!",
      "kind": "dialogue",
      "startMs": 1193265,
      "endMs": 1194557
    },
    {
      "index": 36,
      "text": "Oh, God. Sam.",
      "kind": "dialogue",
      "startMs": 1199515,
      "endMs": 1201765
    },
    {
      "index": 37,
      "text": "Edd!",
      "kind": "dialogue",
      "startMs": 1205931,
      "endMs": 1207307
    },
    {
      "index": 38,
      "text": "Fall back! Fall back!",
      "kind": "dialogue",
      "startMs": 1308890,
      "endMs": 1311557
    },
    {
      "index": 39,
      "text": "Fall back!",
      "kind": "dialogue",
      "startMs": 1313849,
      "endMs": 1315931
    },
    {
      "index": 40,
      "text": "Come on!",
      "kind": "dialogue",
      "startMs": 1316015,
      "endMs": 1317098
    },
    {
      "index": 41,
      "text": "Open the gate!",
      "kind": "dialogue",
      "startMs": 1318807,
      "endMs": 1319765
    },
    {
      "index": 42,
      "text": "Open the gate!",
      "kind": "dialogue",
      "startMs": 1319849,
      "endMs": 1321765
    },
    {
      "index": 43,
      "text": "Let us in!",
      "kind": "dialogue",
      "startMs": 1321849,
      "endMs": 1323056
    },
    {
      "index": 44,
      "text": "Open the gate!",
      "kind": "dialogue",
      "startMs": 1325265,
      "endMs": 1326765
    },
    {
      "index": 45,
      "text": "Open the gate!",
      "kind": "dialogue",
      "startMs": 1326849,
      "endMs": 1328223
    },
    {
      "index": 46,
      "text": "Keep moving!",
      "kind": "dialogue",
      "startMs": 1331056,
      "endMs": 1332223
    },
    {
      "index": 47,
      "text": "Come on!",
      "kind": "dialogue",
      "startMs": 1336015,
      "endMs": 1337348
    },
    {
      "index": 48,
      "text": "Keep moving, fast. To your posts.",
      "kind": "dialogue",
      "startMs": 1340557,
      "endMs": 1343140
    },
    {
      "index": 49,
      "text": "Go! Keep moving!",
      "kind": "dialogue",
      "startMs": 1343223,
      "endMs": 1345223
    },
    {
      "index": 50,
      "text": "Come on, run!",
      "kind": "dialogue",
      "startMs": 1347056,
      "endMs": 1348807
    },
    {
      "index": 51,
      "text": "Keep moving!",
      "kind": "dialogue",
      "startMs": 1348890,
      "endMs": 1350056
    },
    {
      "index": 52,
      "text": "_",
      "kind": "dialogue",
      "startMs": 1356682,
      "endMs": 1358937
    },
    {
      "index": 53,
      "text": "_",
      "kind": "dialogue",
      "startMs": 1362053,
      "endMs": 1364258
    },
    {
      "index": 54,
      "text": "Dany!",
      "kind": "dialogue",
      "startMs": 1405432,
      "endMs": 1406807
    },
    {
      "index": 55,
      "text": "Grab your weapon now!",
      "kind": "dialogue",
      "startMs": 1433599,
      "endMs": 1435515
    },
    {
      "index": 56,
      "text": "Guard the barricades!",
      "kind": "dialogue",
      "startMs": 1435599,
      "endMs": 1437181
    },
    {
      "index": 57,
      "text": "Through that pass!",
      "kind": "dialogue",
      "startMs": 1437265,
      "endMs": 1439515
    },
    {
      "index": 58,
      "text": "Hey! Hey! Hey!",
      "kind": "dialogue",
      "startMs": 1439599,
      "endMs": 1441098
    },
    {
      "index": 59,
      "text": "Close up the gaps!",
      "kind": "dialogue",
      "startMs": 1441181,
      "endMs": 1442599
    },
    {
      "index": 60,
      "text": "Go! Hey! Go! Go!",
      "kind": "dialogue",
      "startMs": 1442682,
      "endMs": 1445599
    },
    {
      "index": 61,
      "text": "Get in! Get in!",
      "kind": "dialogue",
      "startMs": 1445682,
      "endMs": 1447599
    },
    {
      "index": 62,
      "text": "Get in! Come on!",
      "kind": "dialogue",
      "startMs": 1447682,
      "endMs": 1449348
    },
    {
      "index": 63,
      "text": "Move!",
      "kind": "dialogue",
      "startMs": 1484140,
      "endMs": 1485765
    },
    {
      "index": 64,
      "text": "_ _",
      "kind": "dialogue",
      "startMs": 1515557,
      "endMs": 1520682
    },
    {
      "index": 65,
      "text": "Come on! Come on!",
      "kind": "dialogue",
      "startMs": 1520765,
      "endMs": 1522807
    },
    {
      "index": 66,
      "text": "Come on! Come on!",
      "kind": "dialogue",
      "startMs": 1522890,
      "endMs": 1524432
    },
    {
      "index": 67,
      "text": "Protect the gate!",
      "kind": "dialogue",
      "startMs": 1525890,
      "endMs": 1527223
    },
    {
      "index": 68,
      "text": "Protect the gate!",
      "kind": "dialogue",
      "startMs": 1527307,
      "endMs": 1529348
    },
    {
      "index": 69,
      "text": "They're coming! Come on!",
      "kind": "dialogue",
      "startMs": 1529432,
      "endMs": 1531931
    },
    {
      "index": 70,
      "text": "Fall back!",
      "kind": "dialogue",
      "startMs": 1532015,
      "endMs": 1533599
    },
    {
      "index": 71,
      "text": "Light the trench!",
      "kind": "dialogue",
      "startMs": 1553515,
      "endMs": 1554557
    },
    {
      "index": 72,
      "text": "Light the trench!",
      "kind": "dialogue",
      "startMs": 1555348,
      "endMs": 1556765
    },
    {
      "index": 73,
      "text": "Wait! Light the trench!",
      "kind": "dialogue",
      "startMs": 1558056,
      "endMs": 1560473
    },
    {
      "index": 74,
      "text": "She can't see us.",
      "kind": "dialogue",
      "startMs": 1589807,
      "endMs": 1591015
    },
    {
      "index": 75,
      "text": "Light the trenches!",
      "kind": "dialogue",
      "startMs": 1592765,
      "endMs": 1593807
    },
    {
      "index": 76,
      "text": "With a torch, light the trenches!",
      "kind": "dialogue",
      "startMs": 1608307,
      "endMs": 1610432
    },
    {
      "index": 77,
      "text": "Right there. Torch it!",
      "kind": "dialogue",
      "startMs": 1610515,
      "endMs": 1612973
    },
    {
      "index": 78,
      "text": "Light the trenches!",
      "kind": "dialogue",
      "startMs": 1614599,
      "endMs": 1615682
    },
    {
      "index": 79,
      "text": "Clegane.",
      "kind": "dialogue",
      "startMs": 1780557,
      "endMs": 1781515
    },
    {
      "index": 80,
      "text": "You must try not to worry yourself.",
      "kind": "dialogue",
      "startMs": 1787682,
      "endMs": 1790682
    },
    {
      "index": 81,
      "text": "At least we're already in a crypt.",
      "kind": "dialogue",
      "startMs": 1802682,
      "endMs": 1805849
    },
    {
      "index": 82,
      "text": "If we were up there, we might see something everyone else is missing.",
      "kind": "dialogue",
      "startMs": 1810557,
      "endMs": 1816098
    },
    {
      "index": 83,
      "text": "Something that makes a difference.",
      "kind": "dialogue",
      "startMs": 1817557,
      "endMs": 1819181
    },
    {
      "index": 84,
      "text": "What?",
      "kind": "dialogue",
      "startMs": 1819265,
      "endMs": 1821973
    },
    {
      "index": 85,
      "text": "Remember the Battle of Blackwater?",
      "kind": "dialogue",
      "startMs": 1822056,
      "endMs": 1823682
    },
    {
      "index": 86,
      "text": "I brought us through the Mud Gate.",
      "kind": "dialogue",
      "startMs": 1823765,
      "endMs": 1825098
    },
    {
      "index": 87,
      "text": "And got your face cut in half.",
      "kind": "dialogue",
      "startMs": 1825181,
      "endMs": 1826599
    },
    {
      "index": 88,
      "text": "And it made a difference.",
      "kind": "dialogue",
      "startMs": 1826682,
      "endMs": 1828390
    },
    {
      "index": 89,
      "text": "If I was out there right now...",
      "kind": "dialogue",
      "startMs": 1830890,
      "endMs": 1832473
    },
    {
      "index": 90,
      "text": "You'd die.",
      "kind": "dialogue",
      "startMs": 1832557,
      "endMs": 1833931
    },
    {
      "index": 91,
      "text": "There's nothing you can do.",
      "kind": "dialogue",
      "startMs": 1836265,
      "endMs": 1838265
    },
    {
      "index": 92,
      "text": "You might be surprised at the lengths I'd go to avoid joining the Army of the Dead.",
      "kind": "dialogue",
      "startMs": 1841849,
      "endMs": 1846640
    },
    {
      "index": 93,
      "text": "I could think of no organization less suited to my talents.",
      "kind": "dialogue",
      "startMs": 1846724,
      "endMs": 1849931
    },
    {
      "index": 94,
      "text": "Witty remarks won't make a difference.",
      "kind": "dialogue",
      "startMs": 1850015,
      "endMs": 1852432
    },
    {
      "index": 95,
      "text": "That's why we're down here, none of us can do anything.",
      "kind": "dialogue",
      "startMs": 1854807,
      "endMs": 1857973
    },
    {
      "index": 96,
      "text": "It's the truth.",
      "kind": "dialogue",
      "startMs": 1859807,
      "endMs": 1860890
    },
    {
      "index": 97,
      "text": "It's the most heroic thing we can do now... look the truth in the face.",
      "kind": "dialogue",
      "startMs": 1862140,
      "endMs": 1868432
    },
    {
      "index": 98,
      "text": "Maybe we should have stayed married.",
      "kind": "dialogue",
      "startMs": 1873265,
      "endMs": 1875682
    },
    {
      "index": 99,
      "text": "You were the best of them.",
      "kind": "dialogue",
      "startMs": 1875765,
      "endMs": 1877599
    },
    {
      "index": 100,
      "text": "What a terrifying thought.",
      "kind": "dialogue",
      "startMs": 1878807,
      "endMs": 1880973
    },
    {
      "index": 101,
      "text": "It wouldn't work between us.",
      "kind": "dialogue",
      "startMs": 1887931,
      "endMs": 1889432
    },
    {
      "index": 102,
      "text": "Why not?",
      "kind": "dialogue",
      "startMs": 1890765,
      "endMs": 1892432
    },
    {
      "index": 103,
      "text": "The Dragon Queen.",
      "kind": "dialogue",
      "startMs": 1892515,
      "endMs": 1893931
    },
    {
      "index": 104,
      "text": "Your divided loyalties would become a problem.",
      "kind": "dialogue",
      "startMs": 1895931,
      "endMs": 1899307
    },
    {
      "index": 105,
      "text": "Yes.",
      "kind": "dialogue",
      "startMs": 1900307,
      "endMs": 1902056
    },
    {
      "index": 106,
      "text": "Without the Dragon Queen, there'd be no problem at all.",
      "kind": "dialogue",
      "startMs": 1902140,
      "endMs": 1904973
    },
    {
      "index": 107,
      "text": "We'd all be dead already.",
      "kind": "dialogue",
      "startMs": 1906098,
      "endMs": 1907682
    },
    {
      "index": 108,
      "text": "They lit the trench.",
      "kind": "dialogue",
      "startMs": 1929432,
      "endMs": 1931307
    },
    {
      "index": 109,
      "text": "Bran...",
      "kind": "dialogue",
      "startMs": 1945015,
      "endMs": 1946015
    },
    {
      "index": 110,
      "text": "I just want you to know...",
      "kind": "dialogue",
      "startMs": 1951432,
      "endMs": 1953348
    },
    {
      "index": 111,
      "text": "I wish...",
      "kind": "dialogue",
      "startMs": 1957515,
      "endMs": 1958473
    },
    {
      "index": 112,
      "text": "The things I did...",
      "kind": "dialogue",
      "startMs": 1959724,
      "endMs": 1961056
    },
    {
      "index": 113,
      "text": "Everything you did brought you where you are now.",
      "kind": "dialogue",
      "startMs": 1961140,
      "endMs": 1964056
    },
    {
      "index": 114,
      "text": "Where you belong.",
      "kind": "dialogue",
      "startMs": 1966348,
      "endMs": 1967724
    },
    {
      "index": 115,
      "text": "Home.",
      "kind": "dialogue",
      "startMs": 1969849,
      "endMs": 1971015
    },
    {
      "index": 116,
      "text": "I'm going to go now.",
      "kind": "dialogue",
      "startMs": 1981724,
      "endMs": 1983890
    },
    {
      "index": 117,
      "text": "Go where?",
      "kind": "dialogue",
      "startMs": 1986557,
      "endMs": 1987557
    },
    {
      "index": 118,
      "text": "Man the walls!",
      "kind": "dialogue",
      "startMs": 2096307,
      "endMs": 2097640
    },
    {
      "index": 119,
      "text": "Man the walls!",
      "kind": "dialogue",
      "startMs": 2098682,
      "endMs": 2100307
    },
    {
      "index": 120,
      "text": "Man the wall!",
      "kind": "dialogue",
      "startMs": 2108515,
      "endMs": 2110682
    },
    {
      "index": 121,
      "text": "Man the walls!",
      "kind": "dialogue",
      "startMs": 2110765,
      "endMs": 2112348
    },
    {
      "index": 122,
      "text": "Come on!",
      "kind": "dialogue",
      "startMs": 2114181,
      "endMs": 2115931
    },
    {
      "index": 123,
      "text": "Get out there! Get moving!",
      "kind": "dialogue",
      "startMs": 2116015,
      "endMs": 2118807
    },
    {
      "index": 124,
      "text": "Come on. Come on! Come on!",
      "kind": "dialogue",
      "startMs": 2118890,
      "endMs": 2121015
    },
    {
      "index": 125,
      "text": "Go, go, go!",
      "kind": "dialogue",
      "startMs": 2124473,
      "endMs": 2126849
    },
    {
      "index": 126,
      "text": "Come on!",
      "kind": "dialogue",
      "startMs": 2126931,
      "endMs": 2128390
    },
    {
      "index": 127,
      "text": "They're against the wall!",
      "kind": "dialogue",
      "startMs": 2167890,
      "endMs": 2169765
    },
    {
      "index": 128,
      "text": "Get more men up here!",
      "kind": "dialogue",
      "startMs": 2173890,
      "endMs": 2176098
    },
    {
      "index": 129,
      "text": "Fill the gaps, quickly! Get in there!",
      "kind": "dialogue",
      "startMs": 2180265,
      "endMs": 2182348
    },
    {
      "index": 130,
      "text": "They're climbing the walls!",
      "kind": "dialogue",
      "startMs": 2182432,
      "endMs": 2183973
    },
    {
      "index": 131,
      "text": "Relieve the archers! Relieve the archers!",
      "kind": "dialogue",
      "startMs": 2184056,
      "endMs": 2186599
    },
    {
      "index": 132,
      "text": "Archers on top!",
      "kind": "dialogue",
      "startMs": 2188473,
      "endMs": 2189849
    },
    {
      "index": 133,
      "text": "Move up! Go, go! Come here!",
      "kind": "dialogue",
      "startMs": 2189931,
      "endMs": 2192682
    },
    {
      "index": 134,
      "text": "Come on! Move back!",
      "kind": "dialogue",
      "startMs": 2192765,
      "endMs": 2194307
    },
    {
      "index": 135,
      "text": "Stand away! Go on, go on. Go! Go.",
      "kind": "dialogue",
      "startMs": 2194390,
      "endMs": 2196307
    },
    {
      "index": 136,
      "text": "Step back. All the way, archers!",
      "kind": "dialogue",
      "startMs": 2196390,
      "endMs": 2198724
    },
    {
      "index": 137,
      "text": "Hold the wall!",
      "kind": "dialogue",
      "startMs": 2214432,
      "endMs": 2215682
    },
    {
      "index": 138,
      "text": "The wall, they're coming up!",
      "kind": "dialogue",
      "startMs": 2215765,
      "endMs": 2217307
    },
    {
      "index": 139,
      "text": "Hold the wall! Hold the wall!",
      "kind": "dialogue",
      "startMs": 2217390,
      "endMs": 2220849
    },
    {
      "index": 140,
      "text": "Draw!",
      "kind": "dialogue",
      "startMs": 2220931,
      "endMs": 2222098
    },
    {
      "index": 141,
      "text": "Come on!",
      "kind": "dialogue",
      "startMs": 2246807,
      "endMs": 2247973
    },
    {
      "index": 142,
      "text": "They're coming up!",
      "kind": "dialogue",
      "startMs": 2298849,
      "endMs": 2300181
    },
    {
      "index": 143,
      "text": "Look out!",
      "kind": "dialogue",
      "startMs": 2312390,
      "endMs": 2313557
    },
    {
      "index": 144,
      "text": "Clegane!",
      "kind": "dialogue",
      "startMs": 2412557,
      "endMs": 2413682
    },
    {
      "index": 145,
      "text": "Clegane!",
      "kind": "dialogue",
      "startMs": 2415140,
      "endMs": 2416265
    },
    {
      "index": 146,
      "text": "Clegane!",
      "kind": "dialogue",
      "startMs": 2486765,
      "endMs": 2488682
    },
    {
      "index": 147,
      "text": "Clegane, we need you!",
      "kind": "dialogue",
      "startMs": 2488765,
      "endMs": 2490973
    },
    {
      "index": 148,
      "text": "You can't give up on us.",
      "kind": "dialogue",
      "startMs": 2491056,
      "endMs": 2492307
    },
    {
      "index": 149,
      "text": "Fuck off! We can't beat them.",
      "kind": "dialogue",
      "startMs": 2492390,
      "endMs": 2494599
    },
    {
      "index": 150,
      "text": "Don't you see that, you stupid whore?",
      "kind": "dialogue",
      "startMs": 2494682,
      "endMs": 2497181
    },
    {
      "index": 151,
      "text": "We're fighting Death!",
      "kind": "dialogue",
      "startMs": 2497265,
      "endMs": 2498973
    },
    {
      "index": 152,
      "text": "They can't beat Death.",
      "kind": "dialogue",
      "startMs": 2499056,
      "endMs": 2500390
    },
    {
      "index": 153,
      "text": "Tell her that.",
      "kind": "dialogue",
      "startMs": 2505307,
      "endMs": 2506557
    },
    {
      "index": 154,
      "text": "Open the door!",
      "kind": "dialogue",
      "startMs": 2961056,
      "endMs": 2962348
    },
    {
      "index": 155,
      "text": "Open the door!",
      "kind": "dialogue",
      "startMs": 2964973,
      "endMs": 2966307
    },
    {
      "index": 156,
      "text": "Come on! Open the door!",
      "kind": "dialogue",
      "startMs": 2966390,
      "endMs": 2968140
    },
    {
      "index": 157,
      "text": "Open the door!",
      "kind": "dialogue",
      "startMs": 2968223,
      "endMs": 2969640
    },
    {
      "index": 158,
      "text": "Please!",
      "kind": "dialogue",
      "startMs": 2974432,
      "endMs": 2976265
    },
    {
      "index": 159,
      "text": "Open it!",
      "kind": "dialogue",
      "startMs": 2976348,
      "endMs": 2977515
    },
    {
      "index": 160,
      "text": "Rah!",
      "kind": "dialogue",
      "startMs": 3054599,
      "endMs": 3056265
    },
    {
      "index": 161,
      "text": "Aah!",
      "kind": "dialogue",
      "startMs": 3063015,
      "endMs": 3064098
    },
    {
      "index": 162,
      "text": "Come on! Go!",
      "kind": "dialogue",
      "startMs": 3072307,
      "endMs": 3074890
    },
    {
      "index": 163,
      "text": "Come on! Run!",
      "kind": "dialogue",
      "startMs": 3074973,
      "endMs": 3077849
    },
    {
      "index": 164,
      "text": "We've gotta go!",
      "kind": "dialogue",
      "startMs": 3104056,
      "endMs": 3105348
    },
    {
      "index": 165,
      "text": "The Lord brought him back for a purpose.",
      "kind": "dialogue",
      "startMs": 3166765,
      "endMs": 3169849
    },
    {
      "index": 166,
      "text": "Now that purpose has been served.",
      "kind": "dialogue",
      "startMs": 3174223,
      "endMs": 3176432
    },
    {
      "index": 167,
      "text": "I know you.",
      "kind": "dialogue",
      "startMs": 3181890,
      "endMs": 3182890
    },
    {
      "index": 168,
      "text": "And I know you.",
      "kind": "dialogue",
      "startMs": 3188599,
      "endMs": 3189765
    },
    {
      "index": 169,
      "text": "You said we'd meet again.",
      "kind": "dialogue",
      "startMs": 3197557,
      "endMs": 3199849
    },
    {
      "index": 170,
      "text": "And here we are.",
      "kind": "dialogue",
      "startMs": 3199931,
      "endMs": 3201140
    },
    {
      "index": 171,
      "text": "At the end of the world.",
      "kind": "dialogue",
      "startMs": 3202181,
      "endMs": 3203473
    },
    {
      "index": 172,
      "text": "You said I'd shut many eyes forever.",
      "kind": "dialogue",
      "startMs": 3205599,
      "endMs": 3207557
    },
    {
      "index": 173,
      "text": "You were right about that too.",
      "kind": "dialogue",
      "startMs": 3209223,
      "endMs": 3210765
    },
    {
      "index": 174,
      "text": "Brown eyes... green eyes...",
      "kind": "dialogue",
      "startMs": 3211849,
      "endMs": 3214973
    },
    {
      "index": 175,
      "text": "and blue eyes.",
      "kind": "dialogue",
      "startMs": 3217307,
      "endMs": 3218640
    },
    {
      "index": 176,
      "text": "What do we say to the God of Death?",
      "kind": "dialogue",
      "startMs": 3238098,
      "endMs": 3240807
    },
    {
      "index": 177,
      "text": "Not today.",
      "kind": "dialogue",
      "startMs": 3245056,
      "endMs": 3246140
    },
    {
      "index": 178,
      "text": "Here they come!",
      "kind": "dialogue",
      "startMs": 3271640,
      "endMs": 3272682
    },
    {
      "index": 179,
      "text": "Steady, lads.",
      "kind": "dialogue",
      "startMs": 3276432,
      "endMs": 3277515
    },
    {
      "index": 180,
      "text": "Steady now.",
      "kind": "dialogue",
      "startMs": 3278890,
      "endMs": 3279973
    },
    {
      "index": 181,
      "text": "Make every shot count.",
      "kind": "dialogue",
      "startMs": 3282807,
      "endMs": 3284181
    },
    {
      "index": 182,
      "text": "Over there!",
      "kind": "dialogue",
      "startMs": 3293599,
      "endMs": 3294682
    },
    {
      "index": 183,
      "text": "There!",
      "kind": "dialogue",
      "startMs": 3297931,
      "endMs": 3298973
    },
    {
      "index": 184,
      "text": "Get off.",
      "kind": "dialogue",
      "startMs": 3339432,
      "endMs": 3340724
    },
    {
      "index": 185,
      "text": "Dracarys.",
      "kind": "dialogue",
      "startMs": 3437931,
      "endMs": 3439015
    },
    {
      "index": 186,
      "text": "Come on! Come on!",
      "kind": "dialogue",
      "startMs": 3722890,
      "endMs": 3724432
    },
    {
      "index": 187,
      "text": "No! No, no, no!",
      "kind": "dialogue",
      "startMs": 3726599,
      "endMs": 3728931
    },
    {
      "index": 188,
      "text": "Bran! Go!",
      "kind": "dialogue",
      "startMs": 3778807,
      "endMs": 3781181
    },
    {
      "index": 189,
      "text": "Jorah!",
      "kind": "dialogue",
      "startMs": 4099140,
      "endMs": 4100181
    },
    {
      "index": 190,
      "text": "Theon.",
      "kind": "dialogue",
      "startMs": 4265765,
      "endMs": 4266931
    },
    {
      "index": 191,
      "text": "You're a good man.",
      "kind": "dialogue",
      "startMs": 4278765,
      "endMs": 4280307
    },
    {
      "index": 192,
      "text": "Thank you.",
      "kind": "dialogue",
      "startMs": 4286348,
      "endMs": 4287348
    },
    {
      "index": 193,
      "text": "I'm hurt.",
      "kind": "dialogue",
      "startMs": 4611181,
      "endMs": 4612849
    },
    {
      "index": 194,
      "text": "Sync & corrections by honeybunny www.addic7ed.com",
      "kind": "dialogue",
      "startMs": 4798432,
      "endMs": 4808516
    },
    {
      "index": 195,
      "text": "We have won the Great War.",
      "kind": "dialogue",
      "startMs": 4891223,
      "endMs": 4893307
    },
    {
      "index": 196,
      "text": "Now, we will win the last war.",
      "kind": "dialogue",
      "startMs": 4895140,
      "endMs": 4896724
    },
    {
      "index": 197,
      "text": "We'll rip her out root and stem.",
      "kind": "dialogue",
      "startMs": 4904724,
      "endMs": 4906807
    }
  ],
  "meta": {
    "show": "Game of Thrones",
    "season": 8,
    "episode": 3
  }
}
