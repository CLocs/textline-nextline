{
  "id": "game-of-thrones---8x03---the-long-night",
  "title": "Game of Thrones - 8x03 - The Long Night",
  "sourceFilename": "Game of Thrones - 8x03 - The Long Night.en.srt",
  "importedAt": "2026-11-12T03:26:51.573Z",
  "lineCount": 191,
  "lines": [
    {
      "index": 0,
      "text": "Oi!",
      "kind": "dialogue",
      "startMs": 123290,
      "endMs": 124326
    },
    {
      "index": 1,
      "text": "Mind out.",
      "kind": "dialogue",
      "startMs": 126209,
      "endMs": 127245
    },
    {
      "index": 2,
      "text": "Move!",
      "kind": "dialogue",
      "startMs": 129463,
      "endMs": 130499
    },
    {
      "index": 3,
      "text": "Look, on the west wall!",
      "kind": "dialogue",
      "startMs": 145604,
      "endMs": 147391
    },
    {
      "index": 4,
      "text": "Get down to the crypt!",
      "kind": "dialogue",
      "startMs": 148440,
      "endMs": 150022
    },
    {
      "index": 5,
      "text": "Just hold.",
      "kind": "dialogue",
      "startMs": 152903,
      "endMs": 154235
    },
    {
      "index": 6,
      "text": "We'll take him.",
      "kind": "dialogue",
      "startMs": 155364,
      "endMs": 156525
    },
    {
      "index": 7,
      "text": "Come on, help the lads!",
      "kind": "dialogue",
      "startMs": 160994,
      "endMs": 162513
    },
    {
      "index": 8,
      "text": "Yes, my lady.",
      "kind": "dialogue",
      "startMs": 162537,
      "endMs": 163537
    },
    {
      "index": 9,
      "text": "Quickly, now! Quickly! Get those in position.",
      "kind": "dialogue",
      "startMs": 163622,
      "endMs": 166615
    },
    {
      "index": 10,
      "text": "Come on. Close the gate!",
      "kind": "dialogue",
      "startMs": 166708,
      "endMs": 168916
    },
    {
      "index": 11,
      "text": "That's it.",
      "kind": "dialogue",
      "startMs": 169795,
      "endMs": 170831
    },
    {
      "index": 12,
      "text": "Oh, for fuck's sake. You took your time.",
      "kind": "dialogue",
      "startMs": 330705,
      "endMs": 334164
    },
    {
      "index": 13,
      "text": "Do you speak their tongue?",
      "kind": "dialogue",
      "startMs": 457832,
      "endMs": 459368
    },
    {
      "index": 14,
      "text": "Tell them to lift their swords.",
      "kind": "dialogue",
      "startMs": 463338,
      "endMs": 465375
    },
    {
      "index": 15,
      "text": "Valar Morghulis.",
      "kind": "dialogue",
      "startMs": 569527,
      "endMs": 571018
    },
    {
      "index": 16,
      "text": "Valar Dohaeris.",
      "kind": "dialogue",
      "startMs": 571112,
      "endMs": 572569
    },
    {
      "index": 17,
      "text": "Open the gate!",
      "kind": "dialogue",
      "startMs": 587796,
      "endMs": 589037
    },
    {
      "index": 18,
      "text": "Open the gate!",
      "kind": "dialogue",
      "startMs": 589130,
      "endMs": 590371
    },
    {
      "index": 19,
      "text": "Open the gate!",
      "kind": "dialogue",
      "startMs": 590465,
      "endMs": 591546
    },
    {
      "index": 20,
      "text": "Come. Come on.",
      "kind": "dialogue",
      "startMs": 607649,
      "endMs": 609356
    },
    {
      "index": 21,
      "text": "Easy.",
      "kind": "dialogue",
      "startMs": 610610,
      "endMs": 611646
    },
    {
      "index": 22,
      "text": "There's no need to execute me, Ser Davos.",
      "kind": "dialogue",
      "startMs": 638429,
      "endMs": 641092
    },
    {
      "index": 23,
      "text": "I'll be dead before the dawn.",
      "kind": "dialogue",
      "startMs": 641182,
      "endMs": 643048
    },
    {
      "index": 24,
      "text": "Cease fire!",
      "kind": "dialogue",
      "startMs": 763680,
      "endMs": 766844
    },
    {
      "index": 25,
      "text": "The Night King is coming.",
      "kind": "dialogue",
      "startMs": 866741,
      "endMs": 868482
    },
    {
      "index": 26,
      "text": "The dead are already here.",
      "kind": "dialogue",
      "startMs": 870620,
      "endMs": 872236
    },
    {
      "index": 27,
      "text": "Stand your ground!",
      "kind": "dialogue",
      "startMs": 957290,
      "endMs": 959623
    },
    {
      "index": 28,
      "text": "Get down to the crypt.",
      "kind": "dialogue",
      "startMs": 1068359,
      "endMs": 1069566
    },
    {
      "index": 29,
      "text": "I'm not abandoning my people.",
      "kind": "dialogue",
      "startMs": 1071362,
      "endMs": 1073149
    },
    {
      "index": 30,
      "text": "Take this and go.",
      "kind": "dialogue",
      "startMs": 1073239,
      "endMs": 1074275
    },
    {
      "index": 31,
      "text": "I don't know how to use it.",
      "kind": "dialogue",
      "startMs": 1078411,
      "endMs": 1079947
    },
    {
      "index": 32,
      "text": "Stick them with the pointy end.",
      "kind": "dialogue",
      "startMs": 1081080,
      "endMs": 1082537
    },
    {
      "index": 33,
      "text": "Edd!",
      "kind": "dialogue",
      "startMs": 1169710,
      "endMs": 1170746
    },
    {
      "index": 34,
      "text": "Edd!",
      "kind": "dialogue",
      "startMs": 1172129,
      "endMs": 1173461
    },
    {
      "index": 35,
      "text": "Sam, get up!",
      "kind": "dialogue",
      "startMs": 1192441,
      "endMs": 1193807
    },
    {
      "index": 36,
      "text": "Oh, God. Sam.",
      "kind": "dialogue",
      "startMs": 1198781,
      "endMs": 1201068
    },
    {
      "index": 37,
      "text": "Fall back! Fall back!",
      "kind": "dialogue",
      "startMs": 1308057,
      "endMs": 1310765
    },
    {
      "index": 38,
      "text": "Fall back!",
      "kind": "dialogue",
      "startMs": 1312978,
      "endMs": 1315095
    },
    {
      "index": 39,
      "text": "Come on!",
      "kind": "dialogue",
      "startMs": 1315189,
      "endMs": 1316305
    },
    {
      "index": 40,
      "text": "Open the gate!",
      "kind": "dialogue",
      "startMs": 1317942,
      "endMs": 1319023
    },
    {
      "index": 41,
      "text": "Open the gate!",
      "kind": "dialogue",
      "startMs": 1319109,
      "endMs": 1320975
    },
    {
      "index": 42,
      "text": "Let us in!",
      "kind": "dialogue",
      "startMs": 1321070,
      "endMs": 1322151
    },
    {
      "index": 43,
      "text": "Open the gate!",
      "kind": "dialogue",
      "startMs": 1324532,
      "endMs": 1325864
    },
    {
      "index": 44,
      "text": "Open the gate!",
      "kind": "dialogue",
      "startMs": 1325950,
      "endMs": 1327441
    },
    {
      "index": 45,
      "text": "Keep moving!",
      "kind": "dialogue",
      "startMs": 1330329,
      "endMs": 1331365
    },
    {
      "index": 46,
      "text": "Come on!",
      "kind": "dialogue",
      "startMs": 1335292,
      "endMs": 1336453
    },
    {
      "index": 47,
      "text": "Keep moving, fast. To your posts.",
      "kind": "dialogue",
      "startMs": 1340047,
      "endMs": 1342460
    },
    {
      "index": 48,
      "text": "Go! Keep moving!",
      "kind": "dialogue",
      "startMs": 1342550,
      "endMs": 1344416
    },
    {
      "index": 49,
      "text": "Come on, run!",
      "kind": "dialogue",
      "startMs": 1346345,
      "endMs": 1348086
    },
    {
      "index": 50,
      "text": "Keep moving!",
      "kind": "dialogue",
      "startMs": 1348180,
      "endMs": 1349180
    },
    {
      "index": 51,
      "text": "Protect the retreat!",
      "kind": "dialogue",
      "startMs": 1355855,
      "endMs": 1357847
    },
    {
      "index": 52,
      "text": "Stand your ground!",
      "kind": "dialogue",
      "startMs": 1361151,
      "endMs": 1363564
    },
    {
      "index": 53,
      "text": "Dany!",
      "kind": "dialogue",
      "startMs": 1404570,
      "endMs": 1405936
    },
    {
      "index": 54,
      "text": "Grab your weapon now!",
      "kind": "dialogue",
      "startMs": 1432890,
      "endMs": 1434756
    },
    {
      "index": 55,
      "text": "Guard the barricades!",
      "kind": "dialogue",
      "startMs": 1434850,
      "endMs": 1436432
    },
    {
      "index": 56,
      "text": "Through that pass!",
      "kind": "dialogue",
      "startMs": 1436518,
      "endMs": 1438726
    },
    {
      "index": 57,
      "text": "Hey! Hey! Hey!",
      "kind": "dialogue",
      "startMs": 1438812,
      "endMs": 1440428
    },
    {
      "index": 58,
      "text": "Close up the gaps!",
      "kind": "dialogue",
      "startMs": 1440522,
      "endMs": 1441763
    },
    {
      "index": 59,
      "text": "Go! Hey! Go! Go!",
      "kind": "dialogue",
      "startMs": 1441857,
      "endMs": 1444770
    },
    {
      "index": 60,
      "text": "Get in! Get in!",
      "kind": "dialogue",
      "startMs": 1444860,
      "endMs": 1446772
    },
    {
      "index": 61,
      "text": "Get in! Come on!",
      "kind": "dialogue",
      "startMs": 1446862,
      "endMs": 1448569
    },
    {
      "index": 62,
      "text": "Move!",
      "kind": "dialogue",
      "startMs": 1483357,
      "endMs": 1484393
    },
    {
      "index": 63,
      "text": "Retreat!",
      "kind": "dialogue",
      "startMs": 1514763,
      "endMs": 1517927
    },
    {
      "index": 64,
      "text": "Retreat!",
      "kind": "dialogue",
      "startMs": 1518350,
      "endMs": 1519886
    },
    {
      "index": 65,
      "text": "Come on! Come on!",
      "kind": "dialogue",
      "startMs": 1519977,
      "endMs": 1521468
    },
    {
      "index": 66,
      "text": "Come on! Come on!",
      "kind": "dialogue",
      "startMs": 1521562,
      "endMs": 1522973
    },
    {
      "index": 67,
      "text": "Protect the gate!",
      "kind": "dialogue",
      "startMs": 1525107,
      "endMs": 1526473
    },
    {
      "index": 68,
      "text": "Protect the gate!",
      "kind": "dialogue",
      "startMs": 1526567,
      "endMs": 1528559
    },
    {
      "index": 69,
      "text": "They're coming! Come on!",
      "kind": "dialogue",
      "startMs": 1528652,
      "endMs": 1531065
    },
    {
      "index": 70,
      "text": "Fall back!",
      "kind": "dialogue",
      "startMs": 1531155,
      "endMs": 1532771
    },
    {
      "index": 71,
      "text": "Light the trench!",
      "kind": "dialogue",
      "startMs": 1552926,
      "endMs": 1555885
    },
    {
      "index": 72,
      "text": "Wait! Light the trench!",
      "kind": "dialogue",
      "startMs": 1557389,
      "endMs": 1559149
    },
    {
      "index": 73,
      "text": "She can't see us.",
      "kind": "dialogue",
      "startMs": 1589004,
      "endMs": 1590245
    },
    {
      "index": 74,
      "text": "Light the trenches!",
      "kind": "dialogue",
      "startMs": 1591882,
      "endMs": 1592998
    },
    {
      "index": 75,
      "text": "With a torch, light the trenches!",
      "kind": "dialogue",
      "startMs": 1607564,
      "endMs": 1609726
    },
    {
      "index": 76,
      "text": "Right there. Torch it!",
      "kind": "dialogue",
      "startMs": 1609817,
      "endMs": 1612104
    },
    {
      "index": 77,
      "text": "Light the trenches!",
      "kind": "dialogue",
      "startMs": 1613779,
      "endMs": 1614779
    },
    {
      "index": 78,
      "text": "Clegane.",
      "kind": "dialogue",
      "startMs": 1779695,
      "endMs": 1780731
    },
    {
      "index": 79,
      "text": "You must try not to worry yourself.",
      "kind": "dialogue",
      "startMs": 1787035,
      "endMs": 1789618
    },
    {
      "index": 80,
      "text": "At least we're already in a crypt.",
      "kind": "dialogue",
      "startMs": 1802801,
      "endMs": 1805088
    },
    {
      "index": 81,
      "text": "If we were up there, we might see something everyone else is missing.",
      "kind": "dialogue",
      "startMs": 1809766,
      "endMs": 1815019
    },
    {
      "index": 82,
      "text": "Something that makes a difference.",
      "kind": "dialogue",
      "startMs": 1817107,
      "endMs": 1818459
    },
    {
      "index": 83,
      "text": "What?",
      "kind": "dialogue",
      "startMs": 1820402,
      "endMs": 1821438
    },
    {
      "index": 84,
      "text": "Remember the Battle of Blackwater? I brought us through the Mud Gate.",
      "kind": "dialogue",
      "startMs": 1821987,
      "endMs": 1824507
    },
    {
      "index": 85,
      "text": "And got your face cut in half. And it made a difference.",
      "kind": "dialogue",
      "startMs": 1824531,
      "endMs": 1827615
    },
    {
      "index": 86,
      "text": "If I was out there right now...",
      "kind": "dialogue",
      "startMs": 1830203,
      "endMs": 1831569
    },
    {
      "index": 87,
      "text": "You'd die.",
      "kind": "dialogue",
      "startMs": 1831705,
      "endMs": 1832741
    },
    {
      "index": 88,
      "text": "There's nothing you can do.",
      "kind": "dialogue",
      "startMs": 1835083,
      "endMs": 1836915
    },
    {
      "index": 89,
      "text": "You might be surprised at the lengths I'd go to avoid joining the Army of the Dead.",
      "kind": "dialogue",
      "startMs": 1841173,
      "endMs": 1846042
    },
    {
      "index": 90,
      "text": "I could think of no organization less suited to my talents.",
      "kind": "dialogue",
      "startMs": 1846136,
      "endMs": 1849174
    },
    {
      "index": 91,
      "text": "Witty remarks won't make a difference.",
      "kind": "dialogue",
      "startMs": 1849306,
      "endMs": 1850968
    },
    {
      "index": 92,
      "text": "That's why we're down here, none of us can do anything.",
      "kind": "dialogue",
      "startMs": 1854186,
      "endMs": 1856428
    },
    {
      "index": 93,
      "text": "It's the truth.",
      "kind": "dialogue",
      "startMs": 1858940,
      "endMs": 1860056
    },
    {
      "index": 94,
      "text": "It's the most heroic thing we can do now...",
      "kind": "dialogue",
      "startMs": 1861360,
      "endMs": 1863647
    },
    {
      "index": 95,
      "text": "look the truth in the face.",
      "kind": "dialogue",
      "startMs": 1865614,
      "endMs": 1867150
    },
    {
      "index": 96,
      "text": "Maybe we should have stayed married.",
      "kind": "dialogue",
      "startMs": 1872579,
      "endMs": 1874366
    },
    {
      "index": 97,
      "text": "You were the best of them.",
      "kind": "dialogue",
      "startMs": 1874998,
      "endMs": 1876739
    },
    {
      "index": 98,
      "text": "What a terrifying thought.",
      "kind": "dialogue",
      "startMs": 1878043,
      "endMs": 1880160
    },
    {
      "index": 99,
      "text": "It wouldn't work between us.",
      "kind": "dialogue",
      "startMs": 1887260,
      "endMs": 1888592
    },
    {
      "index": 100,
      "text": "Why not?",
      "kind": "dialogue",
      "startMs": 1889888,
      "endMs": 1891049
    },
    {
      "index": 101,
      "text": "The Dragon Queen.",
      "kind": "dialogue",
      "startMs": 1891807,
      "endMs": 1893048
    },
    {
      "index": 102,
      "text": "Your divided loyalties would become a problem.",
      "kind": "dialogue",
      "startMs": 1895227,
      "endMs": 1898220
    },
    {
      "index": 103,
      "text": "Yes.",
      "kind": "dialogue",
      "startMs": 1898980,
      "endMs": 1900061
    },
    {
      "index": 104,
      "text": "Without the Dragon Queen, there'd be no problem at all.",
      "kind": "dialogue",
      "startMs": 1901483,
      "endMs": 1904100
    },
    {
      "index": 105,
      "text": "We'd all be dead already.",
      "kind": "dialogue",
      "startMs": 1905320,
      "endMs": 1906811
    },
    {
      "index": 106,
      "text": "They lit the trench.",
      "kind": "dialogue",
      "startMs": 1929052,
      "endMs": 1930338
    },
    {
      "index": 107,
      "text": "Bran...",
      "kind": "dialogue",
      "startMs": 1944109,
      "endMs": 1945145
    },
    {
      "index": 108,
      "text": "I just want you to know...",
      "kind": "dialogue",
      "startMs": 1950657,
      "endMs": 1952569
    },
    {
      "index": 109,
      "text": "I wish...",
      "kind": "dialogue",
      "startMs": 1956580,
      "endMs": 1957616
    },
    {
      "index": 110,
      "text": "The things I did...",
      "kind": "dialogue",
      "startMs": 1959207,
      "endMs": 1960414
    },
    {
      "index": 111,
      "text": "Everything you did brought you where you are now.",
      "kind": "dialogue",
      "startMs": 1960500,
      "endMs": 1963288
    },
    {
      "index": 112,
      "text": "Where you belong.",
      "kind": "dialogue",
      "startMs": 1965547,
      "endMs": 1966754
    },
    {
      "index": 113,
      "text": "Home.",
      "kind": "dialogue",
      "startMs": 1969009,
      "endMs": 1970045
    },
    {
      "index": 114,
      "text": "I'm going to go now.",
      "kind": "dialogue",
      "startMs": 1981021,
      "endMs": 1982557
    },
    {
      "index": 115,
      "text": "Go where?",
      "kind": "dialogue",
      "startMs": 1985692,
      "endMs": 1986728
    },
    {
      "index": 116,
      "text": "Man the walls!",
      "kind": "dialogue",
      "startMs": 2095510,
      "endMs": 2096842
    },
    {
      "index": 117,
      "text": "Man the walls!",
      "kind": "dialogue",
      "startMs": 2097762,
      "endMs": 2099674
    },
    {
      "index": 118,
      "text": "Man the wall!",
      "kind": "dialogue",
      "startMs": 2107731,
      "endMs": 2109142
    },
    {
      "index": 119,
      "text": "Man the walls!",
      "kind": "dialogue",
      "startMs": 2109983,
      "endMs": 2111565
    },
    {
      "index": 120,
      "text": "Come on!",
      "kind": "dialogue",
      "startMs": 2113403,
      "endMs": 2114519
    },
    {
      "index": 121,
      "text": "Get out there! Get moving!",
      "kind": "dialogue",
      "startMs": 2115238,
      "endMs": 2117355
    },
    {
      "index": 122,
      "text": "Come on. Come on! Come on!",
      "kind": "dialogue",
      "startMs": 2118116,
      "endMs": 2120233
    },
    {
      "index": 123,
      "text": "Go, go, go!",
      "kind": "dialogue",
      "startMs": 2123580,
      "endMs": 2125321
    },
    {
      "index": 124,
      "text": "Come on!",
      "kind": "dialogue",
      "startMs": 2125999,
      "endMs": 2127035
    },
    {
      "index": 125,
      "text": "They're against the wall!",
      "kind": "dialogue",
      "startMs": 2167207,
      "endMs": 2169199
    },
    {
      "index": 126,
      "text": "Get more men up here!",
      "kind": "dialogue",
      "startMs": 2173588,
      "endMs": 2175329
    },
    {
      "index": 127,
      "text": "Fill the gaps, quickly! Get in there!",
      "kind": "dialogue",
      "startMs": 2179260,
      "endMs": 2181718
    },
    {
      "index": 128,
      "text": "They're climbing the walls!",
      "kind": "dialogue",
      "startMs": 2181805,
      "endMs": 2183115
    },
    {
      "index": 129,
      "text": "Relieve the archers! Relieve the archers!",
      "kind": "dialogue",
      "startMs": 2183139,
      "endMs": 2185722
    },
    {
      "index": 130,
      "text": "Archers on top!",
      "kind": "dialogue",
      "startMs": 2187727,
      "endMs": 2189184
    },
    {
      "index": 131,
      "text": "Move up! Go, go! Come here!",
      "kind": "dialogue",
      "startMs": 2189270,
      "endMs": 2191933
    },
    {
      "index": 132,
      "text": "Come on! Move back!",
      "kind": "dialogue",
      "startMs": 2192023,
      "endMs": 2193639
    },
    {
      "index": 133,
      "text": "Stand away! Go on, go on. Go! Go.",
      "kind": "dialogue",
      "startMs": 2193733,
      "endMs": 2195461
    },
    {
      "index": 134,
      "text": "Step back. All the way, archers!",
      "kind": "dialogue",
      "startMs": 2195485,
      "endMs": 2197818
    },
    {
      "index": 135,
      "text": "Hold the wall!",
      "kind": "dialogue",
      "startMs": 2214087,
      "endMs": 2215203
    },
    {
      "index": 136,
      "text": "The wall, they're coming up!",
      "kind": "dialogue",
      "startMs": 2215296,
      "endMs": 2216732
    },
    {
      "index": 137,
      "text": "Hold the wall! Hold the wall!",
      "kind": "dialogue",
      "startMs": 2216756,
      "endMs": 2219999
    },
    {
      "index": 138,
      "text": "Draw!",
      "kind": "dialogue",
      "startMs": 2220093,
      "endMs": 2221254
    },
    {
      "index": 139,
      "text": "Come on!",
      "kind": "dialogue",
      "startMs": 2245493,
      "endMs": 2247109
    },
    {
      "index": 140,
      "text": "They're coming up!",
      "kind": "dialogue",
      "startMs": 2298087,
      "endMs": 2299578
    },
    {
      "index": 141,
      "text": "Look out!",
      "kind": "dialogue",
      "startMs": 2311518,
      "endMs": 2312725
    },
    {
      "index": 142,
      "text": "Clegane!",
      "kind": "dialogue",
      "startMs": 2411659,
      "endMs": 2412991
    },
    {
      "index": 143,
      "text": "Clegane!",
      "kind": "dialogue",
      "startMs": 2414287,
      "endMs": 2415368
    },
    {
      "index": 144,
      "text": "Clegane!",
      "kind": "dialogue",
      "startMs": 2485900,
      "endMs": 2487812
    },
    {
      "index": 145,
      "text": "Clegane, we need you!",
      "kind": "dialogue",
      "startMs": 2487902,
      "endMs": 2489609
    },
    {
      "index": 146,
      "text": "You can't give up on us.",
      "kind": "dialogue",
      "startMs": 2490279,
      "endMs": 2491645
    },
    {
      "index": 147,
      "text": "Fuck off! We can't beat them.",
      "kind": "dialogue",
      "startMs": 2491739,
      "endMs": 2493901
    },
    {
      "index": 148,
      "text": "Don't you see that, you stupid whore?",
      "kind": "dialogue",
      "startMs": 2493992,
      "endMs": 2496279
    },
    {
      "index": 149,
      "text": "We're fighting Death!",
      "kind": "dialogue",
      "startMs": 2496369,
      "endMs": 2498110
    },
    {
      "index": 150,
      "text": "They can't beat Death.",
      "kind": "dialogue",
      "startMs": 2498204,
      "endMs": 2499536
    },
    {
      "index": 151,
      "text": "Tell her that.",
      "kind": "dialogue",
      "startMs": 2504460,
      "endMs": 2505746
    },
    {
      "index": 152,
      "text": "Ahhh!",
      "kind": "dialogue",
      "startMs": 2540747,
      "endMs": 2541988
    },
    {
      "index": 153,
      "text": "Open the door!",
      "kind": "dialogue",
      "startMs": 2960332,
      "endMs": 2961539
    },
    {
      "index": 154,
      "text": "Open the door!",
      "kind": "dialogue",
      "startMs": 2964587,
      "endMs": 2965703
    },
    {
      "index": 155,
      "text": "Come on! Open the door!",
      "kind": "dialogue",
      "startMs": 2965796,
      "endMs": 2967232
    },
    {
      "index": 156,
      "text": "Open the door!",
      "kind": "dialogue",
      "startMs": 2967256,
      "endMs": 2968838
    },
    {
      "index": 157,
      "text": "Please!",
      "kind": "dialogue",
      "startMs": 2973596,
      "endMs": 2974632
    },
    {
      "index": 158,
      "text": "Open it!",
      "kind": "dialogue",
      "startMs": 2975473,
      "endMs": 2976884
    },
    {
      "index": 159,
      "text": "Come on! Go!",
      "kind": "dialogue",
      "startMs": 3071610,
      "endMs": 3073818
    },
    {
      "index": 160,
      "text": "Come on! Run!",
      "kind": "dialogue",
      "startMs": 3074572,
      "endMs": 3077064
    },
    {
      "index": 161,
      "text": "We've gotta go!",
      "kind": "dialogue",
      "startMs": 3103225,
      "endMs": 3104511
    },
    {
      "index": 162,
      "text": "The Lord brought him back for a purpose.",
      "kind": "dialogue",
      "startMs": 3166330,
      "endMs": 3168492
    },
    {
      "index": 163,
      "text": "Now that purpose has been served.",
      "kind": "dialogue",
      "startMs": 3173462,
      "endMs": 3175670
    },
    {
      "index": 164,
      "text": "I know you.",
      "kind": "dialogue",
      "startMs": 3181053,
      "endMs": 3182089
    },
    {
      "index": 165,
      "text": "And I know you.",
      "kind": "dialogue",
      "startMs": 3187768,
      "endMs": 3188804
    },
    {
      "index": 166,
      "text": "You said we'd meet again.",
      "kind": "dialogue",
      "startMs": 3196777,
      "endMs": 3198313
    },
    {
      "index": 167,
      "text": "And here we are.",
      "kind": "dialogue",
      "startMs": 3199113,
      "endMs": 3200354
    },
    {
      "index": 168,
      "text": "At the end of the world.",
      "kind": "dialogue",
      "startMs": 3201365,
      "endMs": 3202651
    },
    {
      "index": 169,
      "text": "You said I'd shut many eyes forever.",
      "kind": "dialogue",
      "startMs": 3204910,
      "endMs": 3206742
    },
    {
      "index": 170,
      "text": "You were right about that too.",
      "kind": "dialogue",
      "startMs": 3208455,
      "endMs": 3209991
    },
    {
      "index": 171,
      "text": "Brown eyes... green eyes...",
      "kind": "dialogue",
      "startMs": 3211125,
      "endMs": 3214292
    },
    {
      "index": 172,
      "text": "and blue eyes.",
      "kind": "dialogue",
      "startMs": 3216505,
      "endMs": 3217871
    },
    {
      "index": 173,
      "text": "What do we say to the God of Death?",
      "kind": "dialogue",
      "startMs": 3237234,
      "endMs": 3239977
    },
    {
      "index": 174,
      "text": "Not today.",
      "kind": "dialogue",
      "startMs": 3244199,
      "endMs": 3245315
    },
    {
      "index": 175,
      "text": "Here they come!",
      "kind": "dialogue",
      "startMs": 3270809,
      "endMs": 3271845
    },
    {
      "index": 176,
      "text": "Steady, lads.",
      "kind": "dialogue",
      "startMs": 3275689,
      "endMs": 3276770
    },
    {
      "index": 177,
      "text": "Steady now.",
      "kind": "dialogue",
      "startMs": 3277941,
      "endMs": 3279102
    },
    {
      "index": 178,
      "text": "Make every shot count.",
      "kind": "dialogue",
      "startMs": 3281987,
      "endMs": 3283319
    },
    {
      "index": 179,
      "text": "Over there!",
      "kind": "dialogue",
      "startMs": 3292831,
      "endMs": 3293867
    },
    {
      "index": 180,
      "text": "There!",
      "kind": "dialogue",
      "startMs": 3297127,
      "endMs": 3298163
    },
    {
      "index": 181,
      "text": "Get off.",
      "kind": "dialogue",
      "startMs": 3338752,
      "endMs": 3339913
    },
    {
      "index": 182,
      "text": "Dracarys.",
      "kind": "dialogue",
      "startMs": 3437059,
      "endMs": 3438095
    },
    {
      "index": 183,
      "text": "Come on! Come on!",
      "kind": "dialogue",
      "startMs": 3722093,
      "endMs": 3723675
    },
    {
      "index": 184,
      "text": "No! No, no, no!",
      "kind": "dialogue",
      "startMs": 3725805,
      "endMs": 3728047
    },
    {
      "index": 185,
      "text": "Bran! Go!",
      "kind": "dialogue",
      "startMs": 3777983,
      "endMs": 3780350
    },
    {
      "index": 186,
      "text": "Jorah!",
      "kind": "dialogue",
      "startMs": 4098261,
      "endMs": 4099468
    },
    {
      "index": 187,
      "text": "Theon.",
      "kind": "dialogue",
      "startMs": 4265052,
      "endMs": 4266133
    },
    {
      "index": 188,
      "text": "You're a good man.",
      "kind": "dialogue",
      "startMs": 4277899,
      "endMs": 4279356
    },
    {
      "index": 189,
      "text": "Thank you.",
      "kind": "dialogue",
      "startMs": 4285406,
      "endMs": 4286442
    },
    {
      "index": 190,
      "text": "I'm hurt.",
      "kind": "dialogue",
      "startMs": 4610272,
      "endMs": 4611854
    }
  ],
  "meta": {
    "show": "Game of Thrones",
    "season": 8,
    "episode": 3
  }
}
