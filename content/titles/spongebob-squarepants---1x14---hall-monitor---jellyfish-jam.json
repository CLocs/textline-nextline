{
  "id": "spongebob-squarepants---1x14---hall-monitor---jellyfish-jam",
  "title": "SpongeBob SquarePants - 1x14 - Hall Monitor - Jellyfish Jam",
  "sourceFilename": "SpongeBob SquarePants - 1x14 - Hall Monitor - Jellyfish Jam.en.srt",
  "importedAt": "2026-09-25T22:16:34.737Z",
  "lineCount": 296,
  "lines": [
    {
      "index": 0,
      "text": "SUB BY : DENI AUROR@ https://aurorarental.blogspot.com/ Are you ready, kids?",
      "kind": "dialogue",
      "startMs": 10,
      "endMs": 9211
    },
    {
      "index": 1,
      "text": "Aye, aye, Captain!",
      "kind": "dialogue",
      "startMs": 9278,
      "endMs": 11046
    },
    {
      "index": 2,
      "text": "I can't hear you.",
      "kind": "dialogue",
      "startMs": 11113,
      "endMs": 12614
    },
    {
      "index": 3,
      "text": "Aye, aye, Captain!",
      "kind": "dialogue",
      "startMs": 12681,
      "endMs": 14316
    },
    {
      "index": 4,
      "text": "* oh... * * who lives in a pineapple under the sea? * * Spongebob Squarepants! * * absorbent and yellow and porous is he. * * Spongebob Squarepants! * * if nautical nonsense be something you wish... * * Spongebob square pants! * * then drop on the deck and flop like a fish. * * Spongebob Squarepants! * * ready? Spongebob Squarepants! * * Spongebob Squarepants! * * Spongebob Squarepants! * * Spongebob Squarepants! *",
      "kind": "dialogue",
      "startMs": 14383,
      "endMs": 41977
    },
    {
      "index": 5,
      "text": "Mrs. Puff's boating school Where diligent students learn the rules of the road.",
      "kind": "dialogue",
      "startMs": 62697,
      "endMs": 69238
    },
    {
      "index": 6,
      "text": "Everyone Put down your books Because it's time to pick out the hall monitor of the day!",
      "kind": "dialogue",
      "startMs": 69304,
      "endMs": 76711
    },
    {
      "index": 7,
      "text": "Let's see here.",
      "kind": "dialogue",
      "startMs": 77913,
      "endMs": 79381
    },
    {
      "index": 8,
      "text": "This week's hall monitor will be...",
      "kind": "dialogue",
      "startMs": 79448,
      "endMs": 81450
    },
    {
      "index": 9,
      "text": "Bart, jimmy, no, no Tina, ralph, hmm...",
      "kind": "dialogue",
      "startMs": 81516,
      "endMs": 86621
    },
    {
      "index": 10,
      "text": "Spongebob.",
      "kind": "dialogue",
      "startMs": 86688,
      "endMs": 89658
    },
    {
      "index": 11,
      "text": "It's jimmy.",
      "kind": "dialogue",
      "startMs": 91160,
      "endMs": 92427
    },
    {
      "index": 12,
      "text": "Jimmy's the hall monitor.",
      "kind": "dialogue",
      "startMs": 92494,
      "endMs": 94429
    },
    {
      "index": 13,
      "text": "Mrs. Puff, i've done it already.",
      "kind": "dialogue",
      "startMs": 94496,
      "endMs": 96565
    },
    {
      "index": 14,
      "text": "Oh-- Phil?",
      "kind": "dialogue",
      "startMs": 97399,
      "endMs": 99334
    },
    {
      "index": 15,
      "text": "No way, Mrs. Puff.",
      "kind": "dialogue",
      "startMs": 99401,
      "endMs": 101103
    },
    {
      "index": 16,
      "text": "Uh, tina-- You're the hall monitor.",
      "kind": "dialogue",
      "startMs": 101170,
      "endMs": 103672
    },
    {
      "index": 17,
      "text": "Hey, i've done it three times already.",
      "kind": "dialogue",
      "startMs": 103738,
      "endMs": 105941
    },
    {
      "index": 18,
      "text": "B-Beth...",
      "kind": "dialogue",
      "startMs": 107776,
      "endMs": 108710
    },
    {
      "index": 19,
      "text": "She graduated.",
      "kind": "dialogue",
      "startMs": 108777,
      "endMs": 109912
    },
    {
      "index": 20,
      "text": "Henry!",
      "kind": "dialogue",
      "startMs": 109979,
      "endMs": 110913
    },
    {
      "index": 21,
      "text": "Vera!",
      "kind": "dialogue",
      "startMs": 110980,
      "endMs": 112247
    },
    {
      "index": 22,
      "text": "Clayton!",
      "kind": "dialogue",
      "startMs": 112314,
      "endMs": 113448
    },
    {
      "index": 23,
      "text": "All right, i guess i have no choice.",
      "kind": "dialogue",
      "startMs": 117786,
      "endMs": 120422
    },
    {
      "index": 24,
      "text": "The hall monitor of the day is...",
      "kind": "dialogue",
      "startMs": 121891,
      "endMs": 124927
    },
    {
      "index": 25,
      "text": "Oh... Spongebob.",
      "kind": "dialogue",
      "startMs": 124994,
      "endMs": 128030
    },
    {
      "index": 26,
      "text": "Ya...hoo!",
      "kind": "dialogue",
      "startMs": 128663,
      "endMs": 131000
    },
    {
      "index": 27,
      "text": "Hall monitor Spongebob Reporting for duty, ma'am.",
      "kind": "dialogue",
      "startMs": 131066,
      "endMs": 134236
    },
    {
      "index": 28,
      "text": "I'm ready to assume my position In the hall.",
      "kind": "dialogue",
      "startMs": 134303,
      "endMs": 137706
    },
    {
      "index": 29,
      "text": "I will protect all that are weak... in the hall.",
      "kind": "dialogue",
      "startMs": 137772,
      "endMs": 140309
    },
    {
      "index": 30,
      "text": "All rules will be enforced... in the hall.",
      "kind": "dialogue",
      "startMs": 140375,
      "endMs": 142711
    },
    {
      "index": 31,
      "text": "Okay!",
      "kind": "dialogue",
      "startMs": 142777,
      "endMs": 143913
    },
    {
      "index": 32,
      "text": "Just take the hat and belt.",
      "kind": "dialogue",
      "startMs": 143946,
      "endMs": 145680
    },
    {
      "index": 33,
      "text": "I can't accept that yet, ma'am.",
      "kind": "dialogue",
      "startMs": 145747,
      "endMs": 147983
    },
    {
      "index": 34,
      "text": "I have to make my speech.",
      "kind": "dialogue",
      "startMs": 148050,
      "endMs": 149518
    },
    {
      "index": 35,
      "text": "You can't make this easy, can you?",
      "kind": "dialogue",
      "startMs": 149584,
      "endMs": 151686
    },
    {
      "index": 36,
      "text": "Classmates!",
      "kind": "dialogue",
      "startMs": 151753,
      "endMs": 153923
    },
    {
      "index": 37,
      "text": "Who am i to deserve such a great honor?",
      "kind": "dialogue",
      "startMs": 153956,
      "endMs": 157192
    },
    {
      "index": 38,
      "text": "Why, i would be nothing Without Mrs. Puff.",
      "kind": "dialogue",
      "startMs": 157259,
      "endMs": 161596
    },
    {
      "index": 39,
      "text": "Give me a break.",
      "kind": "dialogue",
      "startMs": 161663,
      "endMs": 163232
    },
    {
      "index": 40,
      "text": "And to my public All i can say is i'm touched.",
      "kind": "dialogue",
      "startMs": 163298,
      "endMs": 168837
    },
    {
      "index": 41,
      "text": "And furthermore I will carry out my duties...",
      "kind": "dialogue",
      "startMs": 168938,
      "endMs": 171640
    },
    {
      "index": 42,
      "text": "Crime and punishment, punishment and crime In the hall.",
      "kind": "dialogue",
      "startMs": 171706,
      "endMs": 177612
    },
    {
      "index": 43,
      "text": "Which reminds me of an extremely long speech Written by the greatest hall monitor Of all time.",
      "kind": "dialogue",
      "startMs": 177679,
      "endMs": 183452
    },
    {
      "index": 44,
      "text": "\"Friends, students, juvenile delinquents Lend me your ears.\"",
      "kind": "dialogue",
      "startMs": 183518,
      "endMs": 187389
    },
    {
      "index": 45,
      "text": "In conclusion and without a moment to spare I will put on this uniform and assume my duties as...",
      "kind": "dialogue",
      "startMs": 189291,
      "endMs": 196798
    },
    {
      "index": 46,
      "text": "Hall monitor!",
      "kind": "dialogue",
      "startMs": 197532,
      "endMs": 199801
    },
    {
      "index": 47,
      "text": "Wish me luck, Mrs. Puff.",
      "kind": "dialogue",
      "startMs": 201236,
      "endMs": 203072
    },
    {
      "index": 48,
      "text": "Oh, and i will be...",
      "kind": "dialogue",
      "startMs": 203138,
      "endMs": 205107
    },
    {
      "index": 49,
      "text": "Spongebob, are you okay?",
      "kind": "dialogue",
      "startMs": 208010,
      "endMs": 210579
    },
    {
      "index": 50,
      "text": "I overdid the speech again, didn't i?",
      "kind": "dialogue",
      "startMs": 210645,
      "endMs": 212881
    },
    {
      "index": 51,
      "text": "I'm afraid so.",
      "kind": "dialogue",
      "startMs": 212982,
      "endMs": 214316
    },
    {
      "index": 52,
      "text": "Aw, tartar sauce!",
      "kind": "dialogue",
      "startMs": 214383,
      "endMs": 216418
    },
    {
      "index": 53,
      "text": "I guess i won't be needing this.",
      "kind": "dialogue",
      "startMs": 216485,
      "endMs": 219288
    },
    {
      "index": 54,
      "text": "I hardly knew ye.",
      "kind": "dialogue",
      "startMs": 219354,
      "endMs": 221390
    },
    {
      "index": 55,
      "text": "Uh... Spongebob?",
      "kind": "dialogue",
      "startMs": 226195,
      "endMs": 228630
    },
    {
      "index": 56,
      "text": "Yes, Mrs. Puff?",
      "kind": "dialogue",
      "startMs": 228697,
      "endMs": 230599
    },
    {
      "index": 57,
      "text": "I can at least let you wear it until tomorrow.",
      "kind": "dialogue",
      "startMs": 230665,
      "endMs": 234769
    },
    {
      "index": 58,
      "text": "Yahoo!",
      "kind": "dialogue",
      "startMs": 234836,
      "endMs": 235804
    },
    {
      "index": 59,
      "text": "Thanks, Mrs. Puff.",
      "kind": "dialogue",
      "startMs": 235870,
      "endMs": 238407
    },
    {
      "index": 60,
      "text": "What are the consequences of what i've just done?",
      "kind": "dialogue",
      "startMs": 238473,
      "endMs": 242611
    },
    {
      "index": 61,
      "text": "... hall ... monitor.",
      "kind": "dialogue",
      "startMs": 245114,
      "endMs": 248717
    },
    {
      "index": 62,
      "text": "Broken traffic light.",
      "kind": "dialogue",
      "startMs": 251286,
      "endMs": 252587
    },
    {
      "index": 63,
      "text": "Who's to say my monitor duties should end Just because the bell rang?",
      "kind": "dialogue",
      "startMs": 252654,
      "endMs": 256691
    },
    {
      "index": 64,
      "text": "I can be helpful anywhere.",
      "kind": "dialogue",
      "startMs": 256758,
      "endMs": 258493
    },
    {
      "index": 65,
      "text": "This looks like a job for the hall monitor!",
      "kind": "dialogue",
      "startMs": 258560,
      "endMs": 261396
    },
    {
      "index": 66,
      "text": "What would this town do without you, Spongebob?",
      "kind": "dialogue",
      "startMs": 293062,
      "endMs": 296465
    },
    {
      "index": 67,
      "text": "My legs!",
      "kind": "dialogue",
      "startMs": 296531,
      "endMs": 297466
    },
    {
      "index": 68,
      "text": "My legs!",
      "kind": "dialogue",
      "startMs": 297532,
      "endMs": 299968
    },
    {
      "index": 69,
      "text": "* on patrol * * i'm on patrol... * Uh-Oh, an open window.",
      "kind": "dialogue",
      "startMs": 300069,
      "endMs": 305174
    },
    {
      "index": 70,
      "text": "More seaweed medley, dear?",
      "kind": "dialogue",
      "startMs": 307076,
      "endMs": 309611
    },
    {
      "index": 71,
      "text": "The fools.",
      "kind": "dialogue",
      "startMs": 309678,
      "endMs": 310912
    },
    {
      "index": 72,
      "text": "They've left themselves susceptible to danger.",
      "kind": "dialogue",
      "startMs": 310979,
      "endMs": 313948
    },
    {
      "index": 73,
      "text": "I must show them the error of their ways Through example.",
      "kind": "dialogue",
      "startMs": 314083,
      "endMs": 318220
    },
    {
      "index": 74,
      "text": "I'm the open window maniac!",
      "kind": "dialogue",
      "startMs": 320889,
      "endMs": 324459
    },
    {
      "index": 75,
      "text": "I hope you learned a valuable lesson!",
      "kind": "dialogue",
      "startMs": 327129,
      "endMs": 330332
    },
    {
      "index": 76,
      "text": "* on patrol * * i'm on patrol * * i'm on patrol... * Vandals!",
      "kind": "dialogue",
      "startMs": 332734,
      "endMs": 338873
    },
    {
      "index": 77,
      "text": "Another crime.",
      "kind": "dialogue",
      "startMs": 338940,
      "endMs": 340109
    },
    {
      "index": 78,
      "text": "Hmm... strawberry.",
      "kind": "dialogue",
      "startMs": 344146,
      "endMs": 346248
    },
    {
      "index": 79,
      "text": "I must act.",
      "kind": "dialogue",
      "startMs": 346315,
      "endMs": 347582
    },
    {
      "index": 80,
      "text": "Patrick...",
      "kind": "dialogue",
      "startMs": 351253,
      "endMs": 352221
    },
    {
      "index": 81,
      "text": "Patrick!",
      "kind": "dialogue",
      "startMs": 352287,
      "endMs": 353288
    },
    {
      "index": 82,
      "text": "Patrick!",
      "kind": "dialogue",
      "startMs": 354889,
      "endMs": 355957
    },
    {
      "index": 83,
      "text": "My ice cream-- It's alive!",
      "kind": "dialogue",
      "startMs": 356024,
      "endMs": 357726
    },
    {
      "index": 84,
      "text": "Patrick, down here.",
      "kind": "dialogue",
      "startMs": 359594,
      "endMs": 361130
    },
    {
      "index": 85,
      "text": "Oh, Spongebob, it's you.",
      "kind": "dialogue",
      "startMs": 361163,
      "endMs": 363432
    },
    {
      "index": 86,
      "text": "Patrick, come down here.",
      "kind": "dialogue",
      "startMs": 363498,
      "endMs": 365600
    },
    {
      "index": 87,
      "text": "Spongebob...",
      "kind": "dialogue",
      "startMs": 367536,
      "endMs": 369037
    },
    {
      "index": 88,
      "text": "Spongebob!",
      "kind": "dialogue",
      "startMs": 369138,
      "endMs": 370472
    },
    {
      "index": 89,
      "text": "I'm down here.",
      "kind": "dialogue",
      "startMs": 370539,
      "endMs": 371606
    },
    {
      "index": 90,
      "text": "You look funny.",
      "kind": "dialogue",
      "startMs": 373342,
      "endMs": 375144
    },
    {
      "index": 91,
      "text": "Hi, Spongebob.",
      "kind": "dialogue",
      "startMs": 376178,
      "endMs": 377646
    },
    {
      "index": 92,
      "text": "That's \"hall monitor\" to you.",
      "kind": "dialogue",
      "startMs": 377712,
      "endMs": 380048
    },
    {
      "index": 93,
      "text": "Sorry, officer.",
      "kind": "dialogue",
      "startMs": 380149,
      "endMs": 381850
    },
    {
      "index": 94,
      "text": "Sorry's not good enough, Patrick.",
      "kind": "dialogue",
      "startMs": 381916,
      "endMs": 383652
    },
    {
      "index": 95,
      "text": "You've just committed a crime And i'm taking you in.",
      "kind": "dialogue",
      "startMs": 383718,
      "endMs": 386488
    },
    {
      "index": 96,
      "text": "What crime?",
      "kind": "dialogue",
      "startMs": 386555,
      "endMs": 387656
    },
    {
      "index": 97,
      "text": "I'm a bad person.",
      "kind": "dialogue",
      "startMs": 388890,
      "endMs": 391059
    },
    {
      "index": 98,
      "text": "Newspaper boy extra! Extra!",
      "kind": "dialogue",
      "startMs": 392627,
      "endMs": 394829
    },
    {
      "index": 99,
      "text": "Maniac strikes bikini bottom!",
      "kind": "dialogue",
      "startMs": 394896,
      "endMs": 396331
    },
    {
      "index": 100,
      "text": "City paralyzed with fear!",
      "kind": "dialogue",
      "startMs": 396398,
      "endMs": 398167
    },
    {
      "index": 101,
      "text": "Tell your friends.",
      "kind": "dialogue",
      "startMs": 398167,
      "endMs": 400068
    },
    {
      "index": 102,
      "text": "Arm yourselves with knowledge.",
      "kind": "dialogue",
      "startMs": 400169,
      "endMs": 402604
    },
    {
      "index": 103,
      "text": "Extra! Extra...",
      "kind": "dialogue",
      "startMs": 402671,
      "endMs": 404005
    },
    {
      "index": 104,
      "text": "Hmm... \"maniac... bikini bottom...",
      "kind": "dialogue",
      "startMs": 404072,
      "endMs": 407842
    },
    {
      "index": 105,
      "text": "Car wrecks... break-In.\"",
      "kind": "dialogue",
      "startMs": 407909,
      "endMs": 410078
    },
    {
      "index": 106,
      "text": "Who better to bring this maniac to justice Than me... the hall monitor!",
      "kind": "dialogue",
      "startMs": 410179,
      "endMs": 416418
    },
    {
      "index": 107,
      "text": "But i can't handle this case alone.",
      "kind": "dialogue",
      "startMs": 416485,
      "endMs": 418320
    },
    {
      "index": 108,
      "text": "Patrick, are you ready To give up your life of crime?",
      "kind": "dialogue",
      "startMs": 418387,
      "endMs": 422191
    },
    {
      "index": 109,
      "text": "I want to be good!",
      "kind": "dialogue",
      "startMs": 422191,
      "endMs": 424426
    },
    {
      "index": 110,
      "text": "Hmm... now you just need a symbol of authority.",
      "kind": "dialogue",
      "startMs": 424493,
      "endMs": 428630
    },
    {
      "index": 111,
      "text": "Perfect.",
      "kind": "dialogue",
      "startMs": 432201,
      "endMs": 433202
    },
    {
      "index": 112,
      "text": "It is our duty to catch this maniac And bring him to justice.",
      "kind": "dialogue",
      "startMs": 433235,
      "endMs": 436505
    },
    {
      "index": 113,
      "text": "But how to proceed?",
      "kind": "dialogue",
      "startMs": 436571,
      "endMs": 438440
    },
    {
      "index": 114,
      "text": "Listen, deputy, you're an ex-Criminal-- What would you do?",
      "kind": "dialogue",
      "startMs": 438507,
      "endMs": 442577
    },
    {
      "index": 115,
      "text": "Hmm...",
      "kind": "dialogue",
      "startMs": 442644,
      "endMs": 443578
    },
    {
      "index": 116,
      "text": "I'd get an ice cream.",
      "kind": "dialogue",
      "startMs": 443645,
      "endMs": 444946
    },
    {
      "index": 117,
      "text": "Okay, now what?",
      "kind": "dialogue",
      "startMs": 450051,
      "endMs": 451220
    },
    {
      "index": 118,
      "text": "Hmm...",
      "kind": "dialogue",
      "startMs": 451286,
      "endMs": 452287
    },
    {
      "index": 119,
      "text": "This isn't working.",
      "kind": "dialogue",
      "startMs": 455089,
      "endMs": 456225
    },
    {
      "index": 120,
      "text": "We've got to do something else.",
      "kind": "dialogue",
      "startMs": 456225,
      "endMs": 457959
    },
    {
      "index": 121,
      "text": "Something with... walkie-Talkies!",
      "kind": "dialogue",
      "startMs": 458026,
      "endMs": 459894
    },
    {
      "index": 122,
      "text": "And now duty calls.",
      "kind": "dialogue",
      "startMs": 461230,
      "endMs": 463097
    },
    {
      "index": 123,
      "text": "All right, deputy, i'll go that way You go some different way.",
      "kind": "dialogue",
      "startMs": 463232,
      "endMs": 466501
    },
    {
      "index": 124,
      "text": "Geronimo!",
      "kind": "dialogue",
      "startMs": 466568,
      "endMs": 467569
    },
    {
      "index": 125,
      "text": "Afternoon, son.",
      "kind": "dialogue",
      "startMs": 476044,
      "endMs": 477312
    },
    {
      "index": 126,
      "text": "Hello, brothers.",
      "kind": "dialogue",
      "startMs": 477379,
      "endMs": 478647
    },
    {
      "index": 127,
      "text": "Son, we're looking for the maniac.",
      "kind": "dialogue",
      "startMs": 482384,
      "endMs": 484519
    },
    {
      "index": 128,
      "text": "Have you seen this man?",
      "kind": "dialogue",
      "startMs": 484586,
      "endMs": 487856
    },
    {
      "index": 129,
      "text": "It's the maniac!",
      "kind": "dialogue",
      "startMs": 488990,
      "endMs": 490091
    },
    {
      "index": 130,
      "text": "Take him away, take him away.",
      "kind": "dialogue",
      "startMs": 490158,
      "endMs": 491993
    },
    {
      "index": 131,
      "text": "Calm down, son, it's just a drawing Not the real thing.",
      "kind": "dialogue",
      "startMs": 492060,
      "endMs": 495163
    },
    {
      "index": 132,
      "text": "Now we're going to show you This picture again and you'll tell us If you've seen this guy, understand?",
      "kind": "dialogue",
      "startMs": 495264,
      "endMs": 500935
    },
    {
      "index": 133,
      "text": "Yeah, uh-Huh.",
      "kind": "dialogue",
      "startMs": 501002,
      "endMs": 502437
    },
    {
      "index": 134,
      "text": "Okay.",
      "kind": "dialogue",
      "startMs": 502504,
      "endMs": 504273
    },
    {
      "index": 135,
      "text": "Horrible!",
      "kind": "dialogue",
      "startMs": 505340,
      "endMs": 506441
    },
    {
      "index": 136,
      "text": "Stay indoors, son.",
      "kind": "dialogue",
      "startMs": 519688,
      "endMs": 520789
    },
    {
      "index": 137,
      "text": "And take that cone off your head.",
      "kind": "dialogue",
      "startMs": 520855,
      "endMs": 524058
    },
    {
      "index": 138,
      "text": "Spongebob.",
      "kind": "dialogue",
      "startMs": 528897,
      "endMs": 531933
    },
    {
      "index": 139,
      "text": "Come in, Spongebob.",
      "kind": "dialogue",
      "startMs": 532000,
      "endMs": 533034
    },
    {
      "index": 140,
      "text": "Answer!",
      "kind": "dialogue",
      "startMs": 533101,
      "endMs": 534068
    },
    {
      "index": 141,
      "text": "Spongebob here, Patrick.",
      "kind": "dialogue",
      "startMs": 534135,
      "endMs": 535437
    },
    {
      "index": 142,
      "text": "Report.",
      "kind": "dialogue",
      "startMs": 535504,
      "endMs": 536771
    },
    {
      "index": 143,
      "text": "I don't want to be a policeman anymore.",
      "kind": "dialogue",
      "startMs": 536838,
      "endMs": 538907
    },
    {
      "index": 144,
      "text": "I'm scared.",
      "kind": "dialogue",
      "startMs": 538973,
      "endMs": 540174
    },
    {
      "index": 145,
      "text": "Get a hold of yourself, deputy.",
      "kind": "dialogue",
      "startMs": 540309,
      "endMs": 542010
    },
    {
      "index": 146,
      "text": "I want to go home!",
      "kind": "dialogue",
      "startMs": 545179,
      "endMs": 548417
    },
    {
      "index": 147,
      "text": "Poor rookie.",
      "kind": "dialogue",
      "startMs": 548483,
      "endMs": 549718
    },
    {
      "index": 148,
      "text": "All right, i'm on my way back.",
      "kind": "dialogue",
      "startMs": 549784,
      "endMs": 551486
    },
    {
      "index": 149,
      "text": "Hurry, Spongebob.",
      "kind": "dialogue",
      "startMs": 551553,
      "endMs": 553087
    },
    {
      "index": 150,
      "text": "I think it's getting...",
      "kind": "dialogue",
      "startMs": 553154,
      "endMs": 555089
    },
    {
      "index": 151,
      "text": "Dark.",
      "kind": "dialogue",
      "startMs": 555156,
      "endMs": 556425
    },
    {
      "index": 152,
      "text": "Just put on your siren, i'll be right there.",
      "kind": "dialogue",
      "startMs": 556491,
      "endMs": 558827
    },
    {
      "index": 153,
      "text": "Spongebob, i see him.",
      "kind": "dialogue",
      "startMs": 575243,
      "endMs": 577346
    },
    {
      "index": 154,
      "text": "Where is he, Patrick?",
      "kind": "dialogue",
      "startMs": 577412,
      "endMs": 579448
    },
    {
      "index": 155,
      "text": "At the intersection of conch and coral.",
      "kind": "dialogue",
      "startMs": 579514,
      "endMs": 582917
    },
    {
      "index": 156,
      "text": "That's where i am.",
      "kind": "dialogue",
      "startMs": 584786,
      "endMs": 586555
    },
    {
      "index": 157,
      "text": "He's right on top of me, but i can't see him.",
      "kind": "dialogue",
      "startMs": 586621,
      "endMs": 589123
    },
    {
      "index": 158,
      "text": "What's he doing?",
      "kind": "dialogue",
      "startMs": 589190,
      "endMs": 590191
    },
    {
      "index": 159,
      "text": "Uh... he's just standing there...",
      "kind": "dialogue",
      "startMs": 590258,
      "endMs": 593662
    },
    {
      "index": 160,
      "text": "Menacingly!",
      "kind": "dialogue",
      "startMs": 593728,
      "endMs": 595364
    },
    {
      "index": 161,
      "text": "Get out of there, Spongebob!",
      "kind": "dialogue",
      "startMs": 595364,
      "endMs": 597399
    },
    {
      "index": 162,
      "text": "Yaah!",
      "kind": "dialogue",
      "startMs": 597466,
      "endMs": 598967
    },
    {
      "index": 163,
      "text": "That's his maniac shriek.",
      "kind": "dialogue",
      "startMs": 599033,
      "endMs": 600869
    },
    {
      "index": 164,
      "text": "He's going to attack.",
      "kind": "dialogue",
      "startMs": 600935,
      "endMs": 602437
    },
    {
      "index": 165,
      "text": "He's acting all crazy.",
      "kind": "dialogue",
      "startMs": 604406,
      "endMs": 605907
    },
    {
      "index": 166,
      "text": "Run!",
      "kind": "dialogue",
      "startMs": 605974,
      "endMs": 607008
    },
    {
      "index": 167,
      "text": "Hide behind that building.",
      "kind": "dialogue",
      "startMs": 607075,
      "endMs": 608643
    },
    {
      "index": 168,
      "text": "No, he's behind that building.",
      "kind": "dialogue",
      "startMs": 608710,
      "endMs": 610345
    },
    {
      "index": 169,
      "text": "Quick, hide behind that street sign.",
      "kind": "dialogue",
      "startMs": 610412,
      "endMs": 612313
    },
    {
      "index": 170,
      "text": "No, wait!",
      "kind": "dialogue",
      "startMs": 612381,
      "endMs": 613582
    },
    {
      "index": 171,
      "text": "The maniac just went behind that sign.",
      "kind": "dialogue",
      "startMs": 613648,
      "endMs": 615617
    },
    {
      "index": 172,
      "text": "Quick, get under the street light.",
      "kind": "dialogue",
      "startMs": 615684,
      "endMs": 617452
    },
    {
      "index": 173,
      "text": "No! Wait!",
      "kind": "dialogue",
      "startMs": 617519,
      "endMs": 618453
    },
    {
      "index": 174,
      "text": "He's there, too!",
      "kind": "dialogue",
      "startMs": 618520,
      "endMs": 620422
    },
    {
      "index": 175,
      "text": "Run for your life!",
      "kind": "dialogue",
      "startMs": 620489,
      "endMs": 622424
    },
    {
      "index": 176,
      "text": "Say again, deputy?",
      "kind": "dialogue",
      "startMs": 629698,
      "endMs": 631600
    },
    {
      "index": 177,
      "text": "The maniac's in the mailbox.",
      "kind": "dialogue",
      "startMs": 631666,
      "endMs": 635269
    },
    {
      "index": 178,
      "text": "Huh-- This guy's not half-Bad-Looking for a maniac.",
      "kind": "dialogue",
      "startMs": 657726,
      "endMs": 660695
    },
    {
      "index": 179,
      "text": "Wait a minute, Patrick.",
      "kind": "dialogue",
      "startMs": 660762,
      "endMs": 662597
    },
    {
      "index": 180,
      "text": "I'm the maniac.",
      "kind": "dialogue",
      "startMs": 662664,
      "endMs": 664733
    },
    {
      "index": 181,
      "text": "We'll take that as a confession.",
      "kind": "dialogue",
      "startMs": 669738,
      "endMs": 671973
    },
    {
      "index": 182,
      "text": "Spongebob Squarepants, there you are!",
      "kind": "dialogue",
      "startMs": 672040,
      "endMs": 675209
    },
    {
      "index": 183,
      "text": "I turn my back on you for one minute And you destroy half the city!",
      "kind": "dialogue",
      "startMs": 675276,
      "endMs": 679714
    },
    {
      "index": 184,
      "text": "You should be ashamed of yourself.",
      "kind": "dialogue",
      "startMs": 679781,
      "endMs": 681750
    },
    {
      "index": 185,
      "text": "You know this guy?",
      "kind": "dialogue",
      "startMs": 681816,
      "endMs": 683117
    },
    {
      "index": 186,
      "text": "Of course i do.",
      "kind": "dialogue",
      "startMs": 683184,
      "endMs": 684686
    },
    {
      "index": 187,
      "text": "I'm the one who gave him the uniform in the first place.",
      "kind": "dialogue",
      "startMs": 684753,
      "endMs": 687789
    },
    {
      "index": 188,
      "text": "He's my responsibility.",
      "kind": "dialogue",
      "startMs": 687856,
      "endMs": 691192
    },
    {
      "index": 189,
      "text": "Uh-Oh.",
      "kind": "dialogue",
      "startMs": 691259,
      "endMs": 693294
    },
    {
      "index": 190,
      "text": "And in conclusion, students Red means stop, green means go.",
      "kind": "dialogue",
      "startMs": 695464,
      "endMs": 702937
    },
    {
      "index": 191,
      "text": "And Spongebob...",
      "kind": "dialogue",
      "startMs": 703004,
      "endMs": 705206
    },
    {
      "index": 192,
      "text": "Yes, Mrs. Puff?",
      "kind": "dialogue",
      "startMs": 705273,
      "endMs": 706708
    },
    {
      "index": 193,
      "text": "I'd like to see you after class Six months from now.",
      "kind": "dialogue",
      "startMs": 706775,
      "endMs": 712481
    },
    {
      "index": 194,
      "text": "Ah, jellyfish fields.",
      "kind": "dialogue",
      "startMs": 725259,
      "endMs": 728863
    },
    {
      "index": 195,
      "text": "Here we find Spongebob once again Stalking the wild jellyfish.",
      "kind": "dialogue",
      "startMs": 728930,
      "endMs": 734969
    },
    {
      "index": 196,
      "text": "Spongebob?",
      "kind": "dialogue",
      "startMs": 735036,
      "endMs": 736505
    },
    {
      "index": 197,
      "text": "Hello? Spongebob?",
      "kind": "dialogue",
      "startMs": 736538,
      "endMs": 738406
    },
    {
      "index": 198,
      "text": "Hmm-- He's supposed to be here somewhere.",
      "kind": "dialogue",
      "startMs": 738507,
      "endMs": 740742
    },
    {
      "index": 199,
      "text": "Aha!",
      "kind": "dialogue",
      "startMs": 740809,
      "endMs": 741910
    },
    {
      "index": 200,
      "text": "Safety first.",
      "kind": "dialogue",
      "startMs": 745313,
      "endMs": 746515
    },
    {
      "index": 201,
      "text": "Aha!",
      "kind": "dialogue",
      "startMs": 752420,
      "endMs": 753522
    },
    {
      "index": 202,
      "text": "I finally got you.",
      "kind": "dialogue",
      "startMs": 753588,
      "endMs": 754789
    },
    {
      "index": 203,
      "text": "Ah, there is nothing better than the taste Of natural jelly from a jellyfish.",
      "kind": "dialogue",
      "startMs": 769538,
      "endMs": 775944
    },
    {
      "index": 204,
      "text": "See you later!",
      "kind": "dialogue",
      "startMs": 777111,
      "endMs": 778547
    },
    {
      "index": 205,
      "text": "Oh... oh, my glasses.",
      "kind": "dialogue",
      "startMs": 780248,
      "endMs": 782817
    },
    {
      "index": 206,
      "text": "Thanks, little guy.",
      "kind": "dialogue",
      "startMs": 782884,
      "endMs": 783918
    },
    {
      "index": 207,
      "text": "Bye.",
      "kind": "dialogue",
      "startMs": 783985,
      "endMs": 785053
    },
    {
      "index": 208,
      "text": "I can't play anymore, jellyfish.",
      "kind": "dialogue",
      "startMs": 788557,
      "endMs": 791159
    },
    {
      "index": 209,
      "text": "I got to get home.",
      "kind": "dialogue",
      "startMs": 791225,
      "endMs": 792727
    },
    {
      "index": 210,
      "text": "No, you can't come home with me.",
      "kind": "dialogue",
      "startMs": 792794,
      "endMs": 794929
    },
    {
      "index": 211,
      "text": "Jellyfish, you've got to stay here.",
      "kind": "dialogue",
      "startMs": 801435,
      "endMs": 803304
    },
    {
      "index": 212,
      "text": "Hey!",
      "kind": "dialogue",
      "startMs": 804372,
      "endMs": 805373
    },
    {
      "index": 213,
      "text": "Stay!",
      "kind": "dialogue",
      "startMs": 806908,
      "endMs": 807909
    },
    {
      "index": 214,
      "text": "Stay...",
      "kind": "dialogue",
      "startMs": 809310,
      "endMs": 810645
    },
    {
      "index": 215,
      "text": "Jellyfish, for the last time, you cannot come home with me!",
      "kind": "dialogue",
      "startMs": 823725,
      "endMs": 827295
    },
    {
      "index": 216,
      "text": "Aw, what the heck.",
      "kind": "dialogue",
      "startMs": 829230,
      "endMs": 830965
    },
    {
      "index": 217,
      "text": "Squidward, hey, Squidward!",
      "kind": "dialogue",
      "startMs": 833201,
      "endMs": 836337
    },
    {
      "index": 218,
      "text": "Squidward!",
      "kind": "dialogue",
      "startMs": 836404,
      "endMs": 837739
    },
    {
      "index": 219,
      "text": "Squidwardiard!",
      "kind": "dialogue",
      "startMs": 837806,
      "endMs": 840108
    },
    {
      "index": 220,
      "text": "Squidward, look at my new pet.",
      "kind": "dialogue",
      "startMs": 840174,
      "endMs": 842043
    },
    {
      "index": 221,
      "text": "That's no pet, that's a wild animal.",
      "kind": "dialogue",
      "startMs": 842110,
      "endMs": 844879
    },
    {
      "index": 222,
      "text": "No, he isn't.",
      "kind": "dialogue",
      "startMs": 844946,
      "endMs": 845880
    },
    {
      "index": 223,
      "text": "Watch this.",
      "kind": "dialogue",
      "startMs": 845947,
      "endMs": 847181
    },
    {
      "index": 224,
      "text": "Fetch.",
      "kind": "dialogue",
      "startMs": 847248,
      "endMs": 848249
    },
    {
      "index": 225,
      "text": "How many fingers am i holding up?",
      "kind": "dialogue",
      "startMs": 849283,
      "endMs": 851152
    },
    {
      "index": 226,
      "text": "Play dead.",
      "kind": "dialogue",
      "startMs": 853087,
      "endMs": 853922
    },
    {
      "index": 227,
      "text": "I wouldn't let that thing in my house Even if it was potty-Trained.",
      "kind": "dialogue",
      "startMs": 856090,
      "endMs": 859861
    },
    {
      "index": 228,
      "text": "I didn't need to see that.",
      "kind": "dialogue",
      "startMs": 863164,
      "endMs": 864633
    },
    {
      "index": 229,
      "text": "Well, we're going to my house To have a little fun.",
      "kind": "dialogue",
      "startMs": 864633,
      "endMs": 867636
    },
    {
      "index": 230,
      "text": "How can you possibly have fun with a jellyfish?!",
      "kind": "dialogue",
      "startMs": 869437,
      "endMs": 872774
    },
    {
      "index": 231,
      "text": "* hey! * * hey! * * hey! * * hey! * * hey! * * hey! * * hey! *",
      "kind": "dialogue",
      "startMs": 903104,
      "endMs": 915917
    },
    {
      "index": 232,
      "text": "Spongebob is the only guy i know That can have fun with a jellyfish...",
      "kind": "dialogue",
      "startMs": 938273,
      "endMs": 943078
    },
    {
      "index": 233,
      "text": "For 12 hours!",
      "kind": "dialogue",
      "startMs": 943145,
      "endMs": 945414
    },
    {
      "index": 234,
      "text": "Ugh... wow!",
      "kind": "dialogue",
      "startMs": 954456,
      "endMs": 956825
    },
    {
      "index": 235,
      "text": "You sure like to dance.",
      "kind": "dialogue",
      "startMs": 956926,
      "endMs": 958727
    },
    {
      "index": 236,
      "text": "Well, that's enough for tonight.",
      "kind": "dialogue",
      "startMs": 958928,
      "endMs": 960629
    },
    {
      "index": 237,
      "text": "It's time to go to bed.",
      "kind": "dialogue",
      "startMs": 962464,
      "endMs": 963933
    },
    {
      "index": 238,
      "text": "Huh?",
      "kind": "dialogue",
      "startMs": 969371,
      "endMs": 970339
    },
    {
      "index": 239,
      "text": "You've got it all wrong, little fellow.",
      "kind": "dialogue",
      "startMs": 972641,
      "endMs": 974676
    },
    {
      "index": 240,
      "text": "Bed!",
      "kind": "dialogue",
      "startMs": 976711,
      "endMs": 979148
    },
    {
      "index": 241,
      "text": "Repeat after me, \"bed.\"",
      "kind": "dialogue",
      "startMs": 979214,
      "endMs": 981150
    },
    {
      "index": 242,
      "text": "We'll just keep you right here.",
      "kind": "dialogue",
      "startMs": 983385,
      "endMs": 985420
    },
    {
      "index": 243,
      "text": "Quit worrying, Gary.",
      "kind": "dialogue",
      "startMs": 986421,
      "endMs": 987622
    },
    {
      "index": 244,
      "text": "He'll be just fine.",
      "kind": "dialogue",
      "startMs": 987689,
      "endMs": 988857
    },
    {
      "index": 245,
      "text": "Good night, everybody.",
      "kind": "dialogue",
      "startMs": 988958,
      "endMs": 991693
    },
    {
      "index": 246,
      "text": "Mmm... good morning, Gary.",
      "kind": "dialogue",
      "startMs": 1026028,
      "endMs": 1029598
    },
    {
      "index": 247,
      "text": "Good morning, jellyfish.",
      "kind": "dialogue",
      "startMs": 1029664,
      "endMs": 1031700
    },
    {
      "index": 248,
      "text": "Jellyfish?",
      "kind": "dialogue",
      "startMs": 1031766,
      "endMs": 1032901
    },
    {
      "index": 249,
      "text": "Jellyfish?",
      "kind": "dialogue",
      "startMs": 1033002,
      "endMs": 1034303
    },
    {
      "index": 250,
      "text": "Here, jellyfish!",
      "kind": "dialogue",
      "startMs": 1034369,
      "endMs": 1035537
    },
    {
      "index": 251,
      "text": "Oh, jelly!",
      "kind": "dialogue",
      "startMs": 1037506,
      "endMs": 1038573
    },
    {
      "index": 252,
      "text": "Oh, jellyf...",
      "kind": "dialogue",
      "startMs": 1044179,
      "endMs": 1045480
    },
    {
      "index": 253,
      "text": "Where'd you all come from?",
      "kind": "dialogue",
      "startMs": 1051086,
      "endMs": 1053055
    },
    {
      "index": 254,
      "text": "Okay, that's it.",
      "kind": "dialogue",
      "startMs": 1067602,
      "endMs": 1068537
    },
    {
      "index": 255,
      "text": "Party is over!",
      "kind": "dialogue",
      "startMs": 1068603,
      "endMs": 1069838
    },
    {
      "index": 256,
      "text": "You guys have overstayed your welcome.",
      "kind": "dialogue",
      "startMs": 1069904,
      "endMs": 1072374
    },
    {
      "index": 257,
      "text": "This music is way too loud.",
      "kind": "dialogue",
      "startMs": 1072441,
      "endMs": 1074809
    },
    {
      "index": 258,
      "text": "Very funny.",
      "kind": "dialogue",
      "startMs": 1076578,
      "endMs": 1077846
    },
    {
      "index": 259,
      "text": "I'm serious.",
      "kind": "dialogue",
      "startMs": 1080115,
      "endMs": 1081383
    },
    {
      "index": 260,
      "text": "18 hours!",
      "kind": "dialogue",
      "startMs": 1098300,
      "endMs": 1100335
    },
    {
      "index": 261,
      "text": "I'm going to give that Spongebob a piece of my mind.",
      "kind": "dialogue",
      "startMs": 1102571,
      "endMs": 1105507
    },
    {
      "index": 262,
      "text": "Hello.",
      "kind": "dialogue",
      "startMs": 1108243,
      "endMs": 1109544
    },
    {
      "index": 263,
      "text": "Spongebob, listen to me You square-Headed assault on my ears.",
      "kind": "dialogue",
      "startMs": 1109611,
      "endMs": 1112781
    },
    {
      "index": 264,
      "text": "I've had enough of this!",
      "kind": "dialogue",
      "startMs": 1112847,
      "endMs": 1115784
    },
    {
      "index": 265,
      "text": "Strawberry.",
      "kind": "dialogue",
      "startMs": 1115850,
      "endMs": 1117719
    },
    {
      "index": 266,
      "text": "Two can play at this.",
      "kind": "dialogue",
      "startMs": 1117786,
      "endMs": 1120355
    },
    {
      "index": 267,
      "text": "Come on, guys Enough is enough.",
      "kind": "dialogue",
      "startMs": 1121623,
      "endMs": 1124093
    },
    {
      "index": 268,
      "text": "Huh?",
      "kind": "dialogue",
      "startMs": 1124126,
      "endMs": 1125827
    },
    {
      "index": 269,
      "text": "Hey, take it easy! Ow!",
      "kind": "dialogue",
      "startMs": 1132401,
      "endMs": 1134103
    },
    {
      "index": 270,
      "text": "Okay, i'll talk to him.",
      "kind": "dialogue",
      "startMs": 1134103,
      "endMs": 1136004
    },
    {
      "index": 271,
      "text": "Squidward, would it be possible To play your clarinet a little... better?",
      "kind": "dialogue",
      "startMs": 1137672,
      "endMs": 1142544
    },
    {
      "index": 272,
      "text": "I don't think the jellyfish like it.",
      "kind": "dialogue",
      "startMs": 1142611,
      "endMs": 1145114
    },
    {
      "index": 273,
      "text": "The jellyfish don't like...",
      "kind": "dialogue",
      "startMs": 1145114,
      "endMs": 1146881
    },
    {
      "index": 274,
      "text": "Wha... why sure, pal, i can play better.",
      "kind": "dialogue",
      "startMs": 1146948,
      "endMs": 1151553
    },
    {
      "index": 275,
      "text": "Okay, he said he'll play better.",
      "kind": "dialogue",
      "startMs": 1151620,
      "endMs": 1153688
    },
    {
      "index": 276,
      "text": "Uh-Oh, that's not better.",
      "kind": "dialogue",
      "startMs": 1160629,
      "endMs": 1162264
    },
    {
      "index": 277,
      "text": "Hey, take it easy with that!",
      "kind": "dialogue",
      "startMs": 1162331,
      "endMs": 1165134
    },
    {
      "index": 278,
      "text": "Uh, wait-- I can turn it down.",
      "kind": "dialogue",
      "startMs": 1172907,
      "endMs": 1175009
    },
    {
      "index": 279,
      "text": "Everybody's a critic.",
      "kind": "dialogue",
      "startMs": 1183518,
      "endMs": 1185220
    },
    {
      "index": 280,
      "text": "You won't be hearing from me anymore.",
      "kind": "dialogue",
      "startMs": 1185287,
      "endMs": 1187922
    },
    {
      "index": 281,
      "text": "Hey, now, that wasn't nice.",
      "kind": "dialogue",
      "startMs": 1189658,
      "endMs": 1191393
    },
    {
      "index": 282,
      "text": "Okay, that is it!",
      "kind": "dialogue",
      "startMs": 1197599,
      "endMs": 1199134
    },
    {
      "index": 283,
      "text": "Everybody out!",
      "kind": "dialogue",
      "startMs": 1199201,
      "endMs": 1201970
    },
    {
      "index": 284,
      "text": "Uh, wait... hold on.",
      "kind": "dialogue",
      "startMs": 1219354,
      "endMs": 1220655
    },
    {
      "index": 285,
      "text": "Uh, wait.",
      "kind": "dialogue",
      "startMs": 1220722,
      "endMs": 1222457
    },
    {
      "index": 286,
      "text": "Ow, ow...",
      "kind": "dialogue",
      "startMs": 1222524,
      "endMs": 1223525
    },
    {
      "index": 287,
      "text": "Ow, ow, ow...",
      "kind": "dialogue",
      "startMs": 1223592,
      "endMs": 1225360
    },
    {
      "index": 288,
      "text": "Come on, Gary.",
      "kind": "dialogue",
      "startMs": 1234303,
      "endMs": 1236638
    },
    {
      "index": 289,
      "text": "Gary, you were right.",
      "kind": "dialogue",
      "startMs": 1243545,
      "endMs": 1245880
    },
    {
      "index": 290,
      "text": "Thanks for not rubbing it in.",
      "kind": "dialogue",
      "startMs": 1245947,
      "endMs": 1247682
    },
    {
      "index": 291,
      "text": "Huh?",
      "kind": "dialogue",
      "startMs": 1254923,
      "endMs": 1256291
    },
    {
      "index": 292,
      "text": "They stopped?",
      "kind": "dialogue",
      "startMs": 1259794,
      "endMs": 1261296
    },
    {
      "index": 293,
      "text": "Gary, don't stop shaking it!",
      "kind": "dialogue",
      "startMs": 1277111,
      "endMs": 1280682
    },
    {
      "index": 294,
      "text": "Today Spongebob has learned one of the sea's harshest lessons-- Wild animals can throw very wild parties.",
      "kind": "dialogue",
      "startMs": 1363498,
      "endMs": 1371906
    },
    {
      "index": 295,
      "text": "Ooh, i felt that.",
      "kind": "dialogue",
      "startMs": 1373808,
      "endMs": 1375577
    }
  ],
