  "lineCount": 316,
  "lines": [
    {
      "index": 0,
      "text": "SUB BY : DENI AUROR@ https://aurorarental.blogspot.com/ Are you ready, kids?",
      "kind": "dialogue",
      "startMs": 10,
      "endMs": 9311
    },
    {
      "index": 1,
      "text": "Aye, aye, Captain!",
      "kind": "dialogue",
      "startMs": 9344,
      "endMs": 11180
    },
    {
      "index": 2,
      "text": "I can't hear you.",
      "kind": "dialogue",
      "startMs": 11213,
      "endMs": 12848
    },
    {
      "index": 3,
      "text": "Aye, aye, Captain!",
      "kind": "dialogue",
      "startMs": 12882,
      "endMs": 14383
    },
    {
      "index": 4,
      "text": "* oh...",
      "kind": "dialogue",
      "startMs": 14416,
      "endMs": 17552
    },
    {
      "index": 5,
      "text": "* who lives in a pineapple under the sea? * * Spongebob Squarepants! * * absorbent and yellow and porous is he. * * Spongebob Squarepants! * * if nautical nonsense be something you wish... * * Spongebob square pants! * * then drop on the deck and flop like a fish. * * Spongebob Squarepants! * * ready? Spongebob Squarepants! * * Spongebob Squarepants!",
      "kind": "dialogue",
      "startMs": 17586,
      "endMs": 38540
    },
    {
      "index": 6,
      "text": "* Spongebob Squarepants!",
      "kind": "dialogue",
      "startMs": 38573,
      "endMs": 39574
    },
    {
      "index": 7,
      "text": "* Spongebob Squarepants!",
      "kind": "dialogue",
      "startMs": 39608,
      "endMs": 42144
    },
    {
      "index": 8,
      "text": "Ah.",
      "kind": "dialogue",
      "startMs": 63332,
      "endMs": 64867
    },
    {
      "index": 9,
      "text": "It is the early morning in bikini bottom When the jellyfish are buzzing about Making their jellyfish jelly.",
      "kind": "dialogue",
      "startMs": 64900,
      "endMs": 73308
    },
    {
      "index": 10,
      "text": "Oh, what is happening here?",
      "kind": "dialogue",
      "startMs": 81083,
      "endMs": 83152
    },
    {
      "index": 11,
      "text": "Collectors?",
      "kind": "dialogue",
      "startMs": 83185,
      "endMs": 85054
    },
    {
      "index": 12,
      "text": "I think i got it.",
      "kind": "dialogue",
      "startMs": 143979,
      "endMs": 145681
    },
    {
      "index": 13,
      "text": "No, wait a minute.",
      "kind": "dialogue",
      "startMs": 145715,
      "endMs": 147082
    },
    {
      "index": 14,
      "text": "Go, go, go, go!",
      "kind": "dialogue",
      "startMs": 149051,
      "endMs": 150753
    },
    {
      "index": 15,
      "text": "Ooh! Ouch! Ooh-Ooh!",
      "kind": "dialogue",
      "startMs": 151887,
      "endMs": 156692
    },
    {
      "index": 16,
      "text": "Ooh! Ouch!",
      "kind": "dialogue",
      "startMs": 157993,
      "endMs": 159394
    },
    {
      "index": 17,
      "text": "Hmm.",
      "kind": "dialogue",
      "startMs": 161931,
      "endMs": 163699
    },
    {
      "index": 18,
      "text": "Hey, Squidward.",
      "kind": "dialogue",
      "startMs": 164933,
      "endMs": 166901
    },
    {
      "index": 19,
      "text": "We're jellyfishing.",
      "kind": "dialogue",
      "startMs": 166935,
      "endMs": 168202
    },
    {
      "index": 20,
      "text": "Of course you are.",
      "kind": "dialogue",
      "startMs": 169603,
      "endMs": 170905
    },
    {
      "index": 21,
      "text": "Bye, now.",
      "kind": "dialogue",
      "startMs": 170939,
      "endMs": 171906
    },
    {
      "index": 22,
      "text": "Wait!",
      "kind": "dialogue",
      "startMs": 171940,
      "endMs": 172974
    },
    {
      "index": 23,
      "text": "We made a net especially for you.",
      "kind": "dialogue",
      "startMs": 173007,
      "endMs": 174575
    },
    {
      "index": 24,
      "text": "Do you want to come with us?",
      "kind": "dialogue",
      "startMs": 174608,
      "endMs": 176177
    },
    {
      "index": 25,
      "text": "Really?",
      "kind": "dialogue",
      "startMs": 176210,
      "endMs": 177311
    },
    {
      "index": 26,
      "text": "Jellyfishing with you guys?",
      "kind": "dialogue",
      "startMs": 177345,
      "endMs": 179447
    },
    {
      "index": 27,
      "text": "Oh, that would be the best day ever in my book.",
      "kind": "dialogue",
      "startMs": 179480,
      "endMs": 183451
    },
    {
      "index": 28,
      "text": "I would love to go jellyfishing.",
      "kind": "dialogue",
      "startMs": 183484,
      "endMs": 186320
    },
    {
      "index": 29,
      "text": "I can't think of anything i'd love to do more on my day off Than go jellyfishing With my two best friends Spongebob and... uh...",
      "kind": "dialogue",
      "startMs": 186354,
      "endMs": 197065
    },
    {
      "index": 30,
      "text": "Patrick.",
      "kind": "dialogue",
      "startMs": 197098,
      "endMs": 198099
    },
    {
      "index": 31,
      "text": "Right.",
      "kind": "dialogue",
      "startMs": 198132,
      "endMs": 199467
    },
    {
      "index": 32,
      "text": "But i can't, bye-Bye.",
      "kind": "dialogue",
      "startMs": 199500,
      "endMs": 200634
    },
    {
      "index": 33,
      "text": "Next time?",
      "kind": "dialogue",
      "startMs": 200668,
      "endMs": 202470
    },
    {
      "index": 34,
      "text": "Oh, sure.",
      "kind": "dialogue",
      "startMs": 202503,
      "endMs": 204072
    },
    {
      "index": 35,
      "text": "Right.",
      "kind": "dialogue",
      "startMs": 204105,
      "endMs": 205106
    },
    {
      "index": 36,
      "text": "Whatever.",
      "kind": "dialogue",
      "startMs": 205139,
      "endMs": 206540
    },
    {
      "index": 37,
      "text": "Like that'll ever happen.",
      "kind": "dialogue",
      "startMs": 206574,
      "endMs": 208642
    },
    {
      "index": 38,
      "text": "You know, Patrick, it always seems Like Squidward never has time for fun.",
      "kind": "dialogue",
      "startMs": 208676,
      "endMs": 212947
    },
    {
      "index": 39,
      "text": "Maybe he doesn't like us.",
      "kind": "dialogue",
      "startMs": 212981,
      "endMs": 215283
    },
    {
      "index": 40,
      "text": "No, are you kidding?",
      "kind": "dialogue",
      "startMs": 215316,
      "endMs": 216684
    },
    {
      "index": 41,
      "text": "We're his best friends.",
      "kind": "dialogue",
      "startMs": 216717,
      "endMs": 218486
    },
    {
      "index": 42,
      "text": "Jellyfishing!",
      "kind": "dialogue",
      "startMs": 227728,
      "endMs": 229630
    },
    {
      "index": 43,
      "text": "Oh, i'll go.",
      "kind": "dialogue",
      "startMs": 231432,
      "endMs": 233234
    },
    {
      "index": 44,
      "text": "I sure had them going.",
      "kind": "dialogue",
      "startMs": 234668,
      "endMs": 236971
    },
    {
      "index": 45,
      "text": "Stupid jellyfish, beat it!",
      "kind": "dialogue",
      "startMs": 266767,
      "endMs": 268302
    },
    {
      "index": 46,
      "text": "Whoa!",
      "kind": "dialogue",
      "startMs": 268336,
      "endMs": 269303
    },
    {
      "index": 47,
      "text": "Whoa... wha... wha...",
      "kind": "dialogue",
      "startMs": 269337,
      "endMs": 272573
    },
    {
      "index": 48,
      "text": "Ow! Ooh! Whoa!",
      "kind": "dialogue",
      "startMs": 273474,
      "endMs": 276144
    },
    {
      "index": 49,
      "text": "Ah! Ooh! Ah! Ooh!",
      "kind": "dialogue",
      "startMs": 276177,
      "endMs": 279447
    },
    {
      "index": 50,
      "text": "Ow.",
      "kind": "dialogue",
      "startMs": 285453,
      "endMs": 288122
    },
    {
      "index": 51,
      "text": "Squid's back.",
      "kind": "dialogue",
      "startMs": 315349,
      "endMs": 317385
    },
    {
      "index": 52,
      "text": "Hello.",
      "kind": "dialogue",
      "startMs": 320088,
      "endMs": 321055
    },
    {
      "index": 53,
      "text": "Hey, Patrick, squid's home And we're going to make sure He's greeted by his two best friends.",
      "kind": "dialogue",
      "startMs": 321089,
      "endMs": 326060
    },
    {
      "index": 54,
      "text": "Oh, great, who are they?",
      "kind": "dialogue",
      "startMs": 326094,
      "endMs": 327461
    },
    {
      "index": 55,
      "text": "Us.",
      "kind": "dialogue",
      "startMs": 327495,
      "endMs": 328696
    },
    {
      "index": 56,
      "text": "Let's go.",
      "kind": "dialogue",
      "startMs": 329763,
      "endMs": 331399
    },
    {
      "index": 57,
      "text": "Welcome home, Squidward!",
      "kind": "dialogue",
      "startMs": 338539,
      "endMs": 340341
    },
    {
      "index": 58,
      "text": "Merry christmas!",
      "kind": "dialogue",
      "startMs": 340374,
      "endMs": 342276
    },
    {
      "index": 59,
      "text": "We're going to make this Your best day ever!",
      "kind": "dialogue",
      "startMs": 342310,
      "endMs": 345613
    },
    {
      "index": 60,
      "text": "Well, your best day's Sure not going to be out there.",
      "kind": "dialogue",
      "startMs": 347248,
      "endMs": 350084
    },
    {
      "index": 61,
      "text": "How about some soup on your best day ever?",
      "kind": "dialogue",
      "startMs": 350118,
      "endMs": 354388
    },
    {
      "index": 62,
      "text": "Here we go.",
      "kind": "dialogue",
      "startMs": 360661,
      "endMs": 363264
    },
    {
      "index": 63,
      "text": "Oh, it's a little hot.",
      "kind": "dialogue",
      "startMs": 366667,
      "endMs": 369437
    },
    {
      "index": 64,
      "text": "Huh!",
      "kind": "dialogue",
      "startMs": 372806,
      "endMs": 374175
    },
    {
      "index": 65,
      "text": "I-I-I don't think soup is The best thing for him On his best day ever.",
      "kind": "dialogue",
      "startMs": 385886,
      "endMs": 390791
    },
    {
      "index": 66,
      "text": "How about some music on your best day ever?",
      "kind": "dialogue",
      "startMs": 390824,
      "endMs": 393594
    },
    {
      "index": 67,
      "text": "Played on your very own clarinet?",
      "kind": "dialogue",
      "startMs": 393627,
      "endMs": 395663
    },
    {
      "index": 68,
      "text": "Sorry, my lips are a little dry.",
      "kind": "dialogue",
      "startMs": 398566,
      "endMs": 400268
    },
    {
      "index": 69,
      "text": "Mm-Hmm, mm-Hmm.",
      "kind": "dialogue",
      "startMs": 415349,
      "endMs": 416584
    },
    {
      "index": 70,
      "text": "Music isn't best, either.",
      "kind": "dialogue",
      "startMs": 418486,
      "endMs": 420488
    },
    {
      "index": 71,
      "text": "But what is best Is what we saved for last-- The one sure-Fire thing to make your best day ever The best day ever.",
      "kind": "dialogue",
      "startMs": 420521,
      "endMs": 430298
    },
    {
      "index": 72,
      "text": "Jellyfishing, jellyfishing Jellyfishing, jellyfishing, jellyfishing, jellyfishing Jellyfishing, jellyfishing!",
      "kind": "dialogue",
      "startMs": 430331,
      "endMs": 438472
    },
    {
      "index": 73,
      "text": "This is jellyfish fields Where wild jellyfish roam just waiting to be captured.",
      "kind": "dialogue",
      "startMs": 438506,
      "endMs": 443444
    },
    {
      "index": 74,
      "text": "No, no, squid, over here.",
      "kind": "dialogue",
      "startMs": 446380,
      "endMs": 447715
    },
    {
      "index": 75,
      "text": "I know you're eager But you don't even have your net.",
      "kind": "dialogue",
      "startMs": 447748,
      "endMs": 451385
    },
    {
      "index": 76,
      "text": "Patrick, fix him up While i find him a good specimen.",
      "kind": "dialogue",
      "startMs": 451419,
      "endMs": 454455
    },
    {
      "index": 77,
      "text": "Firmly grasp it in your hand.",
      "kind": "dialogue",
      "startMs": 454488,
      "endMs": 456524
    },
    {
      "index": 78,
      "text": "Firmly grasp it.",
      "kind": "dialogue",
      "startMs": 460361,
      "endMs": 462630
    },
    {
      "index": 79,
      "text": "Firmly grasp it!",
      "kind": "dialogue",
      "startMs": 466500,
      "endMs": 467935
    },
    {
      "index": 80,
      "text": "That ought to do it.",
      "kind": "dialogue",
      "startMs": 472506,
      "endMs": 473474
    },
    {
      "index": 81,
      "text": "There's one in position.",
      "kind": "dialogue",
      "startMs": 475243,
      "endMs": 477345
    },
    {
      "index": 82,
      "text": "Ready...",
      "kind": "dialogue",
      "startMs": 477378,
      "endMs": 478612
    },
    {
      "index": 83,
      "text": "Set...",
      "kind": "dialogue",
      "startMs": 478646,
      "endMs": 480548
    },
    {
      "index": 84,
      "text": "Go! Go, squid! You got it! You got it.",
      "kind": "dialogue",
      "startMs": 480581,
      "endMs": 482883
    },
    {
      "index": 85,
      "text": "Go, squid! Go, squidder!",
      "kind": "dialogue",
      "startMs": 482916,
      "endMs": 484518
    },
    {
      "index": 86,
      "text": "Go, go, go! Yes, you got it!",
      "kind": "dialogue",
      "startMs": 486787,
      "endMs": 489623
    },
    {
      "index": 87,
      "text": "Get it, squidder!",
      "kind": "dialogue",
      "startMs": 489657,
      "endMs": 491525
    },
    {
      "index": 88,
      "text": "I think we better show him how it's done.",
      "kind": "dialogue",
      "startMs": 493661,
      "endMs": 496430
    },
    {
      "index": 89,
      "text": "( To the tune of \"on * da-Da-Da-Da-Dum * da-Da-Da-Da-Dum...",
      "kind": "dialogue",
      "startMs": 498599,
      "endMs": 505673
    },
    {
      "index": 90,
      "text": "* da-Da-Da-Da-Dum...",
      "kind": "dialogue",
      "startMs": 507841,
      "endMs": 511412
    },
    {
      "index": 91,
      "text": "* da-Da-Da-Da-Dum.",
      "kind": "dialogue",
      "startMs": 512813,
      "endMs": 515283
    },
    {
      "index": 92,
      "text": "* da-Da-Da-Da-Dum...",
      "kind": "dialogue",
      "startMs": 520954,
      "endMs": 523291
    },
    {
      "index": 93,
      "text": "* da-Da-Da * da-Da-Da-Da-Da- Da-Dum-Da-Dum-Dum. *",
      "kind": "dialogue",
      "startMs": 524492,
      "endMs": 530598
    },
    {
      "index": 94,
      "text": "Ooh! Ooh! Ow! Ow! Ow!",
      "kind": "dialogue",
      "startMs": 548048,
      "endMs": 549717
    },
    {
      "index": 95,
      "text": "Ow! Ow! Ow! Ooh! Ooh!",
      "kind": "dialogue",
      "startMs": 549750,
      "endMs": 551452
    },
    {
      "index": 96,
      "text": "Hey, look, squid's doing it.",
      "kind": "dialogue",
      "startMs": 551485,
      "endMs": 553787
    },
    {
      "index": 97,
      "text": "Go, squid, get 'em, squid! Squidster, you're doing it!",
      "kind": "dialogue",
      "startMs": 556324,
      "endMs": 560461
    },
    {
      "index": 98,
      "text": "Go squid!",
      "kind": "dialogue",
      "startMs": 560494,
      "endMs": 561729
    },
    {
      "index": 99,
      "text": "Aha!",
      "kind": "dialogue",
      "startMs": 572740,
      "endMs": 575909
    },
    {
      "index": 100,
      "text": "This guy's good.",
      "kind": "dialogue",
      "startMs": 594662,
      "endMs": 596397
    },
    {
      "index": 101,
      "text": "He's a natural.",
      "kind": "dialogue",
      "startMs": 596430,
      "endMs": 597731
    },
    {
      "index": 102,
      "text": "You got it!",
      "kind": "dialogue",
      "startMs": 597765,
      "endMs": 598766
    },
    {
      "index": 103,
      "text": "You're doing great!",
      "kind": "dialogue",
      "startMs": 598799,
      "endMs": 599767
    },
    {
      "index": 104,
      "text": "Go, squid, go!",
      "kind": "dialogue",
      "startMs": 599800,
      "endMs": 601335
    },
    {
      "index": 105,
      "text": "Keep doing it, squid.",
      "kind": "dialogue",
      "startMs": 601369,
      "endMs": 602670
    },
    {
      "index": 106,
      "text": "See what you've been missing?",
      "kind": "dialogue",
      "startMs": 602703,
      "endMs": 604905
    },
    {
      "index": 107,
      "text": "Yeah, you got it, squid.",
      "kind": "dialogue",
      "startMs": 604938,
      "endMs": 607341
    },
    {
      "index": 108,
      "text": "Go, squid, go!",
      "kind": "dialogue",
      "startMs": 607375,
      "endMs": 608876
    },
    {
      "index": 109,
      "text": "Use that net.",
      "kind": "dialogue",
      "startMs": 608909,
      "endMs": 610611
    },
    {
      "index": 110,
      "text": "Be the net.",
      "kind": "dialogue",
      "startMs": 610644,
      "endMs": 612012
    },
    {
      "index": 111,
      "text": "Yeah, you're feeling it, squid.",
      "kind": "dialogue",
      "startMs": 612045,
      "endMs": 614882
    },
    {
      "index": 112,
      "text": "All the way, take him all the way.",
      "kind": "dialogue",
      "startMs": 614915,
      "endMs": 617885
    },
    {
      "index": 113,
      "text": "Go, go, go.",
      "kind": "dialogue",
      "startMs": 617918,
      "endMs": 618886
    },
    {
      "index": 114,
      "text": "You got 'em now.",
      "kind": "dialogue",
      "startMs": 618919,
      "endMs": 619953
    },
    {
      "index": 115,
      "text": "It's in the bag!",
      "kind": "dialogue",
      "startMs": 619987,
      "endMs": 622356
    },
    {
      "index": 116,
      "text": "This is really your best day ever, isn't it?",
      "kind": "dialogue",
      "startMs": 622390,
      "endMs": 624892
    },
    {
      "index": 117,
      "text": "Ooh. Ooh.",
      "kind": "dialogue",
      "startMs": 628662,
      "endMs": 630931
    },
    {
      "index": 118,
      "text": "Hey, Patrick.",
      "kind": "dialogue",
      "startMs": 633867,
      "endMs": 635369
    },
    {
      "index": 119,
      "text": "Well...",
      "kind": "dialogue",
      "startMs": 635403,
      "endMs": 637371
    },
    {
      "index": 120,
      "text": "I thought yesterday went pretty well, don't you think?",
      "kind": "dialogue",
      "startMs": 637405,
      "endMs": 640974
    },
    {
      "index": 121,
      "text": "I had fun.",
      "kind": "dialogue",
      "startMs": 641008,
      "endMs": 643577
    },
    {
      "index": 122,
      "text": "Me, too.",
      "kind": "dialogue",
      "startMs": 643611,
      "endMs": 644645
    },
    {
      "index": 123,
      "text": "Here comes Squidward.",
      "kind": "dialogue",
      "startMs": 644678,
      "endMs": 646580
    },
    {
      "index": 124,
      "text": "Oh, great.",
      "kind": "dialogue",
      "startMs": 646614,
      "endMs": 648582
    },
    {
      "index": 125,
      "text": "Hey, squid, how about that...",
      "kind": "dialogue",
      "startMs": 652553,
      "endMs": 655088
    },
    {
      "index": 126,
      "text": "Best day ever.",
      "kind": "dialogue",
      "startMs": 656590,
      "endMs": 658526
    },
    {
      "index": 127,
      "text": "There's always tomorrow.",
      "kind": "dialogue",
      "startMs": 658559,
      "endMs": 659893
    },
    {
      "index": 128,
      "text": "We're really sorry About what happened yesterday, Squidward.",
      "kind": "dialogue",
      "startMs": 663897,
      "endMs": 667601
    },
    {
      "index": 129,
      "text": "We got you a present.",
      "kind": "dialogue",
      "startMs": 669770,
      "endMs": 670938
    },
    {
      "index": 130,
      "text": "It's the jellyfish.",
      "kind": "dialogue",
      "startMs": 673707,
      "endMs": 675443
    },
    {
      "index": 131,
      "text": "You know, from yesterday.",
      "kind": "dialogue",
      "startMs": 677010,
      "endMs": 679547
    },
    {
      "index": 132,
      "text": "You're not still mad, are you?",
      "kind": "dialogue",
      "startMs": 679580,
      "endMs": 682082
    },
    {
      "index": 133,
      "text": "Yep, he's still mad.",
      "kind": "dialogue",
      "startMs": 682115,
      "endMs": 683417
    },
    {
      "index": 134,
      "text": "Ow.",
      "kind": "dialogue",
      "startMs": 709042,
      "endMs": 710911
    },
    {
      "index": 135,
      "text": "One crabby patty for table two.",
      "kind": "dialogue",
      "startMs": 723491,
      "endMs": 725726
    },
    {
      "index": 136,
      "text": "Spongebob, i don't have the whole day!",
      "kind": "dialogue",
      "startMs": 725759,
      "endMs": 727861
    },
    {
      "index": 137,
      "text": "Oui, oui, une crabby patty, monsieur.",
      "kind": "dialogue",
      "startMs": 727895,
      "endMs": 730898
    },
    {
      "index": 138,
      "text": "There's les patty.",
      "kind": "dialogue",
      "startMs": 730931,
      "endMs": 732800
    },
    {
      "index": 139,
      "text": "Come on, Spongebob!",
      "kind": "dialogue",
      "startMs": 735235,
      "endMs": 737471
    },
    {
      "index": 140,
      "text": "Next, l'ingredients.",
      "kind": "dialogue",
      "startMs": 737505,
      "endMs": 739607
    },
    {
      "index": 141,
      "text": "Ah-Whee!",
      "kind": "dialogue",
      "startMs": 739640,
      "endMs": 740508
    },
    {
      "index": 142,
      "text": "Les mustard.",
      "kind": "dialogue",
      "startMs": 743777,
      "endMs": 745045
    },
    {
      "index": 143,
      "text": "Will you quit fooling around?!",
      "kind": "dialogue",
      "startMs": 746780,
      "endMs": 748482
    },
    {
      "index": 144,
      "text": "Where's my crabby patty?",
      "kind": "dialogue",
      "startMs": 748516,
      "endMs": 749750
    },
    {
      "index": 145,
      "text": "Les hold on a second.",
      "kind": "dialogue",
      "startMs": 749783,
      "endMs": 751451
    },
    {
      "index": 146,
      "text": "And voila.",
      "kind": "dialogue",
      "startMs": 757257,
      "endMs": 759059
    },
    {
      "index": 147,
      "text": "It's under your nose!",
      "kind": "dialogue",
      "startMs": 760060,
      "endMs": 761762
    },
    {
      "index": 148,
      "text": "You're killing me, Spongebob.",
      "kind": "dialogue",
      "startMs": 765065,
      "endMs": 767034
    },
    {
      "index": 149,
      "text": "Ha, ha!",
      "kind": "dialogue",
      "startMs": 767067,
      "endMs": 768101
    },
    {
      "index": 150,
      "text": "You really are.",
      "kind": "dialogue",
      "startMs": 768135,
      "endMs": 770037
    },
    {
      "index": 151,
      "text": "Look at it, Squidward-- Mister Krabs' gift to all of bikini bottom-- The crabby patty.",
      "kind": "dialogue",
      "startMs": 770070,
      "endMs": 776076
    },
    {
      "index": 152,
      "text": "Okay, give it to me.",
      "kind": "dialogue",
      "startMs": 776109,
      "endMs": 778211
    },
    {
      "index": 153,
      "text": "Come on, Spongebob, stop it!",
      "kind": "dialogue",
      "startMs": 781114,
      "endMs": 783216
    },
    {
      "index": 154,
      "text": "I swear, i'm not doing anything.",
      "kind": "dialogue",
      "startMs": 783250,
      "endMs": 785853
    },
    {
      "index": 155,
      "text": "Mister Krabs!",
      "kind": "dialogue",
      "startMs": 785886,
      "endMs": 787521
    },
    {
      "index": 156,
      "text": "That crabby patty is haunted!",
      "kind": "dialogue",
      "startMs": 787555,
      "endMs": 789022
    },
    {
      "index": 157,
      "text": "Avast, ye patty pirate!",
      "kind": "dialogue",
      "startMs": 790691,
      "endMs": 792526
    },
    {
      "index": 158,
      "text": "This is no ghost.",
      "kind": "dialogue",
      "startMs": 792560,
      "endMs": 794127
    },
    {
      "index": 159,
      "text": "This is...",
      "kind": "dialogue",
      "startMs": 794161,
      "endMs": 795796
    },
    {
      "index": 160,
      "text": "Plankton!",
      "kind": "dialogue",
      "startMs": 795829,
      "endMs": 797197
    },
    {
      "index": 161,
      "text": "Stealin' me booty!",
      "kind": "dialogue",
      "startMs": 797230,
      "endMs": 798465
    },
    {
      "index": 162,
      "text": "Hear me, krabs-- When i discover your formula for crabby patties I'll run you out of business.",
      "kind": "dialogue",
      "startMs": 798498,
      "endMs": 805673
    },
    {
      "index": 163,
      "text": "I went to college!",
      "kind": "dialogue",
      "startMs": 805706,
      "endMs": 807841
    },
    {
      "index": 164,
      "text": "Hey!",
      "kind": "dialogue",
      "startMs": 807875,
      "endMs": 808876
    },
    {
      "index": 165,
      "text": "Let me go!",
      "kind": "dialogue",
      "startMs": 808909,
      "endMs": 810844
    },
    {
      "index": 166,
      "text": "Oh, i'll let you go, squirt...",
      "kind": "dialogue",
      "startMs": 810878,
      "endMs": 813547
    },
    {
      "index": 167,
      "text": "On a flying saucer!",
      "kind": "dialogue",
      "startMs": 813581,
      "endMs": 815583
    },
    {
      "index": 168,
      "text": "Back to the chum bucket with you!",
      "kind": "dialogue",
      "startMs": 817618,
      "endMs": 820821
    },
    {
      "index": 169,
      "text": "You'll pay for this, krabs!",
      "kind": "dialogue",
      "startMs": 820854,
      "endMs": 823824
    },
    {
      "index": 170,
      "text": "Uh... plankton, sir?",
      "kind": "dialogue",
      "startMs": 823857,
      "endMs": 826093
    },
    {
      "index": 171,
      "text": "Aye, he's been trying To steal me secret formula for years.",
      "kind": "dialogue",
      "startMs": 826126,
      "endMs": 830698
    },
    {
      "index": 172,
      "text": "But ye haven't got it yet, have ye, bug?",
      "kind": "dialogue",
      "startMs": 830731,
      "endMs": 833567
    },
    {
      "index": 173,
      "text": "Okay.",
      "kind": "dialogue",
      "startMs": 840073,
      "endMs": 841742
    },
    {
      "index": 174,
      "text": "Enough, lad, it wasn't that funny.",
      "kind": "dialogue",
      "startMs": 841775,
      "endMs": 843744
    },
    {
      "index": 175,
      "text": "Get back to work!",
      "kind": "dialogue",
      "startMs": 843777,
      "endMs": 846146
    },
    {
      "index": 176,
      "text": "Okay, Mister Krabs, see you tomorrow.",
      "kind": "dialogue",
      "startMs": 847615,
      "endMs": 850050
    },
    {
      "index": 177,
      "text": "Good night, me boy.",
      "kind": "dialogue",
      "startMs": 850083,
      "endMs": 851785
    },
    {
      "index": 178,
      "text": "Psst...",
      "kind": "dialogue",
      "startMs": 857958,
      "endMs": 859627
    },
    {
      "index": 179,
      "text": "Young man...",
      "kind": "dialogue",
      "startMs": 859660,
      "endMs": 861595
    },
    {
      "index": 180,
      "text": "Yes, over here.",
      "kind": "dialogue",
      "startMs": 861629,
      "endMs": 863797
    },
    {
      "index": 181,
      "text": "Come on, boy, a little closer.",
      "kind": "dialogue",
      "startMs": 869970,
      "endMs": 872773
    },
    {
      "index": 182,
      "text": "Closer.",
      "kind": "dialogue",
      "startMs": 875108,
      "endMs": 876777
    },
    {
      "index": 183,
      "text": "Not that close!",
      "kind": "dialogue",
      "startMs": 877711,
      "endMs": 878879
    },
    {
      "index": 184,
      "text": "Ah!",
      "kind": "dialogue",
      "startMs": 878912,
      "endMs": 879947
    },
    {
      "index": 185,
      "text": "You blasted barnicle head!",
      "kind": "dialogue",
      "startMs": 879980,
      "endMs": 883016
    },
    {
      "index": 186,
      "text": "I mean... hi!",
      "kind": "dialogue",
      "startMs": 883050,
      "endMs": 885152
    },
    {
      "index": 187,
      "text": "Plankton?",
      "kind": "dialogue",
      "startMs": 885185,
      "endMs": 886353
    },
    {
      "index": 188,
      "text": "Ouch!",
      "kind": "dialogue",
      "startMs": 886386,
      "endMs": 887354
    },
    {
      "index": 189,
      "text": "What do you want?",
      "kind": "dialogue",
      "startMs": 887387,
      "endMs": 888756
    },
    {
      "index": 190,
      "text": "I just want to talk.",
      "kind": "dialogue",
      "startMs": 888789,
      "endMs": 890624
    },
    {
      "index": 191,
      "text": "You could say we're friends, right?",
      "kind": "dialogue",
      "startMs": 890658,
      "endMs": 893060
    },
    {
      "index": 192,
      "text": "Um... no.",
      "kind": "dialogue",
      "startMs": 893093,
      "endMs": 894294
    },
    {
      "index": 193,
      "text": "Acquaintances.",
      "kind": "dialogue",
      "startMs": 894327,
      "endMs": 895896
    },
    {
      "index": 194,
      "text": "No.",
      "kind": "dialogue",
      "startMs": 895929,
      "endMs": 896797
    },
    {
      "index": 195,
      "text": "Well, we're both invertebrates, aren't we?",
      "kind": "dialogue",
      "startMs": 898331,
      "endMs": 901301
    },
    {
      "index": 196,
      "text": "I... guess so.",
      "kind": "dialogue",
      "startMs": 901334,
      "endMs": 902703
    },
    {
      "index": 197,
      "text": "You see, everything works out.",
      "kind": "dialogue",
      "startMs": 902736,
      "endMs": 906907
    },
    {
      "index": 198,
      "text": "I have something for you.",
      "kind": "dialogue",
      "startMs": 906940,
      "endMs": 908776
    },
    {
      "index": 199,
      "text": "I've been keeping it in my secret compartment.",
      "kind": "dialogue",
      "startMs": 908809,
      "endMs": 911912
    },
    {
      "index": 200,
      "text": "Ching! Sparkle, sparkle!",
      "kind": "dialogue",
      "startMs": 911945,
      "endMs": 913914
    },
    {
      "index": 201,
      "text": "Wow! A golden spatula!",
      "kind": "dialogue",
      "startMs": 913947,
      "endMs": 918051
    },
    {
      "index": 202,
      "text": "And it's even got my name on it.",
      "kind": "dialogue",
      "startMs": 918085,
      "endMs": 919920
    },
    {
      "index": 203,
      "text": "It's a gift.",
      "kind": "dialogue",
      "startMs": 919953,
      "endMs": 921354
    },
    {
      "index": 204,
      "text": "A gift from a friend.",
      "kind": "dialogue",
      "startMs": 921388,
      "endMs": 923190
    },
    {
      "index": 205,
      "text": "Friends give each other gifts.",
      "kind": "dialogue",
      "startMs": 923223,
      "endMs": 925826
    },
    {
      "index": 206,
      "text": "And tomorrow is my birthday.",
      "kind": "dialogue",
      "startMs": 925859,
      "endMs": 928195
    },
    {
      "index": 207,
      "text": "And you know what i'd like More than anything in the whole wide world?",
      "kind": "dialogue",
      "startMs": 929830,
      "endMs": 934968
    },
    {
      "index": 208,
      "text": "A booster seat?",
      "kind": "dialogue",
      "startMs": 936303,
      "endMs": 937337
    },
    {
      "index": 209,
      "text": "Booster seat? Hot dog!",
      "kind": "dialogue",
      "startMs": 937370,
      "endMs": 939239
    },
    {
      "index": 210,
      "text": "I mean, no.",
      "kind": "dialogue",
      "startMs": 939272,
      "endMs": 941274
    },
    {
      "index": 211,
      "text": "What i want for my birthday from you, my friend Is one of those...",
      "kind": "dialogue",
      "startMs": 941308,
      "endMs": 949016
    },
    {
      "index": 212,
      "text": "Tender... delicious...",
      "kind": "dialogue",
      "startMs": 949049,
      "endMs": 952019
    },
    {
      "index": 213,
      "text": "Crabby patties.",
      "kind": "dialogue",
      "startMs": 952052,
      "endMs": 953286
    },
    {
      "index": 214,
      "text": "You just want to be friends So you can get your hands on a crabby patty!",
      "kind": "dialogue",
      "startMs": 954454,
      "endMs": 957825
    },
    {
      "index": 215,
      "text": "And i bet it's not even your birthday tomorrow!",
      "kind": "dialogue",
      "startMs": 957858,
      "endMs": 960293
    },
    {
      "index": 216,
      "text": "Gee, and i thought you were stupid.",
      "kind": "dialogue",
      "startMs": 960327,
      "endMs": 962830
    },
    {
      "index": 217,
      "text": "You'll never get a crabby patty from me!",
      "kind": "dialogue",
      "startMs": 962863,
      "endMs": 965265
    },
    {
      "index": 218,
      "text": "Even if we are friends!",
      "kind": "dialogue",
      "startMs": 967000,
      "endMs": 968702
    },
    {
      "index": 219,
      "text": "Never, never, never, never!",
      "kind": "dialogue",
      "startMs": 968736,
      "endMs": 970437
    },
    {
      "index": 220,
      "text": "Oh, i'll get a crabby patty.",
      "kind": "dialogue",
      "startMs": 970470,
      "endMs": 972706
    },
    {
      "index": 221,
      "text": "And you're going to hand-Deliver it to me personally!",
      "kind": "dialogue",
      "startMs": 972740,
      "endMs": 976710
    },
    {
      "index": 222,
      "text": "You weak-Minded fool!",
      "kind": "dialogue",
      "startMs": 976744,
      "endMs": 979780
    },
    {
      "index": 223,
      "text": "Night, gary.",
      "kind": "dialogue",
      "startMs": 984284,
      "endMs": 985986
    },
    {
      "index": 224,
      "text": "Spongebob, you will be mine.",
      "kind": "dialogue",
      "startMs": 1003771,
      "endMs": 1008942
    },
    {
      "index": 225,
      "text": "* ...letters of the alphabet, a, b, c... *",
      "kind": "dialogue",
      "startMs": 1008976,
      "endMs": 1011979
    },
    {
      "index": 226,
      "text": "It should be in here somewhere.",
      "kind": "dialogue",
      "startMs": 1023190,
      "endMs": 1027060
    },
    {
      "index": 227,
      "text": "But where?",
      "kind": "dialogue",
      "startMs": 1028195,
      "endMs": 1029429
    },
    {
      "index": 228,
      "text": "Where?",
      "kind": "dialogue",
      "startMs": 1029462,
      "endMs": 1031331
    },
    {
      "index": 229,
      "text": "Oh.",
      "kind": "dialogue",
      "startMs": 1031364,
      "endMs": 1033466
    },
    {
      "index": 230,
      "text": "This will be the beginning of the end.",
      "kind": "dialogue",
      "startMs": 1033500,
      "endMs": 1036436
    },
    {
      "index": 231,
      "text": "Ouch!",
      "kind": "dialogue",
      "startMs": 1042075,
      "endMs": 1043476
    },
    {
      "index": 232,
      "text": "Stupid brain.",
      "kind": "dialogue",
      "startMs": 1043510,
      "endMs": 1045178
    },
    {
      "index": 233,
      "text": "Come back here, you swine!",
      "kind": "dialogue",
      "startMs": 1045212,
      "endMs": 1047080
    },
    {
      "index": 234,
      "text": "Whoa... oof!",
      "kind": "dialogue",
      "startMs": 1050818,
      "endMs": 1052953
    },
    {
      "index": 235,
      "text": "That's it, brain, you're going down!",
      "kind": "dialogue",
      "startMs": 1057858,
      "endMs": 1059827
    },
    {
      "index": 236,
      "text": "Yes, yes, that's grand.",
      "kind": "dialogue",
      "startMs": 1062830,
      "endMs": 1065132
    },
    {
      "index": 237,
      "text": "And now, for my very elaborate and college-Educated plan.",
      "kind": "dialogue",
      "startMs": 1065165,
      "endMs": 1070838
    },
    {
      "index": 238,
      "text": "And now it's time for a little wakey-Uppy.",
      "kind": "dialogue",
      "startMs": 1075242,
      "endMs": 1077845
    },
    {
      "index": 239,
      "text": "Morning already?",
      "kind": "dialogue",
      "startMs": 1080413,
      "endMs": 1082315
    },
    {
      "index": 240,
      "text": "I... i feel a little funny today.",
      "kind": "dialogue",
      "startMs": 1088255,
      "endMs": 1090457
    },
    {
      "index": 241,
      "text": "Yeah, yeah!",
      "kind": "dialogue",
      "startMs": 1092425,
      "endMs": 1094862
    },
    {
      "index": 242,
      "text": "I have you now.",
      "kind": "dialogue",
      "startMs": 1100868,
      "endMs": 1102502
    },
    {
      "index": 243,
      "text": "Time for a well-Balanced breakfast.",
      "kind": "dialogue",
      "startMs": 1102535,
      "endMs": 1105072
    },
    {
      "index": 244,
      "text": "This isn't what i had in mind.",
      "kind": "dialogue",
      "startMs": 1106573,
      "endMs": 1109042
    },
    {
      "index": 245,
      "text": "Let me just grab my pants.",
      "kind": "dialogue",
      "startMs": 1109076,
      "endMs": 1111278
    },
    {
      "index": 246,
      "text": "I guess i'm not wearing any pants today.",
      "kind": "dialogue",
      "startMs": 1112412,
      "endMs": 1114514
    },
    {
      "index": 247,
      "text": "Oops! I guess i'm not using the door, either.",
      "kind": "dialogue",
      "startMs": 1114547,
      "endMs": 1117885
    },
    {
      "index": 248,
      "text": "See you later, gary... i guess.",
      "kind": "dialogue",
      "startMs": 1117918,
      "endMs": 1120187
    },
    {
      "index": 249,
      "text": "You're right, gary, there is something wrong with me!",
      "kind": "dialogue",
      "startMs": 1121421,
      "endMs": 1123924
    },
    {
      "index": 250,
      "text": "Squidward! Squidward!",
      "kind": "dialogue",
      "startMs": 1123957,
      "endMs": 1126994
    },
    {
      "index": 251,
      "text": "Wake up! I need some help!",
      "kind": "dialogue",
      "startMs": 1127027,
      "endMs": 1129930
    },
    {
      "index": 252,
      "text": "Squidward! Help!",
      "kind": "dialogue",
      "startMs": 1129963,
      "endMs": 1131531
    },
    {
      "index": 253,
      "text": "Be quiet, Spongebob!",
      "kind": "dialogue",
      "startMs": 1131564,
      "endMs": 1134034
    },
    {
      "index": 254,
      "text": "Help!",
      "kind": "dialogue",
      "startMs": 1135068,
      "endMs": 1138271
    },
    {
      "index": 255,
      "text": "Spongebob, what are you doing?",
      "kind": "dialogue",
      "startMs": 1138305,
      "endMs": 1141208
    },
    {
      "index": 256,
      "text": "I'm talking to you!",
      "kind": "dialogue",
      "startMs": 1141241,
      "endMs": 1143010
    },
    {
      "index": 257,
      "text": "Spongebob, Spongebob!",
      "kind": "dialogue",
      "startMs": 1143043,
      "endMs": 1144411
    },
    {
      "index": 258,
      "text": "Are you mad?",
      "kind": "dialogue",
      "startMs": 1144444,
      "endMs": 1145612
    },
    {
      "index": 259,
      "text": "Shut your mouth, you mediocre clarinet player.",
      "kind": "dialogue",
      "startMs": 1148448,
      "endMs": 1152219
    },
    {
      "index": 260,
      "text": "Mediocre?",
      "kind": "dialogue",
      "startMs": 1152252,
      "endMs": 1154287
    },
    {
      "index": 261,
      "text": "You pretentious little insignificant artist.",
      "kind": "dialogue",
      "startMs": 1154321,
      "endMs": 1157958
    },
    {
      "index": 262,
      "text": "Your snivelly creations are worth less Than a protozoan's waist.",
      "kind": "dialogue",
      "startMs": 1157991,
      "endMs": 1163163
    },
    {
      "index": 263,
      "text": "Something must be wrong with my brain!",
      "kind": "dialogue",
      "startMs": 1163196,
      "endMs": 1167467
    },
    {
      "index": 264,
      "text": "Plankton!",
      "kind": "dialogue",
      "startMs": 1170137,
      "endMs": 1171304
    },
    {
      "index": 265,
      "text": "What kind of friend are you?",
      "kind": "dialogue",
      "startMs": 1171338,
      "endMs": 1172906
    },
    {
      "index": 266,
      "text": "Nonsense! You never liked me, anyway.",
      "kind": "dialogue",
      "startMs": 1172940,
      "endMs": 1175575
    },
    {
      "index": 267,
      "text": "You wouldn't even come to my birthday party!",
      "kind": "dialogue",
      "startMs": 1175608,
      "endMs": 1179112
    },
    {
      "index": 268,
      "text": "Get out of my head!",
      "kind": "dialogue",
      "startMs": 1179146,
      "endMs": 1180647
    },
    {
      "index": 269,
      "text": "Leave my brain alone!",
      "kind": "dialogue",
      "startMs": 1180680,
      "endMs": 1182582
    },
    {
      "index": 270,
      "text": "Never! Never!",
      "kind": "dialogue",
      "startMs": 1182615,
      "endMs": 1185452
    },
    {
      "index": 271,
      "text": "Toot, toot!",
      "kind": "dialogue",
      "startMs": 1200133,
      "endMs": 1202102
    },
    {
      "index": 272,
      "text": "How about a little takeout?",
      "kind": "dialogue",
      "startMs": 1202135,
      "endMs": 1204471
    },
    {
      "index": 273,
      "text": "Nope, no, never!",
      "kind": "dialogue",
      "startMs": 1204504,
      "endMs": 1207240
    },
    {
      "index": 274,
      "text": "You can't fool me, plankton.",
      "kind": "dialogue",
      "startMs": 1210377,
      "endMs": 1211945
    },
    {
      "index": 275,
      "text": "You want the crabby patty formula!",
      "kind": "dialogue",
      "startMs": 1211979,
      "endMs": 1213613
    },
    {
      "index": 276,
      "text": "You are going to hand-Deliver it to me personally.",
      "kind": "dialogue",
      "startMs": 1213646,
      "endMs": 1217350
    },
    {
      "index": 277,
      "text": "No, no, no!",
      "kind": "dialogue",
      "startMs": 1217384,
      "endMs": 1221088
    },
    {
      "index": 278,
      "text": "There's no one here.",
      "kind": "dialogue",
      "startMs": 1221121,
      "endMs": 1222489
    },
    {
      "index": 279,
      "text": "Don't remind me.",
      "kind": "dialogue",
      "startMs": 1222522,
      "endMs": 1223623
    },
    {
      "index": 280,
      "text": "Brace yourself, Spongebob.",
      "kind": "dialogue",
      "startMs": 1223656,
      "endMs": 1227094
    },
    {
      "index": 281,
      "text": "This is my lab!",
      "kind": "dialogue",
      "startMs": 1227127,
      "endMs": 1228996
    },
    {
      "index": 282,
      "text": "And this is my laboratory!",
      "kind": "dialogue",
      "startMs": 1230663,
      "endMs": 1233500
    },
    {
      "index": 283,
      "text": "And did i ever show you my record player?",
      "kind": "dialogue",
      "startMs": 1233533,
      "endMs": 1237637
    },
    {
      "index": 284,
      "text": "I must fight.",
      "kind": "dialogue",
      "startMs": 1241541,
      "endMs": 1243376
    },
    {
      "index": 285,
      "text": "No, no, no, no!",
      "kind": "dialogue",
      "startMs": 1250150,
      "endMs": 1252452
    },
    {
      "index": 286,
      "text": "Ow, ow, ow, ow!",
      "kind": "dialogue",
      "startMs": 1255688,
      "endMs": 1257257
    },
    {
      "index": 287,
      "text": "There, you see how much easier it is When you help, friend?",
      "kind": "dialogue",
      "startMs": 1257290,
      "endMs": 1262662
    },
    {
      "index": 288,
      "text": "How do you like my analyzer?",
      "kind": "dialogue",
      "startMs": 1262695,
      "endMs": 1265132
    },
    {
      "index": 289,
      "text": "It tells the ingredients of whatever i put into it.",
      "kind": "dialogue",
      "startMs": 1265165,
      "endMs": 1268701
    },
    {
      "index": 290,
      "text": "Seaweed: 50% sea, 50% weed.",
      "kind": "dialogue",
      "startMs": 1270103,
      "endMs": 1274574
    },
    {
      "index": 291,
      "text": "Impressed?",
      "kind": "dialogue",
      "startMs": 1276076,
      "endMs": 1277544
    },
    {
      "index": 292,
      "text": "Now let's reveal that secret formula.",
      "kind": "dialogue",
      "startMs": 1277577,
      "endMs": 1280313
    },
    {
      "index": 293,
      "text": "And this little piggy brought home a crabby patty.",
      "kind": "dialogue",
      "startMs": 1282049,
      "endMs": 1285685
    },
    {
      "index": 294,
      "text": "This little piggy will help me drop it in.",
      "kind": "dialogue",
      "startMs": 1285718,
      "endMs": 1288555
    },
    {
      "index": 295,
      "text": "Any last words, Spongebob secretpants?",
      "kind": "dialogue",
      "startMs": 1288588,
      "endMs": 1291558
    },
    {
      "index": 296,
      "text": "I... i...",
      "kind": "dialogue",
      "startMs": 1291591,
      "endMs": 1293626
    },
    {
      "index": 297,
      "text": "I just have to say i'm sorry i let Mister Krabs down.",
      "kind": "dialogue",
      "startMs": 1295728,
      "endMs": 1299599
    },
    {
      "index": 298,
      "text": "I let all of bikini bottom down.",
      "kind": "dialogue",
      "startMs": 1299632,
      "endMs": 1302202
    },
    {
      "index": 299,
      "text": "But worst of all, i let you down You delicate little crabby patty.",
      "kind": "dialogue",
      "startMs": 1302235,
      "endMs": 1307307
    },
    {
      "index": 300,
      "text": "Mmm!",
      "kind": "dialogue",
      "startMs": 1307340,
      "endMs": 1308575
    },
    {
      "index": 301,
      "text": "With your tasty, juicy, scrumptious Warm, steamy goodness.",
      "kind": "dialogue",
      "startMs": 1308608,
      "endMs": 1314181
    },
    {
      "index": 302,
      "text": "Steamy!",
      "kind": "dialogue",
      "startMs": 1314214,
      "endMs": 1316583
    },
    {
      "index": 303,
      "text": "I'll never forget your 100% all-Secret patty Secretly assembled with undersea cheese Pickle, lettuce, tomato, onion All secretly steaming Between two fluffy seaweed-Seed buns.",
      "kind": "dialogue",
      "startMs": 1316616,
      "endMs": 1331331
    },
    {
      "index": 304,
      "text": "Yes... yes... yes!",
      "kind": "dialogue",
      "startMs": 1331364,
      "endMs": 1334801
    },
    {
      "index": 305,
      "text": "Come to papa!",
      "kind": "dialogue",
      "startMs": 1334834,
      "endMs": 1336503
    },
    {
      "index": 306,
      "text": "Oh, boy.",
      "kind": "dialogue",
      "startMs": 1338371,
      "endMs": 1340073
    },
    {
      "index": 307,
      "text": "Plankton: one percent evil, 99% hot gas.",
      "kind": "dialogue",
      "startMs": 1343643,
      "endMs": 1348115
    },
    {
      "index": 308,
      "text": "Well, this stinks.",
      "kind": "dialogue",
      "startMs": 1351251,
      "endMs": 1352752
    },
    {
      "index": 309,
      "text": "Well, patty, i guess we can go home now.",
      "kind": "dialogue",
      "startMs": 1352785,
      "endMs": 1356089
    },
    {
      "index": 310,
      "text": "Spongebob, that's my crabby patty!",
      "kind": "dialogue",
      "startMs": 1356123,
      "endMs": 1360427
    },
    {
      "index": 311,
      "text": "Give it back, you porous freak!",
      "kind": "dialogue",
      "startMs": 1360460,
      "endMs": 1363696
    },
    {
      "index": 312,
      "text": "I command you!",
      "kind": "dialogue",
      "startMs": 1363730,
      "endMs": 1365565
    },
    {
      "index": 313,
      "text": "My patty!",
      "kind": "dialogue",
      "startMs": 1365598,
      "endMs": 1367500
    },
    {
      "index": 314,
      "text": "No!!!",
      "kind": "dialogue",
      "startMs": 1367534,
      "endMs": 1370503
    },
    {
      "index": 315,
      "text": "I'll settle for some fries.",
      "kind": "dialogue",
      "startMs": 1370537,
      "endMs": 1372805
    }
  ],
  "meta": {
    "show": "SpongeBob SquarePants",
    "season": 1,
    "episode": 6
  }
}
