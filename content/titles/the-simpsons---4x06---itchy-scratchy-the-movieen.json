{
  "id": "the-simpsons---4x06---itchy-scratchy-the-movieen",
  "title": "The Simpsons - 4x06 - Itchy & Scratchy  The Movie.en",
  "sourceFilename": "The Simpsons - 4x06 - Itchy & Scratchy  The Movie.en.srt",
  "importedAt": "2026-08-31T04:14:29.496Z",
  "lineCount": 275,
  "lines": [
    {
      "index": 0,
      "text": "[Chorus] ## The Simpsons ##",
      "kind": "dialogue",
      "startMs": 4267,
      "endMs": 7430
    },
    {
      "index": 1,
      "text": "[Bell Ringing]",
      "kind": "sdh",
      "startMs": 18414,
      "endMs": 20848
    },
    {
      "index": 2,
      "text": "[Whistle Blowing]",
      "kind": "sdh",
      "startMs": 25121,
      "endMs": 28056
    },
    {
      "index": 3,
      "text": "[ Beeping ]",
      "kind": "sdh",
      "startMs": 31728,
      "endMs": 33696
    },
    {
      "index": 4,
      "text": "## [Jazzy Solo ]",
      "kind": "dialogue",
      "startMs": 38001,
      "endMs": 40060
    },
    {
      "index": 5,
      "text": "[ Beeping ]",
      "kind": "sdh",
      "startMs": 60156,
      "endMs": 62283
    },
    {
      "index": 6,
      "text": "[ Tires Screeching ]",
      "kind": "sdh",
      "startMs": 62392,
      "endMs": 64360
    },
    {
      "index": 7,
      "text": "D'oh! [ Screams ]",
      "kind": "dialogue",
      "startMs": 65395,
      "endMs": 67363
    },
    {
      "index": 8,
      "text": "[Air Hissing]",
      "kind": "sdh",
      "startMs": 70333,
      "endMs": 73063
    },
    {
      "index": 9,
      "text": "[Captain Kirk] Captain's log. Stardate 6051.",
      "kind": "dialogue",
      "startMs": 84380,
      "endMs": 86473
    },
    {
      "index": 10,
      "text": "Had trouble sleeping last night. My hiatal hernia is acting up.",
      "kind": "dialogue",
      "startMs": 86582,
      "endMs": 90313
    },
    {
      "index": 11,
      "text": "The ship is drafty and damp.",
      "kind": "dialogue",
      "startMs": 90420,
      "endMs": 92513
    },
    {
      "index": 12,
      "text": "I complain, but nobody listens.",
      "kind": "dialogue",
      "startMs": 92622,
      "endMs": 94681
    },
    {
      "index": 13,
      "text": "[Man Announcing] Star Trek XI: So Very Tired.",
      "kind": "dialogue",
      "startMs": 94791,
      "endMs": 99023
    },
    {
      "index": 14,
      "text": "See the original cast in their latest, greatest adventure.",
      "kind": "dialogue",
      "startMs": 99128,
      "endMs": 103656
    },
    {
      "index": 15,
      "text": "Captain, Klingons Off the starboard bow.",
      "kind": "dialogue",
      "startMs": 103766,
      "endMs": 106530
    },
    {
      "index": 16,
      "text": "Again with the Klingons! Mr. Scott, give me full power.",
      "kind": "dialogue",
      "startMs": 106636,
      "endMs": 109696
    },
    {
      "index": 17,
      "text": "It's no good, Captain. I cannot reach the control panel.",
      "kind": "dialogue",
      "startMs": 109806,
      "endMs": 114004
    },
    {
      "index": 18,
      "text": "Movies! What a rip-off!.",
      "kind": "dialogue",
      "startMs": 114110,
      "endMs": 116578
    },
    {
      "index": 19,
      "text": "I don't have to sit here and take this! I--",
      "kind": "dialogue",
      "startMs": 116679,
      "endMs": 119273
    },
    {
      "index": 20,
      "text": "[ Snoring ]",
      "kind": "sdh",
      "startMs": 119382,
      "endMs": 121077
    },
    {
      "index": 21,
      "text": "Hubba hubba. Oh, you kid. Thank you, dear.",
      "kind": "dialogue",
      "startMs": 123553,
      "endMs": 126522
    },
    {
      "index": 22,
      "text": "Now, be good for Grampa while we're at the parent teacher meeting.",
      "kind": "dialogue",
      "startMs": 126622,
      "endMs": 129591
    },
    {
      "index": 23,
      "text": "We'll bring back dinner. What are we gonna have?",
      "kind": "dialogue",
      "startMs": 129692,
      "endMs": 131592
    },
    {
      "index": 24,
      "text": "Well, that depends on what the teachers say.",
      "kind": "dialogue",
      "startMs": 131694,
      "endMs": 134185
    },
    {
      "index": 25,
      "text": "If you've been good, pizza. If you've been bad... uh, let's see-- poison.",
      "kind": "dialogue",
      "startMs": 134297,
      "endMs": 140329
    },
    {
      "index": 26,
      "text": "What if one of us has been good and one of us has been bad?",
      "kind": "dialogue",
      "startMs": 140436,
      "endMs": 142768
    },
    {
      "index": 27,
      "text": "Poisoned pizza. Oh, no. I'm not making two stops.",
      "kind": "dialogue",
      "startMs": 142872,
      "endMs": 147832
    },
    {
      "index": 28,
      "text": "All right. I'll talk to Lisa's teacher this year.",
      "kind": "dialogue",
      "startMs": 147944,
      "endMs": 150970
    },
    {
      "index": 29,
      "text": "You can have Bart's. That's the way we do it every year.",
      "kind": "dialogue",
      "startMs": 151080,
      "endMs": 154015
    },
    {
      "index": 30,
      "text": "All right. Tell you what. I'm thinking Of a number between 1 and 50.",
      "kind": "dialogue",
      "startMs": 154117,
      "endMs": 157644
    },
    {
      "index": 31,
      "text": "Is it 37? D'oh! I mean, no.",
      "kind": "dialogue",
      "startMs": 157754,
      "endMs": 160279
    },
    {
      "index": 32,
      "text": "Homer! - Please, Marge? Please, please, please, please, please?",
      "kind": "dialogue",
      "startMs": 160390,
      "endMs": 163359
    },
    {
      "index": 33,
      "text": "Oh, all right. Whoo-hoo!",
      "kind": "dialogue",
      "startMs": 163459,
      "endMs": 165393
    },
    {
      "index": 34,
      "text": "U.S.A! U.S.A! U.S.A! [Horn Honking]",
      "kind": "dialogue",
      "startMs": 165495,
      "endMs": 169056
    },
    {
      "index": 35,
      "text": "Agh!",
      "kind": "dialogue",
      "startMs": 175371,
      "endMs": 177669
    },
    {
      "index": 36,
      "text": "[ Flatulent Noise ] [ Gasps ]",
      "kind": "dialogue",
      "startMs": 186315,
      "endMs": 189216
    },
    {
      "index": 37,
      "text": "Hee-hee!",
      "kind": "dialogue",
      "startMs": 192155,
      "endMs": 194385
    },
    {
      "index": 38,
      "text": "Bart has been guilty Of the following atrocities-- synthesizing a laxative from peas and carrots... replacing my birth control pills with Tic Tacs.",
      "kind": "dialogue",
      "startMs": 201697,
      "endMs": 211567
    },
    {
      "index": 39,
      "text": "Well, I'm sorry. I'm sure Bart doesn't really mean to be bad.",
      "kind": "dialogue",
      "startMs": 211674,
      "endMs": 217408
    },
    {
      "index": 40,
      "text": "[ Snoring ] Now's our chance to be bad. [ Chuckles ] Mr. Simpson, I just wanted to tell you... that you've done a wonderful job with Lisa.",
      "kind": "dialogue",
      "startMs": 217513,
      "endMs": 225951
    },
    {
      "index": 41,
      "text": "You must have read to her at a young age. I did.",
      "kind": "dialogue",
      "startMs": 226055,
      "endMs": 229183
    },
    {
      "index": 42,
      "text": "I did read to her.",
      "kind": "dialogue",
      "startMs": 229292,
      "endMs": 231920
    },
    {
      "index": 43,
      "text": "\"8:00. Happy Days.",
      "kind": "dialogue",
      "startMs": 232028,
      "endMs": 233928
    },
    {
      "index": 44,
      "text": "\"The Fonz, Henry Winkler... is worried he's losing his cool.\"",
      "kind": "dialogue",
      "startMs": 234030,
      "endMs": 239399
    },
    {
      "index": 45,
      "text": "Well, I've always been a firm believer in the three \"Rs\"-- reading TV Guide, um... writing to TV Guide and renewing TV Guide.",
      "kind": "dialogue",
      "startMs": 239502,
      "endMs": 248974
    },
    {
      "index": 46,
      "text": "Now, we don't usually do this, but we have some witnesses. Come in, Arthur.",
      "kind": "dialogue",
      "startMs": 249078,
      "endMs": 254675
    },
    {
      "index": 47,
      "text": "Now, where did Bart stick the fireworks?",
      "kind": "dialogue",
      "startMs": 256252,
      "endMs": 260746
    },
    {
      "index": 48,
      "text": "[ Gasps ] [ Snoring ]",
      "kind": "dialogue",
      "startMs": 260857,
      "endMs": 263553
    },
    {
      "index": 49,
      "text": "Over the lips and past the gums-- look out dentures, here I come.",
      "kind": "dialogue",
      "startMs": 265294,
      "endMs": 268957
    },
    {
      "index": 50,
      "text": "Ew! [ Growls ]",
      "kind": "dialogue",
      "startMs": 271634,
      "endMs": 274364
    },
    {
      "index": 51,
      "text": "[ Chuckles ] [ Growls ]",
      "kind": "dialogue",
      "startMs": 274470,
      "endMs": 278201
    },
    {
      "index": 52,
      "text": "\"My child is on the honor roll at Springfield Elementary.\"",
      "kind": "dialogue",
      "startMs": 279976,
      "endMs": 283571
    },
    {
      "index": 53,
      "text": "You know, I never thought I'd find a replacement... for my \"Where's the Beef?\" bumper sticker.",
      "kind": "dialogue",
      "startMs": 283679,
      "endMs": 288977
    },
    {
      "index": 54,
      "text": "[ Chuckles ] \"Where's the Beef?\"",
      "kind": "dialogue",
      "startMs": 289085,
      "endMs": 290985
    },
    {
      "index": 55,
      "text": "Uh, we'd like the desk back, Mr. Simpson.",
      "kind": "dialogue",
      "startMs": 291087,
      "endMs": 293385
    },
    {
      "index": 56,
      "text": "Huh? [ Chuckles ] Oh.",
      "kind": "dialogue",
      "startMs": 293489,
      "endMs": 296481
    },
    {
      "index": 57,
      "text": "## [ Lively]",
      "kind": "dialogue",
      "startMs": 297760,
      "endMs": 300524
    },
    {
      "index": 58,
      "text": "Yaah!",
      "kind": "dialogue",
      "startMs": 305501,
      "endMs": 307469
    },
    {
      "index": 59,
      "text": "I really don't see how this helps Bart.",
      "kind": "dialogue",
      "startMs": 309405,
      "endMs": 311930
    },
    {
      "index": 60,
      "text": "-Just do it. [ Groans ]",
      "kind": "dialogue",
      "startMs": 312041,
      "endMs": 314407
    },
    {
      "index": 61,
      "text": "Busted! Homer, we have a problem here.",
      "kind": "dialogue",
      "startMs": 314510,
      "endMs": 317877
    },
    {
      "index": 62,
      "text": "Are you kidding? Lisa turned out perfect.",
      "kind": "dialogue",
      "startMs": 317980,
      "endMs": 320778
    },
    {
      "index": 63,
      "text": "I won't stand here and listen To you bad-mouthing Lisa!",
      "kind": "dialogue",
      "startMs": 320883,
      "endMs": 323317
    },
    {
      "index": 64,
      "text": "We're talking about Bart! Oh. That guy.",
      "kind": "dialogue",
      "startMs": 323419,
      "endMs": 326786
    },
    {
      "index": 65,
      "text": "I think the problem here is discipline.",
      "kind": "dialogue",
      "startMs": 326889,
      "endMs": 329153
    },
    {
      "index": 66,
      "text": "If Bart does something wrong, you should punish him. - Well, we try.",
      "kind": "dialogue",
      "startMs": 329258,
      "endMs": 333695
    },
    {
      "index": 67,
      "text": "But he has this way ofmaking us think we've punished him... when actually we've completely caved in.",
      "kind": "dialogue",
      "startMs": 333796,
      "endMs": 338562
    },
    {
      "index": 68,
      "text": "He's the boy you love to hate. Well, you've got to start being firm with him.",
      "kind": "dialogue",
      "startMs": 338668,
      "endMs": 342604
    },
    {
      "index": 69,
      "text": "I believe, with persistent discipline... even the poorest student can end up becoming, oh, say... chief justice of the Supreme Court.",
      "kind": "dialogue",
      "startMs": 342705,
      "endMs": 350538
    },
    {
      "index": 70,
      "text": "Chief justice Of the Supreme Court.",
      "kind": "dialogue",
      "startMs": 350646,
      "endMs": 352978
    },
    {
      "index": 71,
      "text": "What great men he would join-- john Marshall...",
      "kind": "dialogue",
      "startMs": 353082,
      "endMs": 356745
    },
    {
      "index": 72,
      "text": "Charles Evans Hughes, Warren Berger-- Mmm, burger.",
      "kind": "dialogue",
      "startMs": 356852,
      "endMs": 362920
    },
    {
      "index": 73,
      "text": "And what if we don't? Then there's no telling how low he can sink.",
      "kind": "dialogue",
      "startMs": 363025,
      "endMs": 368156
    },
    {
      "index": 74,
      "text": "[Man] All right, ladies.",
      "kind": "dialogue",
      "startMs": 368264,
      "endMs": 370164
    },
    {
      "index": 75,
      "text": "Prepare to be blownaway By Bang Bang Bart.",
      "kind": "dialogue",
      "startMs": 370266,
      "endMs": 373292
    },
    {
      "index": 76,
      "text": "#### [Dance] [ Pistols Firing ]",
      "kind": "dialogue",
      "startMs": 373402,
      "endMs": 376633
    },
    {
      "index": 77,
      "text": "[ All Booing ]",
      "kind": "sdh",
      "startMs": 376739,
      "endMs": 380800
    },
    {
      "index": 78,
      "text": "You're fat! -Just more of me to love, honey.",
      "kind": "dialogue",
      "startMs": 380910,
      "endMs": 384846
    },
    {
      "index": 79,
      "text": "[ Booing Continues ] [ Groaning ] Oh! My poor baby!",
      "kind": "dialogue",
      "startMs": 384947,
      "endMs": 391280
    },
    {
      "index": 80,
      "text": "[Car Tires Screech]",
      "kind": "sdh",
      "startMs": 395091,
      "endMs": 397116
    },
    {
      "index": 81,
      "text": "[Car Doors Shut] Uh-oh.",
      "kind": "dialogue",
      "startMs": 397226,
      "endMs": 399126
    },
    {
      "index": 82,
      "text": "What? What's that?",
      "kind": "dialogue",
      "startMs": 409338,
      "endMs": 412330
    },
    {
      "index": 83,
      "text": "Hi, Mom. Hi, Dad. Home already? [ Muttering ] Boy, time really flies when you're reading-- The Bible? Ew.",
      "kind": "dialogue",
      "startMs": 412441,
      "endMs": 420879
    },
    {
      "index": 84,
      "text": "Well, we brought some pizza. [ Exclaiming, Indistinct ] If you don't start making more sense, we're gonna have to put you in a home.",
      "kind": "dialogue",
      "startMs": 420983,
      "endMs": 427954
    },
    {
      "index": 85,
      "text": "You already put me in a home.",
      "kind": "dialogue",
      "startMs": 429191,
      "endMs": 431091
    },
    {
      "index": 86,
      "text": "Then we'll put you in the crooked home we saw on 60Minutes.",
      "kind": "dialogue",
      "startMs": 431193,
      "endMs": 433684
    },
    {
      "index": 87,
      "text": "I'll be good.",
      "kind": "dialogue",
      "startMs": 433796,
      "endMs": 436560
    },
    {
      "index": 88,
      "text": "Look what your bad egg Of a son did to my teeth!",
      "kind": "dialogue",
      "startMs": 436666,
      "endMs": 438827
    },
    {
      "index": 89,
      "text": "Dad, you and your stories. \"Bart broke my teeth.\"",
      "kind": "dialogue",
      "startMs": 438934,
      "endMs": 442768
    },
    {
      "index": 90,
      "text": "\"The nurses are stealing my money.\" \"This thing on my neck is getting bigger.\"",
      "kind": "dialogue",
      "startMs": 442872,
      "endMs": 446433
    },
    {
      "index": 91,
      "text": "Now, this is exactly what Bart's teacher was talking about.",
      "kind": "dialogue",
      "startMs": 446542,
      "endMs": 449875
    },
    {
      "index": 92,
      "text": "Our son did something wrong, and you look the other way.",
      "kind": "dialogue",
      "startMs": 449979,
      "endMs": 453312
    },
    {
      "index": 93,
      "text": "But, Marge, look at that hangdog expression.",
      "kind": "dialogue",
      "startMs": 453416,
      "endMs": 455907
    },
    {
      "index": 94,
      "text": "He's learned his lesson.",
      "kind": "dialogue",
      "startMs": 456018,
      "endMs": 458316
    },
    {
      "index": 95,
      "text": "Let's get him a present. [ Groans ]",
      "kind": "dialogue",
      "startMs": 458421,
      "endMs": 460981
    },
    {
      "index": 96,
      "text": "Please, Homer. Why do I always have to be the bad guy? - All right, all right.",
      "kind": "dialogue",
      "startMs": 461090,
      "endMs": 465424
    },
    {
      "index": 97,
      "text": "Young man, since you broke Grampa's teeth, he gets to break yours.",
      "kind": "dialogue",
      "startMs": 465528,
      "endMs": 469897
    },
    {
      "index": 98,
      "text": "Oh, this is gonna be sweet.",
      "kind": "dialogue",
      "startMs": 469999,
      "endMs": 471967
    },
    {
      "index": 99,
      "text": "No, no, no! Ohh.",
      "kind": "dialogue",
      "startMs": 472068,
      "endMs": 474400
    },
    {
      "index": 100,
      "text": "Bart, we're sending you to bed without your supper.",
      "kind": "dialogue",
      "startMs": 474503,
      "endMs": 477233
    },
    {
      "index": 101,
      "text": "Yeah, right. Like you're gonna let me go hungry.",
      "kind": "dialogue",
      "startMs": 477340,
      "endMs": 479570
    },
    {
      "index": 102,
      "text": "I'll be eating that pizza in five minutes.",
      "kind": "dialogue",
      "startMs": 479675,
      "endMs": 482007
    },
    {
      "index": 103,
      "text": "Bart, stop being confident. [Grampa] Doggoneit!",
      "kind": "dialogue",
      "startMs": 482111,
      "endMs": 484409
    },
    {
      "index": 104,
      "text": "Ohh. Oh, Grampa.",
      "kind": "dialogue",
      "startMs": 484513,
      "endMs": 487812
    },
    {
      "index": 105,
      "text": "I'm starving! Somebody bring me some food quick!",
      "kind": "dialogue",
      "startMs": 491420,
      "endMs": 495049
    },
    {
      "index": 106,
      "text": "I'm a-comin', boy! [Marge]Homer, get back here!",
      "kind": "dialogue",
      "startMs": 495157,
      "endMs": 500652
    },
    {
      "index": 107,
      "text": "There must be something to eat around here.",
      "kind": "dialogue",
      "startMs": 500763,
      "endMs": 504164
    },
    {
      "index": 108,
      "text": "[ Whimpering ] Hmm.",
      "kind": "dialogue",
      "startMs": 504266,
      "endMs": 507360
    },
    {
      "index": 109,
      "text": "[ Panting ] [ Yelps ]",
      "kind": "dialogue",
      "startMs": 515344,
      "endMs": 517244
    },
    {
      "index": 110,
      "text": "Gee, maybe they mean it this time.",
      "kind": "dialogue",
      "startMs": 522084,
      "endMs": 524712
    },
    {
      "index": 111,
      "text": "From now on, I guess I'd better straighten up and fly-- - [Homer]Bart.",
      "kind": "dialogue",
      "startMs": 524820,
      "endMs": 528551
    },
    {
      "index": 112,
      "text": "Don't tell your mother, but I brought you some pizza. just promise me you'll try to be good.",
      "kind": "dialogue",
      "startMs": 528657,
      "endMs": 533556
    },
    {
      "index": 113,
      "text": "I promise. That-a-boy.",
      "kind": "dialogue",
      "startMs": 533662,
      "endMs": 536597
    },
    {
      "index": 114,
      "text": "[ Chuckling ] Sucker.",
      "kind": "dialogue",
      "startMs": 539568,
      "endMs": 541502
    },
    {
      "index": 115,
      "text": "[ Pistol Cocks ] Well, well.",
      "kind": "dialogue",
      "startMs": 545941,
      "endMs": 549308
    },
    {
      "index": 116,
      "text": "If it isn't the tooth fairy.",
      "kind": "dialogue",
      "startMs": 549412,
      "endMs": 552347
    },
    {
      "index": 117,
      "text": "[ Man ] Coming for Christmas, The Itchy and Scratchy Movie.",
      "kind": "dialogue",
      "startMs": 555084,
      "endMs": 559316
    },
    {
      "index": 118,
      "text": "[ Laughing Maniacally]",
      "kind": "sdh",
      "startMs": 568898,
      "endMs": 571833
    },
    {
      "index": 119,
      "text": "[ Gasps ] Bart!",
      "kind": "dialogue",
      "startMs": 571934,
      "endMs": 573925
    },
    {
      "index": 120,
      "text": "Stick around, Mr. Bond.",
      "kind": "dialogue",
      "startMs": 574036,
      "endMs": 577335
    },
    {
      "index": 121,
      "text": "Things are really starting to cook.",
      "kind": "dialogue",
      "startMs": 577440,
      "endMs": 581035
    },
    {
      "index": 122,
      "text": "[Chuckling Evilly]",
      "kind": "sdh",
      "startMs": 581143,
      "endMs": 584044
    },
    {
      "index": 123,
      "text": "[Lisa]Bart, come quick! There's an Itchy and Scratchy movie!",
      "kind": "dialogue",
      "startMs": 584146,
      "endMs": 586376
    },
    {
      "index": 124,
      "text": "[ Gasps ]",
      "kind": "sdh",
      "startMs": 586482,
      "endMs": 589349
    },
    {
      "index": 125,
      "text": "[ Man ] If you want suspense--",
      "kind": "dialogue",
      "startMs": 589452,
      "endMs": 592319
    },
    {
      "index": 126,
      "text": "[ Screaming ]",
      "kind": "sdh",
      "startMs": 600129,
      "endMs": 602029
    },
    {
      "index": 127,
      "text": "romance--",
      "kind": "dialogue",
      "startMs": 602131,
      "endMs": 604099
    },
    {
      "index": 128,
      "text": "Mmm!",
      "kind": "dialogue",
      "startMs": 605901,
      "endMs": 607869
    },
    {
      "index": 129,
      "text": "you'll find it in The Itchy and Scratchy Movie... coming soon to a theater near you.",
      "kind": "dialogue",
      "startMs": 612675,
      "endMs": 617341
    },
    {
      "index": 130,
      "text": "Fifty-three percent new footage. Wow.",
      "kind": "dialogue",
      "startMs": 617446,
      "endMs": 620574
    },
    {
      "index": 131,
      "text": "Bart, did you take out the garbage like I asked? Indeed I did.",
      "kind": "dialogue",
      "startMs": 620683,
      "endMs": 624619
    },
    {
      "index": 132,
      "text": "-[Goats Bleating] D'oh!",
      "kind": "dialogue",
      "startMs": 624720,
      "endMs": 627348
    },
    {
      "index": 133,
      "text": "Hey, you goats get out of here! [ Hissing ] Boy, you're gonna have to be punished for this.",
      "kind": "dialogue",
      "startMs": 627456,
      "endMs": 632991
    },
    {
      "index": 134,
      "text": "Dad, you could punish me.",
      "kind": "dialogue",
      "startMs": 633095,
      "endMs": 635655
    },
    {
      "index": 135,
      "text": "But that means you have to think of a punishment... sit here and make sure I do it--",
      "kind": "dialogue",
      "startMs": 635764,
      "endMs": 640293
    },
    {
      "index": 136,
      "text": "Ohh. Or you could let me go play with Milhouse... while you spend the afternoon watching unpredictable Mexican sitcoms.",
      "kind": "dialogue",
      "startMs": 640402,
      "endMs": 647673
    },
    {
      "index": 137,
      "text": "�Ay, elest�mago!",
      "kind": "dialogue",
      "startMs": 650112,
      "endMs": 652478
    },
    {
      "index": 138,
      "text": "[ Chuckles ] Run along, you little scamp.",
      "kind": "dialogue",
      "startMs": 652581,
      "endMs": 655414
    },
    {
      "index": 139,
      "text": "[ Gasps ] Huh?",
      "kind": "dialogue",
      "startMs": 663592,
      "endMs": 665526
    },
    {
      "index": 140,
      "text": "[ Chuckling ]",
      "kind": "sdh",
      "startMs": 665628,
      "endMs": 667528
    },
    {
      "index": 141,
      "text": "####[Singing] Bart! Why are you doing that?",
      "kind": "dialogue",
      "startMs": 669298,
      "endMs": 675866
    },
    {
      "index": 142,
      "text": "I don't know. Well, this time you must be punished!",
      "kind": "dialogue",
      "startMs": 675971,
      "endMs": 679099
    },
    {
      "index": 143,
      "text": "Well, you could punish me, but-- No tricks, boy. I said I'm gonna punish you.",
      "kind": "dialogue",
      "startMs": 679208,
      "endMs": 684469
    },
    {
      "index": 144,
      "text": "And come hell or high water, I--",
      "kind": "dialogue",
      "startMs": 684580,
      "endMs": 686775
    },
    {
      "index": 145,
      "text": "####[Faint] Wait a minute!",
      "kind": "dialogue",
      "startMs": 686882,
      "endMs": 689077
    },
    {
      "index": 146,
      "text": "[ Gasps ] Ice cream truck!",
      "kind": "dialogue",
      "startMs": 689184,
      "endMs": 691948
    },
    {
      "index": 147,
      "text": "[ All Clamoring ]",
      "kind": "sdh",
      "startMs": 693622,
      "endMs": 696785
    },
    {
      "index": 148,
      "text": "Me! Me! I was here first!",
      "kind": "dialogue",
      "startMs": 696892,
      "endMs": 698860
    },
    {
      "index": 149,
      "text": "Mmm. Now, what were we talking about, boy?",
      "kind": "dialogue",
      "startMs": 700596,
      "endMs": 703963
    },
    {
      "index": 150,
      "text": "Uh, we were talking about the time you beat jury duty.",
      "kind": "dialogue",
      "startMs": 704066,
      "endMs": 708400
    },
    {
      "index": 151,
      "text": "Oh, yeah. The trick is... to say you're prejudiced against all races.",
      "kind": "dialogue",
      "startMs": 708504,
      "endMs": 714175
    },
    {
      "index": 152,
      "text": "We're home! We got beets!",
      "kind": "dialogue",
      "startMs": 717146,
      "endMs": 720274
    },
    {
      "index": 153,
      "text": "Bart, are you pulling up the carpet? Uh-huh.",
      "kind": "dialogue",
      "startMs": 720382,
      "endMs": 723283
    },
    {
      "index": 154,
      "text": "Why are you letting him do this? I don't know.",
      "kind": "dialogue",
      "startMs": 723385,
      "endMs": 726320
    },
    {
      "index": 155,
      "text": "Well, punish him. All right, all right. Bart, go toyour room.",
      "kind": "dialogue",
      "startMs": 726422,
      "endMs": 729448
    },
    {
      "index": 156,
      "text": "See you in the funny pages.",
      "kind": "dialogue",
      "startMs": 729558,
      "endMs": 731617
    },
    {
      "index": 157,
      "text": "How could you let this happen? How could you let this happen?",
      "kind": "dialogue",
      "startMs": 731727,
      "endMs": 734787
    },
    {
      "index": 158,
      "text": "I wasn't here. Oh, how convenient.",
      "kind": "dialogue",
      "startMs": 734897,
      "endMs": 738458
    },
    {
      "index": 159,
      "text": "Homer, do you want your son to become Chief justice of the Supreme Court... or a sleazy male stripper?",
      "kind": "dialogue",
      "startMs": 738567,
      "endMs": 744932
    },
    {
      "index": 160,
      "text": "Can't he be both, like the late Earl Warren?",
      "kind": "dialogue",
      "startMs": 745040,
      "endMs": 747235
    },
    {
      "index": 161,
      "text": "Earl Warren wasn't a stripper. Now who's being naive?",
      "kind": "dialogue",
      "startMs": 747343,
      "endMs": 750744
    },
    {
      "index": 162,
      "text": "Look, you have to help discipline your son. All right, Marge.",
      "kind": "dialogue",
      "startMs": 750846,
      "endMs": 754338
    },
    {
      "index": 163,
      "text": "I swear to you-- the next time he does something wrong, I'll punish him and make it stick.",
      "kind": "dialogue",
      "startMs": 754450,
      "endMs": 760389
    },
    {
      "index": 164,
      "text": "[ Kent Brockman ] Tonight on Eye on Springfield... we meet a man who's been hiccupping for 45 years.",
      "kind": "dialogue",
      "startMs": 760489,
      "endMs": 765792
    },
    {
      "index": 165,
      "text": "[ Hiccups ] Kill me. [ Hiccups ] Kill me.",
      "kind": "dialogue",
      "startMs": 765894,
      "endMs": 768624
    },
    {
      "index": 166,
      "text": "But first, we'll examine the growing Itchy and Scratchy mania... with their new movie premiering today.",
      "kind": "dialogue",
      "startMs": 768731,
      "endMs": 773459
    },
    {
      "index": 167,
      "text": "I got my ticket.",
      "kind": "dialogue",
      "startMs": 773569,
      "endMs": 775730
    },
    {
      "index": 168,
      "text": "[ Kent Brockman ] I'm here live in Korea... to give you a firsthand look at how American cartoons are made.",
      "kind": "dialogue",
      "startMs": 775838,
      "endMs": 781599
    },
    {
      "index": 169,
      "text": "But first, let's take a look back at the year 1 928... a year when you might have seen Al Capone... dancing the Charleston on top of a flagpole.",
      "kind": "dialogue",
      "startMs": 781710,
      "endMs": 790344
    },
    {
      "index": 170,
      "text": "## [ Fast Jazz ] Yaah!",
      "kind": "dialogue",
      "startMs": 790452,
      "endMs": 795856
    },
    {
      "index": 171,
      "text": "It was also the year Of the very first Scratchy cartoon... entitled \"That Happy Cat.\"",
      "kind": "dialogue",
      "startMs": 795958,
      "endMs": 801888
    },
    {
      "index": 172,
      "text": "## [ Orchestra ]",
      "kind": "dialogue",
      "startMs": 801997,
      "endMs": 803965
    },
    {
      "index": 173,
      "text": "## [ Whistling Along ]",
      "kind": "dialogue",
      "startMs": 807870,
      "endMs": 810839
    },
    {
      "index": 174,
      "text": "The film did very poorly.",
      "kind": "dialogue",
      "startMs": 815310,
      "endMs": 817210
    },
    {
      "index": 175,
      "text": "But the following year, Scratchy was teamed up with a psychotic young mouse named Itchy... and cartoon history was made.",
      "kind": "dialogue",
      "startMs": 817312,
      "endMs": 823943
    },
    {
      "index": 176,
      "text": "Here's their first cartoon together-- \"Steamboat Itchy.\"",
      "kind": "dialogue",
      "startMs": 824053,
      "endMs": 828422
    },
    {
      "index": 177,
      "text": "## [ Whistling ]",
      "kind": "dialogue",
      "startMs": 828524,
      "endMs": 830492
    },
    {
      "index": 178,
      "text": "[ Whistle Sounds ] [ Horn Tooting ]",
      "kind": "dialogue",
      "startMs": 832061,
      "endMs": 835030
    },
    {
      "index": 179,
      "text": "## [ Whistling ]",
      "kind": "dialogue",
      "startMs": 839068,
      "endMs": 841468
    },
    {
      "index": 180,
      "text": "[ Screaming ]",
      "kind": "sdh",
      "startMs": 844907,
      "endMs": 847137
    },
    {
      "index": 181,
      "text": "[ Screaming ] [ Chuckling ]",
      "kind": "dialogue",
      "startMs": 852815,
      "endMs": 855750
    },
    {
      "index": 182,
      "text": "Oh, me, oh, my.",
      "kind": "dialogue",
      "startMs": 859221,
      "endMs": 861883
    },
    {
      "index": 183,
      "text": "## [ Fanfare ] [ Laughing ] During the war, Itchy and Scratchy put their differences aside... and teamed up to fight a bigger foe.",
      "kind": "dialogue",
      "startMs": 861990,
      "endMs": 871430
    },
    {
      "index": 184,
      "text": "## [ Patriotic ]",
      "kind": "dialogue",
      "startMs": 874837,
      "endMs": 878864
    },
    {
      "index": 185,
      "text": "We'll be back with a real-life Itchy and Scratchy-- a rabid mouse in Boston who attacked and killed... a small cat. [ Chuckling ]",
      "kind": "dialogue",
      "startMs": 888650,
      "endMs": 896614
    },
    {
      "index": 186,
      "text": "Bart, didn't I ask you to watch Maggie?",
      "kind": "dialogue",
      "startMs": 899294,
      "endMs": 901558
    },
    {
      "index": 187,
      "text": "Sounds like something you'd say. Hey, where is she?",
      "kind": "dialogue",
      "startMs": 901663,
      "endMs": 904791
    },
    {
      "index": 188,
      "text": "Oh, my Lord!",
      "kind": "dialogue",
      "startMs": 915277,
      "endMs": 917438
    },
    {
      "index": 189,
      "text": "Oh, isn't that cute. A baby driving a car.",
      "kind": "dialogue",
      "startMs": 918614,
      "endMs": 923176
    },
    {
      "index": 190,
      "text": "And look. There's a dog driving a bus.",
      "kind": "dialogue",
      "startMs": 923285,
      "endMs": 925913
    },
    {
      "index": 191,
      "text": "Hey!",
      "kind": "dialogue",
      "startMs": 927523,
      "endMs": 929616
    },
    {
      "index": 192,
      "text": "[Alarm Sounding]",
      "kind": "sdh",
      "startMs": 939301,
      "endMs": 941292
    },
    {
      "index": 193,
      "text": "All right! Time for a crime spree.",
      "kind": "dialogue",
      "startMs": 941403,
      "endMs": 945533
    },
    {
      "index": 194,
      "text": "All right, boy. This calls for the biggest punishment I ever handed down... and this time it's gonna stick.",
      "kind": "dialogue",
      "startMs": 947476,
      "endMs": 953413
    },
    {
      "index": 195,
      "text": "Come on, Homer. This isn't funny. Damn right!",
      "kind": "dialogue",
      "startMs": 953515,
      "endMs": 956507
    },
    {
      "index": 196,
      "text": "Bart, you can't go to see that Itchy and Scratchy movie ever!",
      "kind": "dialogue",
      "startMs": 956618,
      "endMs": 961317
    },
    {
      "index": 197,
      "text": "[ Gasps ]",
      "kind": "sdh",
      "startMs": 961423,
      "endMs": 963414
    },
    {
      "index": 198,
      "text": "[ Groans ]",
      "kind": "sdh",
      "startMs": 968130,
      "endMs": 970530
    },
    {
      "index": 199,
      "text": "Oh, no! Beta!",
      "kind": "dialogue",
      "startMs": 970632,
      "endMs": 974432
    },
    {
      "index": 200,
      "text": "Dad, you gotta let me see that movie.",
      "kind": "dialogue",
      "startMs": 976505,
      "endMs": 979201
    },
    {
      "index": 201,
      "text": "Can't you just give me a spanking?",
      "kind": "dialogue",
      "startMs": 979308,
      "endMs": 981435
    },
    {
      "index": 202,
      "text": "Come on. Go nuts.",
      "kind": "dialogue",
      "startMs": 981543,
      "endMs": 983443
    },
    {
      "index": 203,
      "text": "Don't point that thing at me. I said you're not going to the movie, and I'm sticking to it.",
      "kind": "dialogue",
      "startMs": 983545,
      "endMs": 988005
    },
    {
      "index": 204,
      "text": "Dad, I agree that Bart should be punished... but The Itchy and Scratchy Movie is the defining event of our generation.",
      "kind": "dialogue",
      "startMs": 988116,
      "endMs": 993751
    },
    {
      "index": 205,
      "text": "How would you've liked it if someone told you That you couldn't watch the moon landing?",
      "kind": "dialogue",
      "startMs": 993856,
      "endMs": 997587
    },
    {
      "index": 206,
      "text": "Hmm.",
      "kind": "dialogue",
      "startMs": 997693,
      "endMs": 999593
    },
    {
      "index": 207,
      "text": "That's one small step for man.",
      "kind": "dialogue",
      "startMs": 999695,
      "endMs": 1002255
    },
    {
      "index": 208,
      "text": "One giant leap for mankind.",
      "kind": "dialogue",
      "startMs": 1002364,
      "endMs": 1005925
    },
    {
      "index": 209,
      "text": "[ Sniffles ]",
      "kind": "sdh",
      "startMs": 1006034,
      "endMs": 1007934
    },
    {
      "index": 210,
      "text": "## [ Singing Pop ]",
      "kind": "dialogue",
      "startMs": 1008036,
      "endMs": 1011028
    },
    {
      "index": 211,
      "text": "## [ Singing Continues ]",
      "kind": "dialogue",
      "startMs": 1014009,
      "endMs": 1016807
    },
    {
      "index": 212,
      "text": "Sorry, but the punishment stands.",
      "kind": "dialogue",
      "startMs": 1019715,
      "endMs": 1022479
    },
    {
      "index": 213,
      "text": "I regret nothing!",
      "kind": "dialogue",
      "startMs": 1030626,
      "endMs": 1033652
    },
    {
      "index": 214,
      "text": "[ Groans ]",
      "kind": "sdh",
      "startMs": 1038333,
      "endMs": 1040267
    },
    {
      "index": 215,
      "text": "Someday you'll thank me for this, son. Not bloody likely.",
      "kind": "dialogue",
      "startMs": 1040369,
      "endMs": 1043770
    },
    {
      "index": 216,
      "text": "No, it's true. You know, when I was a boy...",
      "kind": "dialogue",
      "startMs": 1043872,
      "endMs": 1046932
    },
    {
      "index": 217,
      "text": "I really wanted a catcher's mitt, but my dad wouldn't get it for me.",
      "kind": "dialogue",
      "startMs": 1047042,
      "endMs": 1050944
    },
    {
      "index": 218,
      "text": "So I held my breath until I passed out and banged my head on the coffee table.",
      "kind": "dialogue",
      "startMs": 1051046,
      "endMs": 1055506
    },
    {
      "index": 219,
      "text": "The doctor thought I might have brain damage.",
      "kind": "dialogue",
      "startMs": 1055617,
      "endMs": 1057847
    },
    {
      "index": 220,
      "text": "Dad, what's the point of this story? I like stories.",
      "kind": "dialogue",
      "startMs": 1057953,
      "endMs": 1061480
    },
    {
      "index": 221,
      "text": "Can I please go to the movie?",
      "kind": "dialogue",
      "startMs": 1061590,
      "endMs": 1063455
    },
    {
      "index": 222,
      "text": "I know my punishment might seem a little harsh, but I can't go back on it.",
      "kind": "dialogue",
      "startMs": 1063558,
      "endMs": 1067517
    },
    {
      "index": 223,
      "text": "You're welcome to watch anything you want on TV. - TV sucks.",
      "kind": "dialogue",
      "startMs": 1067629,
      "endMs": 1071725
    },
    {
      "index": 224,
      "text": "I know you're upset right now, so I'll pretend you didn't say that!",
      "kind": "dialogue",
      "startMs": 1071833,
      "endMs": 1075735
    },
    {
      "index": 225,
      "text": "[ Man On TV] The master craftsman can make three mailboxes an hour.",
      "kind": "dialogue",
      "startMs": 1075837,
      "endMs": 1079796
    },
    {
      "index": 226,
      "text": "I'm not licked yet. I can entertain myself.",
      "kind": "dialogue",
      "startMs": 1079908,
      "endMs": 1082536
    },
    {
      "index": 227,
      "text": "No matter how good a movie is, it can't compare... to the imagination of a small boy.",
      "kind": "dialogue",
      "startMs": 1082644,
      "endMs": 1088373
    },
    {
      "index": 228,
      "text": "[ Groans ]",
      "kind": "sdh",
      "startMs": 1098860,
      "endMs": 1100828
    },
    {
      "index": 229,
      "text": "How was it? It wasn't that great.",
      "kind": "dialogue",
      "startMs": 1100929,
      "endMs": 1103830
    },
    {
      "index": 230,
      "text": "Be honest. It was the greatest movie I've ever seen in my life!",
      "kind": "dialogue",
      "startMs": 1103932,
      "endMs": 1107766
    },
    {
      "index": 231,
      "text": "And you wouldn't believe the celebrities who did cameos-- Dustin Hoffman, Michael Jackson-- Of course, they didn't use their real names, But you could tell it was them.",
      "kind": "dialogue",
      "startMs": 1107869,
      "endMs": 1115834
    },
    {
      "index": 232,
      "text": "Lisa! Sorry, Bart.",
      "kind": "dialogue",
      "startMs": 1115944,
      "endMs": 1118469
    },
    {
      "index": 233,
      "text": "It's just not the same.",
      "kind": "dialogue",
      "startMs": 1122784,
      "endMs": 1125150
    },
    {
      "index": 234,
      "text": "I've seen The Itchy and Scratchy Movie 13 times.",
      "kind": "dialogue",
      "startMs": 1127155,
      "endMs": 1130886
    },
    {
      "index": 235,
      "text": "I've seen it 17 times.",
      "kind": "dialogue",
      "startMs": 1130993,
      "endMs": 1133427
    },
    {
      "index": 236,
      "text": "You guys must be getting pretty tired of that movie by now.",
      "kind": "dialogue",
      "startMs": 1133528,
      "endMs": 1136326
    },
    {
      "index": 237,
      "text": "No one who saw the movie would say that! Let's get him!",
      "kind": "dialogue",
      "startMs": 1136431,
      "endMs": 1141266
    },
    {
      "index": 238,
      "text": "[ Screams ]",
      "kind": "sdh",
      "startMs": 1141370,
      "endMs": 1143861
    },
    {
      "index": 239,
      "text": "Homer, we'd like to talk to you.",
      "kind": "dialogue",
      "startMs": 1145374,
      "endMs": 1147501
    },
    {
      "index": 240,
      "text": "But then I won't be watching TV. You can see the bind I'm in.",
      "kind": "dialogue",
      "startMs": 1147609,
      "endMs": 1150840
    },
    {
      "index": 241,
      "text": "Dad, you've gotta let Bart see that movie. I've never seen him like this.",
      "kind": "dialogue",
      "startMs": 1150946,
      "endMs": 1154473
    },
    {
      "index": 242,
      "text": "He has the demented melancholia Of a Tennessee Williams heroine.",
      "kind": "dialogue",
      "startMs": 1154583,
      "endMs": 1158144
    },
    {
      "index": 243,
      "text": "Don't you think I know that? Well, it's been two months.",
      "kind": "dialogue",
      "startMs": 1158253,
      "endMs": 1161586
    },
    {
      "index": 244,
      "text": "You laid down the law, and I'm proud of you.",
      "kind": "dialogue",
      "startMs": 1161690,
      "endMs": 1164488
    },
    {
      "index": 245,
      "text": "But I think we've gotten through to him. Ah, sweet, softhearted Marge.",
      "kind": "dialogue",
      "startMs": 1164593,
      "endMs": 1168689
    },
    {
      "index": 246,
      "text": "You just can't see the big picture.",
      "kind": "dialogue",
      "startMs": 1168797,
      "endMs": 1170822
    },
    {
      "index": 247,
      "text": "If I stick to my guns, the boy could wind up... chief justice of the Supreme Court.",
      "kind": "dialogue",
      "startMs": 1170932,
      "endMs": 1176034
    },
    {
      "index": 248,
      "text": "If I fail, the best he could do... is judge at a Mr. Tight Buns competition.",
      "kind": "dialogue",
      "startMs": 1176138,
      "endMs": 1181042
    },
    {
      "index": 249,
      "text": "I can't let that happen. I won't let that happen. And I can't let that happen.",
      "kind": "dialogue",
      "startMs": 1181143,
      "endMs": 1185807
    },
    {
      "index": 250,
      "text": "One for Itchy and Scratchy.",
      "kind": "dialogue",
      "startMs": 1191586,
      "endMs": 1196387
    },
    {
      "index": 251,
      "text": "We promised your dad we wouldn't. [ Groans ]",
      "kind": "dialogue",
      "startMs": 1196491,
      "endMs": 1200222
    },
    {
      "index": 252,
      "text": "I'm here at the Springfield Aztec Theater... where, after eight months and nine Academy Awards...",
      "kind": "dialogue",
      "startMs": 1214609,
      "endMs": 1220339
    },
    {
      "index": 253,
      "text": "The Itchy and Scratchy Movie is showing for the last time.",
      "kind": "dialogue",
      "startMs": 1220449,
      "endMs": 1223748
    },
    {
      "index": 254,
      "text": "Tomorrow, a new movie starring Liza Minnelli and Mickey Rourke will open.",
      "kind": "dialogue",
      "startMs": 1223852,
      "endMs": 1227481
    },
    {
      "index": 255,
      "text": "Will it be as successful? Only time will tell.",
      "kind": "dialogue",
      "startMs": 1227589,
      "endMs": 1230820
    },
    {
      "index": 256,
      "text": "Well, Dad, I guess you won.",
      "kind": "dialogue",
      "startMs": 1230926,
      "endMs": 1233121
    },
    {
      "index": 257,
      "text": "No, son. We both won.",
      "kind": "dialogue",
      "startMs": 1233228,
      "endMs": 1235355
    },
    {
      "index": 258,
      "text": "You don't know it now, but I've started you on the road... to somewhere very special.",
      "kind": "dialogue",
      "startMs": 1235464,
      "endMs": 1240724
    },
    {
      "index": 259,
      "text": "Well, I'll be. The Itchy and Scratchy Movie.",
      "kind": "dialogue",
      "startMs": 1246308,
      "endMs": 1249277
    },
    {
      "index": 260,
      "text": "Come on. What do you say?",
      "kind": "dialogue",
      "startMs": 1249377,
      "endMs": 1251277
    },
    {
      "index": 261,
      "text": "All right. I think you've learned your lesson.",
      "kind": "dialogue",
      "startMs": 1251379,
      "endMs": 1254439
    },
    {
      "index": 262,
      "text": "One senior citizen and one chief justice Of the Supreme Court.",
      "kind": "dialogue",
      "startMs": 1257419,
      "endMs": 1260946
    },
    {
      "index": 263,
      "text": "Eh, eh, eh. I'll get it, son.",
      "kind": "dialogue",
      "startMs": 1261056,
      "endMs": 1263183
    },
    {
      "index": 264,
      "text": "That'll be $650. D'oh.",
      "kind": "dialogue",
      "startMs": 1263291,
      "endMs": 1266260
    },
    {
      "index": 265,
      "text": "One Soylent Green, hold the butter.",
      "kind": "dialogue",
      "startMs": 1266361,
      "endMs": 1268921
    },
    {
      "index": 266,
      "text": "Mmm. Soylent Green.",
      "kind": "dialogue",
      "startMs": 1269030,
      "endMs": 1271931
    },
    {
      "index": 267,
      "text": "## [ Theme ]",
      "kind": "dialogue",
      "startMs": 1273702,
      "endMs": 1276102
    },
    {
      "index": 268,
      "text": "Get out. Get out!",
      "kind": "dialogue",
      "startMs": 1285480,
      "endMs": 1289280
    },
    {
      "index": 269,
      "text": "Yea!",
      "kind": "dialogue",
      "startMs": 1295790,
      "endMs": 1297758
    },
    {
      "index": 270,
      "text": "[ Horn Sounds ] [ Screams ]",
      "kind": "dialogue",
      "startMs": 1306701,
      "endMs": 1310102
    },
    {
      "index": 271,
      "text": "Which one's the mouse?",
      "kind": "dialogue",
      "startMs": 1312707,
      "endMs": 1314971
    },
    {
      "index": 272,
      "text": "Itchy. Itchy's a jerk.",
      "kind": "dialogue",
      "startMs": 1315076,
      "endMs": 1317704
    },
    {
      "index": 273,
      "text": "[ Chuckling ] Yeah.",
      "kind": "dialogue",
      "startMs": 1317812,
      "endMs": 1320838
    },
    {
      "index": 274,
      "text": "[ People Chattering ] Shh! www.tvsubtitles.net",
      "kind": "dialogue",
      "startMs": 1371499,
      "endMs": 2000
    }
  ]
}
