{
  "name": "textline-nextline-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 execute textline-stars --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute textline-stars --remote --yes --file=schema.sql",
    "db:migrate:auth:local": "wrangler d1 execute textline-stars --local --file=migrations/002_auth_shares.sql",
    "db:migrate:auth:remote": "wrangler d1 execute textline-stars --remote --yes --file=migrations/002_auth_shares.sql",
    "db:migrate:runs:local": "wrangler d1 execute textline-stars --local --file=migrations/003_runs.sql",
    "db:migrate:runs:remote": "wrangler d1 execute textline-stars --remote --yes --file=migrations/003_runs.sql",
    "db:migrate:shares:local": "node scripts/ensure-share-columns.mjs --local",
    "db:migrate:shares:remote": "node scripts/ensure-share-columns.mjs --remote",
    "db:migrate:friends:local": "wrangler d1 execute textline-stars --local --file=migrations/005_friends.sql",
    "db:migrate:friends:remote": "wrangler d1 execute textline-stars --remote --yes --file=migrations/005_friends.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "typescript": "~5.9.2",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
