{
  "name": "textline-nextline-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 execute textline-stars --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute textline-stars --remote --yes --file=schema.sql",
    "db:migrate:auth:local": "wrangler d1 execute textline-stars --local --file=migrations/002_auth_shares.sql",
    "db:migrate:auth:remote": "wrangler d1 execute textline-stars --remote --yes --file=migrations/002_auth_shares.sql",
    "db:migrate:runs:local": "wrangler d1 execute textline-stars --local --file=migrations/003_runs.sql",
    "db:migrate:runs:remote": "wrangler d1 execute textline-stars --remote --yes --file=migrations/003_runs.sql",
    "db:migrate:shares:local": "node scripts/ensure-share-columns.mjs --local",
    "db:migrate:shares:remote": "node scripts/ensure-share-columns.mjs --remote",
    "db:migrate:friends:local": "wrangler d1 execute textline-stars --local --file=migrations/005_friends.sql",
    "db:migrate:friends:remote": "wrangler d1 execute textline-stars --remote --yes --file=migrations/005_friends.sql",
    "db:migrate:inbox:local": "wrangler d1 execute textline-stars --local --file=migrations/006_inbox.sql",
    "db:migrate:inbox:remote": "wrangler d1 execute textline-stars --remote --yes --file=migrations/006_inbox.sql",
    "db:migrate:groups:local": "wrangler d1 execute textline-stars --local --file=migrations/007_groups.sql",
    "db:migrate:groups:remote": "wrangler d1 execute textline-stars --remote --yes --file=migrations/007_groups.sql",
    "db:migrate:parallels:local": "wrangler d1 execute textline-stars --local --file=migrations/008_parallels.sql",
    "db:migrate:parallels:remote": "wrangler d1 execute textline-stars --remote --yes --file=migrations/008_parallels.sql",
    "db:migrate:loved:local": "node scripts/ensure-share-columns.mjs --local",
    "db:migrate:loved:remote": "node scripts/ensure-share-columns.mjs --remote",
    "db:migrate:parallel-inbox:local": "wrangler d1 execute textline-stars --local --file=migrations/010_parallel_inbox.sql",
    "db:migrate:parallel-inbox:remote": "wrangler d1 execute textline-stars --remote --yes --file=migrations/010_parallel_inbox.sql",
    "db:migrate:chats:local": "node scripts/ensure-share-columns.mjs --local && wrangler d1 execute textline-stars --local --file=migrations/011_chats.sql",
    "db:migrate:chats:remote": "node scripts/ensure-share-columns.mjs --remote && wrangler d1 execute textline-stars --remote --yes --file=migrations/011_chats.sql",
    "db:migrate:chat-messages:local": "wrangler d1 execute textline-stars --local --file=migrations/012_chat_messages.sql",
    "db:migrate:chat-messages:remote": "wrangler d1 execute textline-stars --remote --yes --file=migrations/012_chat_messages.sql",
    "db:migrate:chat-reactions:local": "wrangler d1 execute textline-stars --local --file=migrations/013_chat_reactions.sql",
    "db:migrate:chat-reactions:remote": "wrangler d1 execute textline-stars --remote --yes --file=migrations/013_chat_reactions.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "typescript": "~5.9.2",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
